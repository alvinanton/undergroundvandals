---
import type { MediaItem } from '../types/media';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;
---

<div class="bg-zinc-900 rounded-xl overflow-hidden border border-zinc-800 hover:border-zinc-700 transition-all duration-300 shadow-lg group flex flex-col justify-between">
  <div>
    {/* Media Preview */}
    <div class="relative aspect-square overflow-hidden bg-zinc-950">
      {item.type === 0 ? (
        <img 
          src={item.url} 
          alt={item.title} 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
          loading="lazy"
        />
      ) : (
        <video 
          src={item.url} 
          controls 
          class="w-full h-full object-cover"
        />
      )}
      
      <span class="absolute top-3 right-3 bg-black/60 backdrop-blur-md text-xs px-2.5 py-1 rounded-full text-zinc-300 border border-zinc-700/50">
        {item.category}
      </span>
    </div>

    {/* Info Block */}
    <div class="p-4">
      <h3 class="font-bold text-lg text-zinc-100 truncate">{item.title}</h3>
      {item.description && (
        <p class="text-zinc-400 text-sm mt-1 line-clamp-2">{item.description}</p>
      )}

      {/* Hashtags */}
      {item.hashtags && item.hashtags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {item.hashtags.map((tag) => (
            <span class="text-xs font-mono text-orange-400 bg-orange-500/10 border border-orange-500/20 px-2 py-0.5 rounded-md">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</div>