---
import type { MediaItem } from '../types/media';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;

// Casteo a 'any' para evitar errores de TypeScript con propiedades legacy/nuevas
const itemAny = item as any;
const rawAssets = itemAny?.media || itemAny?.assets || [];

const assets = rawAssets.length > 0
  ? rawAssets 
  : (itemAny?.url ? [{ id: itemAny.id || '', url: itemAny.url, publicId: itemAny.publicId || '', type: itemAny.type ?? 0 }] : []);

const primaryAsset = assets[0];
const mediaUrl = primaryAsset?.url;

const videoExtensions = ['.mp4', '.webm', '.ogg', '.mov', '.m4v'];
const urlLower = mediaUrl ? mediaUrl.toLowerCase() : '';
const hasVideoExtension = videoExtensions.some(ext => urlLower.endsWith(ext));

const isVideo = 
  primaryAsset?.type === 1 || 
  primaryAsset?.type === '1' || 
  (typeof primaryAsset?.type === 'string' && primaryAsset.type.toLowerCase() === 'video') ||
  hasVideoExtension;
---

<div 
  class="media-card-item bg-zinc-900 rounded-xl overflow-hidden border border-zinc-800 hover:border-zinc-700 transition-all duration-300 shadow-lg group flex flex-col justify-between"
  data-hashtags={JSON.stringify(item?.hashtags || [])}
>
  <div>
    {/* Disparador del Modal */}
    <button 
      type="button"
      class="media-card-trigger relative aspect-square w-full overflow-hidden bg-zinc-950 text-left focus:outline-none cursor-pointer group"
      data-assets={JSON.stringify(assets)}
      data-description={item?.description || ''}
      data-category={item?.category || ''}
      data-hashtags={JSON.stringify(item?.hashtags || [])}
    >
      {!mediaUrl ? (
        <div class="w-full h-full flex flex-col items-center justify-center bg-zinc-950 p-4 text-center border border-zinc-800/50">
          <span class="text-zinc-600 text-xs font-mono">[ NO MEDIA ASSET ]</span>
        </div>
      ) : !isVideo ? (
        <img 
          src={mediaUrl} 
          alt={item?.description || item?.title || "Graffiti item"} 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
          loading="lazy"
        />
      ) : (
        <div class="relative w-full h-full">
          <video 
            src={mediaUrl} 
            class="w-full h-full object-cover pointer-events-none" 
            muted 
          />
          <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/40 transition-colors">
            <span class="w-12 h-12 flex items-center justify-center rounded-full bg-black/60 text-white border border-zinc-700/50 backdrop-blur-sm group-hover:scale-110 transition-transform">
              ▶
            </span>
          </div>
        </div>
      )}
      
      {/* Indicador de múltiples archivos */}
      {assets.length > 1 && (
        <span class="absolute top-3 left-3 bg-black/70 backdrop-blur-md text-[11px] font-mono text-orange-400 px-2 py-0.5 rounded-full border border-orange-500/30 flex items-center gap-1.5 pointer-events-none">
          <svg class="w-3 h-3 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          {assets.length}
        </span>
      )}

      {/* Badge de Categoría */}
      {item?.category && (
        <span class="absolute top-3 right-3 bg-black/60 backdrop-blur-md text-xs px-2.5 py-1 rounded-full text-zinc-300 border border-zinc-700/50 pointer-events-none">
          {item.category}
        </span>
      )}
    </button>

    {/* Bloque de Información */}
    {(item?.description || (item?.hashtags && item.hashtags.length > 0)) && (
      <div class="p-4">
        {item?.description && (
          <p class="text-zinc-300 text-sm line-clamp-2 leading-relaxed">
            {item.description}
          </p>
        )}

        {/* Hashtags Clickeables */}
        {item?.hashtags && item.hashtags.length > 0 && (
          <div class={`flex flex-wrap gap-1.5 ${item?.description ? 'mt-3' : 'mt-0'}`}>
            {item.hashtags.map((tag) => (
              <button
                type="button"
                class="hashtag-btn text-[10px] font-mono text-orange-400 hover:text-orange-300 bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/20 hover:border-orange-500/40 px-1.5 py-0.5 rounded transition-all cursor-pointer"
                data-tag={tag}
              >
                #{tag}
              </button>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</div>