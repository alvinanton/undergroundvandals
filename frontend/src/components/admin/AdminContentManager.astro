---
// src/components/admin/AdminContentManager.astro
import AdminArchiveManager from './AdminArchiveManager.astro';
import AdminGalleryManager from './AdminGalleryManager.astro';

export type UserRole = 'SuperAdmin' | 'ArchiveAdmin' | 'GalleryAdmin';

interface Props {
  userRole?: UserRole;
  isAdmin?: boolean;
}

const { userRole = 'SuperAdmin', isAdmin = false } = Astro.props;

const canAccessArchive = userRole === 'SuperAdmin' || userRole === 'ArchiveAdmin';
const canAccessGallery = userRole === 'SuperAdmin' || userRole === 'GalleryAdmin';
const showTabBar = userRole === 'SuperAdmin';
const requestedGalleryView = Astro.url.searchParams.get('gallery');
const activeContentTab = canAccessGallery && (!canAccessArchive || ['create', 'edit'].includes(requestedGalleryView || ''))
  ? 'gallery'
  : 'archive';
---

<div class="space-y-8" id="content-manager-root">
  
  <!-- SUB-TAB NAVIGATION BAR (SuperAdmin Only) -->
  {showTabBar && (
    <div role="tablist" aria-label="Content areas" class="grid grid-cols-1 gap-2 border-b border-zinc-800 pb-4 select-none sm:grid-cols-2">
      <button
        id="subtab-btn-archive"
        type="button"
        role="tab"
        aria-selected={activeContentTab === 'archive' ? 'true' : 'false'}
        aria-controls="subtab-content-archive"
        class={`sub-tab-btn group flex min-h-[5.25rem] w-full items-center gap-3 rounded-xl border px-4 py-3 text-left transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 sm:min-h-20 ${activeContentTab === 'archive' ? 'active border-orange-500/50 bg-orange-500/10' : 'border-zinc-800 bg-zinc-900/70 hover:border-orange-500/40 hover:bg-zinc-900'}`}
        data-subtab="archive"
      >
        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-orange-500 text-zinc-950" aria-hidden="true"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.5h7l2 2H21v8.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18V7.5Z"/><path d="M3 10h18"/></svg></span>
        <span class="min-w-0"><span class="block text-xs font-bold uppercase tracking-wider text-white sm:text-sm">Archive media</span><span class="mt-1 block text-xs font-normal normal-case tracking-normal text-zinc-400">Manage uploaded photos and videos</span></span>
      </button>

      <button
        id="subtab-btn-gallery"
        type="button"
        role="tab"
        aria-selected={activeContentTab === 'gallery' ? 'true' : 'false'}
        aria-controls="subtab-content-gallery"
        class={`sub-tab-btn group flex min-h-[5.25rem] w-full items-center gap-3 rounded-xl border px-4 py-3 text-left transition-colors hover:border-orange-500/40 hover:bg-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 sm:min-h-20 ${activeContentTab === 'gallery' ? 'active border-orange-500/50 bg-orange-500/10' : 'border-zinc-800 bg-zinc-900/70'}`}
        data-subtab="gallery"
      >
        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-zinc-700 bg-zinc-800 text-zinc-300 group-hover:text-orange-400" aria-hidden="true"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3.5h14A1.5 1.5 0 0 1 20.5 5v14a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19V5A1.5 1.5 0 0 1 5 3.5Z"/><path d="M7.5 7.5h9M7.5 11h9M7.5 14.5h6"/></svg></span>
        <span class="min-w-0"><span class="block text-xs font-bold uppercase tracking-wider text-zinc-200 sm:text-sm">Gallery editorial</span><span class="mt-1 block text-xs font-normal normal-case tracking-normal text-zinc-400">Edit articles, features, and exhibitions</span></span>
      </button>
    </div>
  )}

  <!-- ARCHIVE MODULE -->
  {canAccessArchive && (
    <div id="subtab-content-archive" role="tabpanel" aria-labelledby="subtab-btn-archive" class={`sub-tab-content ${activeContentTab === 'archive' ? '' : 'hidden'}`} style={activeContentTab === 'archive' ? 'display:block' : 'display:none'}>
      <AdminArchiveManager isAdmin={isAdmin} userRole={userRole} />
    </div>
  )}

  <!-- GALLERY MODULE -->
  {canAccessGallery && (
    <div id="subtab-content-gallery" role="tabpanel" aria-labelledby="subtab-btn-gallery" class={`sub-tab-content ${activeContentTab === 'gallery' ? '' : 'hidden'}`} style={activeContentTab === 'gallery' ? 'display:block' : 'display:none'}>
      <AdminGalleryManager isAdmin={isAdmin} userRole={userRole} />
    </div>
  )}

</div>

<!-- CONTENT AREA TAB SWITCHER -->
<script is:inline>
  const initializeContentTabs = () => {
    const buttons = document.querySelectorAll('.sub-tab-btn');
    const panels = document.querySelectorAll('.sub-tab-content');

    const initialTab = [...buttons].find((button) => button.getAttribute('aria-selected') === 'true')?.getAttribute('data-subtab');
    if (initialTab) {
      panels.forEach((panel) => {
        const isTarget = panel.id === `subtab-content-${initialTab}`;
        panel.classList.toggle('hidden', !isTarget);
        panel.style.display = isTarget ? 'block' : 'none';
      });
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-subtab');
        buttons.forEach((item) => {
          item.classList.remove('active', 'border-orange-500/50', 'bg-orange-500/10');
          item.classList.add('border-zinc-800', 'bg-zinc-900/70');
          item.setAttribute('aria-selected', 'false');
          item.setAttribute('tabindex', '-1');
        });
        button.classList.remove('border-zinc-800', 'bg-zinc-900/70');
        button.classList.add('active', 'border-orange-500/50', 'bg-orange-500/10');
        button.setAttribute('aria-selected', 'true');
        button.setAttribute('tabindex', '0');

        panels.forEach((panel) => {
          const isTarget = panel.id === `subtab-content-${target}`;
          panel.classList.toggle('hidden', !isTarget);
          panel.style.display = isTarget ? 'block' : 'none';
        });
        if (target === 'gallery') document.dispatchEvent(new CustomEvent('uv:gallery-tab-selected'));
      });
    });
  };
  initializeContentTabs();
</script>
