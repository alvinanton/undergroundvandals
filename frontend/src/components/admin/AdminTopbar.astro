---
const user = Astro.locals.user as { role?: string; name?: string; username?: string; email?: string } | undefined;
const currentPath = Astro.url.pathname;
const isAdmin = user?.role === "Admin";
const accountName = user?.username || user?.name || user?.email?.split("@")[0] || "Admin";
const accountInitials = accountName.slice(0, 2).toUpperCase();
const activeTab = currentPath.startsWith("/admin/users")
  ? "users"
  : currentPath.startsWith("/admin/pages")
    ? "pages"
  : currentPath.startsWith("/admin/products")
    ? "products"
    : "content";
const linkClass = (tab: string) => `flex items-center gap-3 rounded-md px-3 py-3 text-sm font-mono uppercase tracking-wider ${activeTab === tab ? "bg-orange-500/10 font-bold text-orange-400" : "text-zinc-300 hover:bg-zinc-900 hover:text-white"}`;
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-md">
  <div class="flex min-h-16 w-full items-center justify-between gap-3 px-4 py-3 sm:px-6 xl:px-8">
    <a href="/admin" class="group min-w-0 text-lg font-black uppercase tracking-tight text-white transition-colors hover:text-orange-500 min-[380px]:text-xl sm:text-2xl">
      Underground<span class="text-orange-500 transition-colors group-hover:text-white">Vandals</span>
    </a>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      {isAdmin && <div class="relative">
        <button id="admin-site-status" type="button" aria-label="Checking public page status" title="Show public page status" aria-busy="true" aria-expanded="false" aria-controls="admin-site-status-menu" class="inline-flex min-h-9 items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900/70 px-2.5 text-xs font-mono text-zinc-300 transition-colors hover:border-zinc-700 hover:bg-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 sm:px-3">
          <span id="admin-site-status-dot" class="size-2 shrink-0 rounded-full bg-zinc-500"></span>
          <span id="admin-site-status-label">…</span>
          <svg aria-hidden="true" class="size-3.5 text-zinc-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.22 7.47a.75.75 0 0 1 1.06 0L10 11.19l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 8.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
        </button>
        <section id="admin-site-status-menu" aria-label="Public page status" class="absolute right-0 top-full z-[60] mt-2 hidden w-[min(21rem,calc(100vw-2rem))] overflow-hidden rounded-xl border border-zinc-700 bg-zinc-950 shadow-2xl">
          <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
            <span class="text-[10px] font-mono uppercase tracking-[0.18em] text-zinc-500">Public pages</span>
            <a href="/admin/pages" class="text-xs font-mono text-orange-400 hover:text-orange-300">Page settings</a>
          </div>
          <div id="admin-site-status-pages" class="p-2" aria-live="polite">
            <p class="px-3 py-4 text-sm text-zinc-500">Loading page status…</p>
          </div>
        </section>
      </div>}
      <div class="hidden items-center gap-2 border-l border-zinc-800 pl-3 xl:flex" aria-label={`Signed in as ${accountName}`}>
        <span class="inline-flex size-8 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900 text-[11px] font-bold text-zinc-300">{accountInitials}</span>
        <span class="max-w-36 truncate text-xs font-mono text-zinc-300">{accountName}</span>
      </div>
      <span class="hidden rounded-full border border-zinc-800 bg-zinc-900 px-2.5 py-1 text-xs font-mono text-zinc-400 lg:inline-block">v1.0</span>
      <button id="mobile-menu-toggle" type="button" class="inline-flex size-10 items-center justify-center rounded-lg border border-zinc-800 bg-zinc-900 text-zinc-200 hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 xl:hidden" aria-label="Open admin navigation menu" aria-expanded="false" aria-controls="mobile-navigation">
        <svg id="mobile-menu-open-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5 stroke-current" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg id="mobile-menu-close-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" class="hidden size-5 stroke-current" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-navigation" aria-label="Admin navigation" class="mx-auto hidden max-w-7xl border-t border-zinc-800 px-4 pb-3 pt-2 sm:px-6 xl:hidden">
    <div class="mb-2 flex items-center gap-3 rounded-lg bg-zinc-900/60 px-3 py-3">
      <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-zinc-700 bg-zinc-950 text-xs font-bold text-zinc-300">{accountInitials}</span>
      <span class="min-w-0">
        <span class="block truncate text-sm font-medium text-white">{accountName}</span>
        <span class="block text-xs font-mono text-zinc-500">{user?.role || "Staff"}</span>
      </span>
    </div>
    <p class="px-3 pb-1 pt-2 text-[10px] font-mono uppercase tracking-[0.2em] text-zinc-500">Admin workspace</p>
    <a href="/admin" aria-current={activeTab === "content" ? "page" : undefined} class={linkClass("content")}><svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3.5 6.5h6l2 2H20a1.5 1.5 0 0 1 1.5 1.5v7.5a1.5 1.5 0 0 1-1.5 1.5h-16A1.5 1.5 0 0 1 2.5 17V8a1.5 1.5 0 0 1 1-1.5Z"/><path d="M2.5 10h19"/></svg>Content Management</a>
    <a href="/admin/products" aria-current={activeTab === "products" ? "page" : undefined} class={linkClass("products")}><svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 8.5 12 4l8 4.5v9L12 22l-8-4.5v-9Z"/><path d="m4.5 8 7.5 4 7.5-4M12 12v9.5M8 6.3l8 4.3"/></svg>Products</a>
    {isAdmin && <a href="/admin/users" aria-current={activeTab === "users" ? "page" : undefined} class={linkClass("users")}><svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3"/><path d="M3.5 19v-1.5A4.5 4.5 0 0 1 8 13h2a4.5 4.5 0 0 1 4.5 4.5V19ZM16 5.2a3 3 0 0 1 0 5.6M17 13h.5a3.5 3.5 0 0 1 3.5 3.5V19h-4"/></svg>Users</a>}
    {isAdmin && <a href="/admin/pages" aria-current={activeTab === "pages" ? "page" : undefined} class={linkClass("pages")}><svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3.5h8l4 4V20a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 20V5a1.5 1.5 0 0 1 1.5-1.5Z"/><path d="M14 4v4h4M8 13h8M8 17h8"/></svg>Pages</a>}
    <div class="my-2 border-t border-zinc-800"></div>
    <a href="/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 rounded-md px-3 py-3 text-sm font-mono uppercase tracking-wider text-zinc-300 hover:bg-zinc-900 hover:text-white"><svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M3.5 12h17M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>View public site <svg aria-hidden="true" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/></svg></a>
    <button type="button" data-admin-logout class="w-full rounded-md px-3 py-3 text-left text-sm font-mono uppercase tracking-wider text-red-300 hover:bg-red-950/40">Sign out</button>
  </nav>
</header>

{isAdmin && <script>
  const statusLink = document.getElementById("admin-site-status");
  const statusLabel = document.getElementById("admin-site-status-label");
  const statusDot = document.getElementById("admin-site-status-dot");
  const statusMenu = document.getElementById("admin-site-status-menu");
  const statusPages = document.getElementById("admin-site-status-pages");
  const pageNames: Record<string, string> = { home: "Home", archive: "Archive", gallery: "Gallery", shop: "Shop" };
  const statusStyles: Record<string, string> = {
    Live: "border-emerald-900/70 bg-emerald-950/50 text-emerald-300",
    ComingSoon: "border-amber-900/70 bg-amber-950/50 text-amber-300",
    Disabled: "border-red-900/70 bg-red-950/50 text-red-300",
  };
  const publicPageOrder = ["home", "archive", "gallery", "shop"];

  const renderPageStatus = (pages: Array<{ pageKey: string; status: string }>) => {
    if (!statusPages) return;
    statusPages.replaceChildren();
    const orderedPages = [...pages].sort((a, b) =>
      publicPageOrder.indexOf(a.pageKey.toLowerCase()) - publicPageOrder.indexOf(b.pageKey.toLowerCase()),
    );
    for (const page of orderedPages) {
      const key = page.pageKey.toLowerCase();
      const link = document.createElement("a");
      link.href = `/admin/pages?page=${encodeURIComponent(key)}`;
      link.className = "flex items-center justify-between gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors hover:bg-zinc-900 focus-visible:outline-2 focus-visible:outline-orange-500";

      const name = document.createElement("span");
      name.className = "font-medium text-zinc-200";
      name.textContent = pageNames[key] || key;

      const status = document.createElement("span");
      status.className = `rounded-full border px-2 py-1 text-[10px] font-mono ${statusStyles[page.status] || "border-zinc-700 bg-zinc-900 text-zinc-300"}`;
      status.textContent = page.status === "ComingSoon" ? "Coming soon" : page.status;

      link.append(name, status);
      statusPages.append(link);
    }
  };

  if (statusLink && statusLabel && statusDot && statusMenu && statusPages) {
    const closeStatusMenu = () => {
      statusMenu.classList.add("hidden");
      statusLink.setAttribute("aria-expanded", "false");
    };

    statusLink.addEventListener("click", () => {
      const isOpen = statusLink.getAttribute("aria-expanded") === "true";
      statusMenu.classList.toggle("hidden", isOpen);
      statusLink.setAttribute("aria-expanded", String(!isOpen));
    });

    document.addEventListener("click", event => {
      if (event.target instanceof Node && !statusLink.contains(event.target) && !statusMenu.contains(event.target)) closeStatusMenu();
    });
    document.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        closeStatusMenu();
        statusLink.focus();
      }
    });

    const loadPageStatus = () => fetch("/api/admin/content/pages", { headers: { Accept: "application/json" } })
      .then(async response => {
        if (!response.ok) throw new Error("Page status unavailable");
        return response.json() as Promise<Array<{ pageKey: string; status: string }>>;
      })
      .then(pages => {
        renderPageStatus(pages);
        const live = pages.filter(page => page.status === "Live").length;
        const comingSoon = pages.filter(page => page.status === "ComingSoon").length;
        const disabled = pages.filter(page => page.status === "Disabled").length;
        const allLive = pages.length > 0 && live === pages.length;
        const summary = allLive
          ? `${live} pages live`
          : `${live} live · ${comingSoon} soon · ${disabled} off`;

        statusLabel.textContent = allLive ? `${live} live` : `${live}/${pages.length} live`;
        statusLink.title = `Public pages: ${summary}. Manage page settings.`;
        statusLink.setAttribute("aria-label", `Public page status: ${summary}. Open page settings.`);
        statusLink.setAttribute("aria-busy", "false");
        statusDot.classList.remove("bg-zinc-500");
        statusDot.classList.add(allLive ? "bg-emerald-400" : "bg-amber-400");
      })
      .catch(() => {
        statusLabel.textContent = "?";
        statusLink.title = "Public page status unavailable.";
        statusLink.setAttribute("aria-label", "Public page status unavailable. Show details.");
        statusLink.setAttribute("aria-busy", "false");
        statusDot.classList.remove("bg-zinc-500");
        statusDot.classList.add("bg-red-400");
        statusPages.replaceChildren();
        const error = document.createElement("p");
        error.className = "px-3 py-4 text-sm text-red-300";
        error.textContent = "Could not load page statuses.";
        statusPages.append(error);
      });

    void loadPageStatus();
    window.addEventListener("site-page-settings-updated", () => void loadPageStatus());
  }
</script>}
