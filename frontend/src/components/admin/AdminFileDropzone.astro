---
interface Props {
  id: string;
  inputId: string;
  accept?: string;
  multiple?: boolean;
  label: string;
  hint?: string;
  browseButtonId: string;
  browseLabel?: string;
  selectionId?: string;
  selectionText?: string;
  feedbackId: string;
}

const {
  id,
  inputId,
  accept,
  multiple = false,
  label,
  hint,
  browseButtonId,
  browseLabel = "Browse files",
  selectionId,
  selectionText,
  feedbackId,
} = Astro.props;
---

<div id={id} role="group" aria-labelledby={`${id}-label`} aria-describedby={feedbackId} class="flex flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-zinc-700 bg-zinc-950/70 p-4 text-center transition-colors sm:p-5">
  <input type="file" id={inputId} accept={accept} multiple={multiple} class="hidden" />
  <div>
    <p id={`${id}-label`} class="text-sm font-semibold text-zinc-200">{label}</p>
    {hint && <p class="mt-1 text-xs text-zinc-500">{hint}</p>}
  </div>
  <div class="flex w-full flex-wrap items-center justify-center gap-3">
    <button type="button" id={browseButtonId} class="inline-flex min-h-10 items-center justify-center rounded-lg border border-zinc-700 bg-zinc-800 px-4 text-xs font-mono text-zinc-200 transition-colors hover:bg-zinc-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500">
      <svg class="mr-2 size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4m0 0L7 9m5-5 5 5"/><path d="M5 14v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5"/></svg>
      <span data-upload-label>{browseLabel}</span>
    </button>
    <slot name="actions" />
  </div>
  <slot name="fields" />
  {selectionId && <p id={selectionId} class="w-full break-all text-xs font-mono text-zinc-400" aria-live="polite">{selectionText}</p>}
  <p id={feedbackId} class="w-full text-xs text-zinc-500" aria-live="polite"></p>
</div>
