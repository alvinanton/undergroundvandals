---
interface Props {
  id: string;
  itemLabel: string;
}

const { id, itemLabel } = Astro.props;
---

<nav id={`${id}-pagination`} aria-label={`${itemLabel} pagination`} class="flex flex-col items-center justify-between gap-4 border-t border-zinc-800/80 pt-4 font-mono text-xs text-zinc-400 sm:flex-row">
  <div class="flex flex-wrap items-center justify-center gap-3 sm:justify-start">
    <span id={`${id}-pagination-info`}>Showing 0 of 0 {itemLabel}</span>
    <label class="flex items-center gap-2 border-l border-zinc-800 pl-3">
      <span class="text-[11px] uppercase text-zinc-500">Per page</span>
      <select id={`${id}-page-size`} class="rounded border border-zinc-800 bg-zinc-950 px-2 py-1 text-zinc-200 focus:border-orange-500 focus:outline-none">
        <option value="10">10</option>
        <option value="25" selected>25</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
    </label>
  </div>
  <div class="flex items-center gap-2">
    <button id={`${id}-page-prev`} type="button" class="rounded-lg border border-zinc-800 bg-zinc-950 px-3 py-1.5 transition-colors hover:bg-zinc-800 hover:text-white disabled:cursor-not-allowed disabled:opacity-40">Previous</button>
    <span id={`${id}-page-current`} class="rounded-lg border border-zinc-800 bg-zinc-950 px-3 py-1.5 font-bold text-orange-400">Page 1 of 1</span>
    <button id={`${id}-page-next`} type="button" class="rounded-lg border border-zinc-800 bg-zinc-950 px-3 py-1.5 transition-colors hover:bg-zinc-800 hover:text-white disabled:cursor-not-allowed disabled:opacity-40">Next</button>
  </div>
</nav>
