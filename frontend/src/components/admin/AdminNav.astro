---
interface Props {
  activeTab: "content" | "products" | "users" | "pages";
  isAdmin?: boolean;
}

const { activeTab, isAdmin = false } = Astro.props;

const linkClass = (tab: Props["activeTab"]) =>
  `flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-mono transition-colors ${
    activeTab === tab
      ? "bg-orange-500/10 text-orange-400 font-bold"
      : "text-zinc-400 hover:bg-zinc-900 hover:text-white"
  }`;
---

<aside id="admin-sidebar" class="hidden w-64 shrink-0 border-r border-zinc-800/80 bg-zinc-950/60 transition-[width] duration-200 xl:block">
  <div class="sticky top-0 flex h-screen flex-col px-4 pb-4 pt-0">
    <div class="flex h-16 shrink-0 items-center justify-between px-2">
      <span class="admin-sidebar-label text-xs font-mono uppercase tracking-[0.16em] text-zinc-500">Admin panel</span>
      <button id="admin-sidebar-toggle" type="button" aria-label="Collapse admin sidebar" aria-controls="admin-sidebar" aria-expanded="true" title="Collapse admin sidebar" class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-zinc-800 bg-zinc-900 text-zinc-300 transition-colors hover:bg-zinc-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500">
        <svg id="admin-sidebar-toggle-icon" class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M14 9l-3 3 3 3"/></svg>
      </button>
    </div>
    <nav aria-label="Admin sections" class="space-y-1">
      <a href="/admin" aria-label="Content" title="Content" aria-current={activeTab === "content" ? "page" : undefined} class={linkClass("content")}>
        <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3.5 6.5h6l2 2H20a1.5 1.5 0 0 1 1.5 1.5v7.5a1.5 1.5 0 0 1-1.5 1.5h-16A1.5 1.5 0 0 1 2.5 17V8a1.5 1.5 0 0 1 1-1.5Z"/><path d="M2.5 10h19"/></svg><span class="admin-sidebar-label">Content</span>
      </a>
      <a href="/admin/products" aria-label="Products" title="Products" aria-current={activeTab === "products" ? "page" : undefined} class={linkClass("products")}>
        <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 8.5 12 4l8 4.5v9L12 22l-8-4.5v-9Z"/><path d="m4.5 8 7.5 4 7.5-4M12 12v9.5M8 6.3l8 4.3"/></svg><span class="admin-sidebar-label">Products</span>
      </a>
      {isAdmin && (
        <a href="/admin/users" aria-label="Users" title="Users" aria-current={activeTab === "users" ? "page" : undefined} class={linkClass("users")}>
        <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3"/><path d="M3.5 19v-1.5A4.5 4.5 0 0 1 8 13h2a4.5 4.5 0 0 1 4.5 4.5V19ZM16 5.2a3 3 0 0 1 0 5.6M17 13h.5a3.5 3.5 0 0 1 3.5 3.5V19h-4"/></svg><span class="admin-sidebar-label">Users</span>
        </a>
      )}
      {isAdmin && (
        <a href="/admin/pages" aria-label="Pages" title="Pages" aria-current={activeTab === "pages" ? "page" : undefined} class={linkClass("pages")}>
          <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3.5h8l4 4V20a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 20V5a1.5 1.5 0 0 1 1.5-1.5Z"/><path d="M14 4v4h4M8 13h8M8 17h8"/></svg><span class="admin-sidebar-label">Pages</span>
        </a>
      )}
    </nav>

    <div class="mt-auto space-y-2 border-t border-zinc-800/80 pt-4">
      <a href="/" aria-label="View public site" title="View public site" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-mono text-zinc-400 transition-colors hover:bg-zinc-900 hover:text-white">
        <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M3.5 12h17M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg><span class="admin-sidebar-label">View public site</span><svg class="admin-sidebar-label ml-auto size-3.5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4 11 13"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/></svg>
      </a>
      <button type="button" aria-label="Sign out" title="Sign out" data-admin-logout class="flex w-full items-center gap-3 rounded-lg px-3 py-3 text-left text-sm font-mono text-zinc-400 transition-colors hover:bg-red-950/40 hover:text-red-300">
        <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M10 4H5.5A1.5 1.5 0 0 0 4 5.5v13A1.5 1.5 0 0 0 5.5 20H10M14 16l4-4-4-4M18 12H9"/></svg><span class="admin-sidebar-label">Sign out</span>
      </button>
    </div>
  </div>
</aside>
