---
// src/components/admin/AdminArchiveManager.astro
import AdminPagination from "./AdminPagination.astro";
import AdminFileDropzone from "./AdminFileDropzone.astro";
export type UserRole = 'SuperAdmin' | 'ArchiveAdmin' | 'GalleryAdmin';

interface Props {
  userRole?: UserRole;
  isAdmin?: boolean;
}

const { userRole = 'SuperAdmin', isAdmin = false } = Astro.props;
const isSuperAdmin = userRole === 'SuperAdmin';
---

<div class="space-y-8" id="archive-manager-root" data-is-admin={isAdmin ? "true" : "false"} data-user-role={userRole}>
    {/* Dedicated create screen */}
    <section id="archive-create-view" aria-labelledby="archive-create-title" class="hidden space-y-6">
        <header class="flex flex-col gap-4 border-b border-zinc-800/80 pb-5 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <h2 id="archive-create-title" tabindex="-1" class="text-2xl font-bold tracking-tight text-white focus:outline-none sm:text-3xl">New media</h2>
                <p class="mt-1 text-sm text-zinc-400">Add photos or videos to the archive. Large uploads go directly to Azure.</p>
            </div>
            <button id="archive-create-back" type="button" class="inline-flex min-h-10 items-center justify-center gap-2 self-start rounded-lg border border-zinc-700 bg-zinc-900 px-4 text-xs font-mono uppercase tracking-wider text-zinc-300 transition-colors hover:bg-zinc-800 sm:self-auto">
                <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/><path d="M9 12h12"/></svg>Back to archive
            </button>
        </header>
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-4 shadow-xl sm:p-7">
            <form id="upload-form" class="space-y-5">
                <div id="archive-draft-notice" class="hidden rounded-lg border border-amber-700/60 bg-amber-950/40 p-4 text-xs font-mono text-amber-200" role="status">
                    <div class="flex items-start justify-between gap-4">
                        <p id="archive-draft-notice-text"></p>
                        <button type="button" id="archive-draft-clear" class="shrink-0 text-amber-100 underline">Clear saved draft</button>
                    </div>
                </div>
            <div>
                <label
                        for="title"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2"
                    >
                        Title *
                    </label>
                    <input
                        type="text"
                        id="title"
                        name="title"
                        required
                        class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors text-sm font-mono"
                        placeholder="e.g. Street Art Piece #01"
                    />
                </div>

                <div>
                    <label
                        for="category"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2"
                    >
                        Category
                    </label>
                    <input
                        type="text"
                        id="category"
                        name="category"
                        value="General"
                        class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors text-sm font-mono"
                        placeholder="e.g. Trains, Walls, General"
                    />
                </div>

                <div>
                    <p id="files-field-label" class="mb-2 block text-xs font-mono uppercase tracking-wider text-zinc-300">
                        Files (Images / Videos) *
                    </p>
                    <AdminFileDropzone id="files-dropzone" inputId="files-input" accept="image/*,video/*" multiple label="Drag files here" hint="Images and videos · You can select multiple files" browseButtonId="select-files-btn" selectionId="file-count-label" selectionText="No files selected" feedbackId="files-drop-feedback" />
                </div>

                {/* Pre-upload Previews Grid */}
                <div id="pre-upload-preview" class="flex flex-wrap gap-3 empty:hidden custom-scrollbar pt-2"></div>
                <p id="archive-reorder-hint" class="hidden text-[11px] font-mono text-zinc-500">Drag images by the grip to change their order. Focus a grip and use the arrow keys to reorder.</p>
                <p id="archive-reorder-announcement" class="sr-only" aria-live="polite" aria-atomic="true"></p>

                <div>
                    <label
                        for="hashtags"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2"
                    >
                        Hashtags (Comma-separated)
                    </label>
                    <input
                        type="text"
                        id="hashtags"
                        name="hashtags"
                        class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors text-sm font-mono"
                        placeholder="graffiti, streetart, vandals"
                    />
                </div>

                <div>
                    <label
                        for="description"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2"
                    >
                        Description (Optional)
                    </label>
                    <textarea
                        id="description"
                        name="description"
                        rows="3"
                        class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors resize-none text-sm font-mono custom-scrollbar"
                        placeholder="Optional details about location, artist, date..."
                    ></textarea>
                </div>

                <label for="archive-is-archived" class="flex items-center gap-2 cursor-pointer select-none">
                    <input type="checkbox" id="archive-is-archived" class="size-4 cursor-pointer rounded border-zinc-700 bg-zinc-950 accent-orange-500" />
                    <span class="text-xs font-mono uppercase tracking-wider text-zinc-300">Create as archived</span>
                </label>

                {/* Status Message */}
                <div
                    id="status-message"
                    class="hidden text-xs font-mono text-center rounded-lg p-3"
                >
                </div>

                {/* Live Progress Bar */}
                <div id="upload-progress-container" class="hidden space-y-2 pt-2">
                    <div class="flex justify-between text-xs font-mono">
                        <span id="upload-status-text" class="text-orange-400">Preparing upload...</span>
                        <span id="upload-percentage" class="text-zinc-400">0%</span>
                    </div>
                    <div class="w-full bg-zinc-950 rounded-full h-2 overflow-hidden border border-zinc-800">
                        <div id="upload-progress-bar" class="bg-orange-500 h-full w-0 transition-all duration-150 ease-out"></div>
                    </div>
                </div>

                <button
                    type="submit"
                    id="upload-btn"
                    class="w-full py-3.5 px-4 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black uppercase tracking-wider text-xs rounded-lg shadow-lg hover:shadow-orange-500/10 transition-all cursor-pointer disabled:opacity-50 font-mono"
                >
                    Upload to Archive
                </button>
            </form>
        </div>
    </section>

    {/* Section 2: Media Management List */}
    <div
        id="archive-list-view"
        class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur-md shadow-xl space-y-6"
    >
        <div
            class="flex items-center justify-between border-b border-zinc-800/80 pb-4"
        >
            <div>
                <h2
                    class="text-lg font-bold text-white uppercase tracking-wide"
                >
                    Manage Archive Media
                </h2>
                <p class="text-xs text-zinc-400 mt-0.5">
                    View, edit, archive, or permanently delete gallery items
                </p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <button id="archive-create-btn" type="button" class="inline-flex min-h-9 items-center gap-2 rounded-lg bg-orange-500 px-3 text-xs font-bold font-mono uppercase tracking-wider text-zinc-950 transition-colors hover:bg-orange-400">
                <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>New media
              </button>
              <button
                id="refresh-btn"
                type="button"
                class="inline-flex min-h-9 items-center justify-center gap-2 rounded-lg bg-zinc-800 px-3 text-xs font-mono uppercase tracking-wider text-zinc-300 transition-colors hover:bg-zinc-700 disabled:opacity-50"
              >
                <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7v5h-5"/><path d="M19 12a7 7 0 1 1-2-4.9L20 12"/></svg><span>Refresh</span>
              </button>
            </div>
        </div>

        {/* Search & Filters */}
        <div
            class="grid grid-cols-1 sm:grid-cols-5 gap-3 bg-zinc-950/50 p-3 rounded-xl border border-zinc-800/60"
        >
            <div class="sm:col-span-2">
                <input
                    type="text"
                    id="search-input"
                    placeholder="Search title, category, hashtag..."
                    class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 placeholder-zinc-500 text-xs focus:outline-none focus:border-orange-500 font-mono"
                />
            </div>
            <div>
                <select
                    id="filter-type"
                    class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 text-xs focus:outline-none focus:border-orange-500 font-mono cursor-pointer"
                >
                    <option value="ALL">All Media Types</option>
                    <option value="image">Has Images</option>
                    <option value="video">Has Videos</option>
                </select>
            </div>
            <div>
                <select
                    id="filter-status"
                    class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 text-xs focus:outline-none focus:border-orange-500 font-mono cursor-pointer"
                >
                    <option value="ALL">All Statuses</option>
                    <option value="ACTIVE">Active</option>
                    <option value="ARCHIVED">Archived</option>
                </select>
            </div>
            <div class="flex justify-end">
                <button id="clear-media-filters-btn" type="button" disabled class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-zinc-700/60 bg-zinc-800/80 px-3 py-2 text-xs font-mono uppercase tracking-wider text-zinc-400 transition-colors hover:bg-zinc-700 hover:text-white disabled:cursor-not-allowed disabled:opacity-40">
                    <svg aria-hidden="true" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg><span>Reset</span>
                </button>
            </div>
        </div>

        {/* Media Table Container */}
        <div>
            <div class="xl:hidden flex items-center gap-2 mb-3">
                <label class="sr-only" for="media-mobile-sort">Sort media by</label>
                <select id="media-mobile-sort" class="min-w-0 grow px-3 py-2.5 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-200 text-xs font-mono">
                    <option value="createdAt">Date</option>
                    <option value="title">Title</option>
                    <option value="isArchived">Status</option>
                </select>
                <button id="media-mobile-sort-direction" type="button" aria-label="Change sort direction" class="shrink-0 px-3 py-2.5 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-300 text-xs font-mono">Newest first</button>
            </div>
            <div id="media-card-list" class="xl:hidden grid gap-3" aria-live="polite">
                <p class="py-8 text-center text-zinc-500 font-mono">Loading media items...</p>
            </div>
            <div class="hidden xl:block overflow-x-auto">
            <table class="w-full min-w-[680px] text-left border-collapse">
                <thead>
                    <tr
                        class="border-b border-zinc-800 text-[11px] font-mono uppercase tracking-wider text-zinc-400 select-none"
                    >
                        <th class="py-3 px-4">Preview</th>
                        <th
                            class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header"
                            data-sort="title"
                        >
                            Title & Info <span
                                class="sort-icon inline-block ml-1 opacity-40"
                                >↕</span
                            >
                        </th>
                        <th class="py-3 px-4">Assets Count</th>
                        <th
                            class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header"
                            data-sort="isArchived"
                        >
                            Status <span
                                class="sort-icon inline-block ml-1 opacity-40"
                                >↕</span
                            >
                        </th>
                        <th
                            class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header text-orange-500"
                            data-sort="createdAt"
                        >
                            Date <span
                                class="sort-icon inline-block ml-1 opacity-100"
                                >↓</span
                            >
                        </th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody
                    id="media-table-body"
                    class="divide-y divide-zinc-800/50 text-xs"
                >
                    <tr>
                        <td
                            colspan="6"
                            class="py-8 text-center text-zinc-500 font-mono"
                            >Loading media items...</td
                        >
                    </tr>
                </tbody>
            </table>
            </div>
            <AdminPagination id="media" itemLabel="media items" />
        </div>
    </div>

    {/* Pre-Upload File Preview Modal */}
    <div
        id="pre-upload-modal"
        class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex flex-col items-center justify-center p-4"
    >
        <div
            class="relative max-w-4xl max-h-[90vh] w-full flex flex-col items-center gap-4"
        >
            <button
                id="pre-upload-modal-close"
                class="absolute -top-12 right-0 text-zinc-300 hover:text-orange-500 text-xs font-mono uppercase tracking-wider bg-zinc-900 border border-zinc-800 px-3 py-1.5 rounded-lg cursor-pointer transition-colors"
            >
                ✕ Close
            </button>
            <div id="pre-upload-modal-media-container" class="w-full flex justify-center items-center">
                <img
                    id="pre-upload-modal-img"
                    src=""
                    alt=""
                    class="max-w-full max-h-[75vh] object-contain rounded-xl shadow-2xl border border-zinc-800/80 hidden"
                />
                <video
                    id="pre-upload-modal-video"
                    controls
                    class="max-w-full max-h-[75vh] rounded-xl shadow-2xl border border-zinc-800/80 hidden"
                ></video>
            </div>
            <div class="flex flex-wrap items-center justify-between w-full max-w-lg bg-zinc-900/90 border border-zinc-800 p-3 rounded-xl gap-3">
                <p
                    id="pre-upload-modal-filename"
                    class="text-zinc-300 font-mono text-xs uppercase tracking-wider truncate max-w-[180px]"
                >
                </p>

                <div class="flex items-center gap-2 ml-auto">
                    {/* BOTÓN: Capturar fotograma actual del video */}
                    <button
                        type="button"
                        id="pre-upload-modal-capture-btn"
                        class="hidden px-3.5 py-1.5 bg-orange-500/20 hover:bg-orange-500/30 border border-orange-500/40 text-orange-400 font-mono text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer flex items-center gap-1.5"
                    >
                        <svg class="size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h3l1.5-2h7L17 7h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg>Set Frame as Poster
                    </button>

                    <button
                        type="button"
                        id="pre-upload-modal-discard-btn"
                        class="px-3.5 py-1.5 bg-red-950/60 hover:bg-red-900/80 border border-red-800/80 text-red-400 hover:text-red-300 font-mono text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer flex items-center gap-1.5"
                    >
                        ✕ Discard File
                    </button>
                </div>
            </div>
        </div>
    </div>

    {/* Full Image/Media Preview Carousel Modal */}
    <div
        id="image-modal"
        class="fixed inset-0 bg-black/80 backdrop-blur-md z-[60] hidden flex flex-col items-center justify-center p-4"
    >
        <div
            class="relative max-w-4xl max-h-[90vh] w-full flex flex-col items-center justify-center"
        >
            <button
                id="modal-close-btn"
                class="absolute -top-12 right-0 text-zinc-300 hover:text-orange-500 text-xs font-mono uppercase tracking-wider bg-zinc-900 border border-zinc-800 px-3 py-1.5 rounded-lg cursor-pointer transition-colors z-20"
            >
                ✕ Close
            </button>

            <button
                id="modal-prev-btn"
                class="absolute left-2 top-1/2 -translate-y-1/2 z-20 bg-zinc-900/80 hover:bg-zinc-800 text-zinc-200 hover:text-orange-500 border border-zinc-800/80 w-10 h-10 rounded-full flex items-center justify-center transition-colors cursor-pointer select-none"
                title="Previous item"
            >
                ❮
            </button>

            <button
                id="modal-next-btn"
                class="absolute right-2 top-1/2 -translate-y-1/2 z-20 bg-zinc-900/80 hover:bg-zinc-800 text-zinc-200 hover:text-orange-500 border border-zinc-800/80 w-10 h-10 rounded-full flex items-center justify-center transition-colors cursor-pointer select-none"
                title="Next item"
            >
                ❯
            </button>

            <div id="modal-media-container" class="w-full flex justify-center items-center">
                <img
                    id="modal-img"
                    src=""
                    alt=""
                    class="max-w-full max-h-[75vh] object-contain rounded-xl shadow-2xl border border-zinc-800/80 hidden"
                />
                <video
                    id="modal-video"
                    controls
                    class="max-w-full max-h-[75vh] rounded-xl shadow-2xl border border-zinc-800/80 hidden"
                ></video>
            </div>

            <div class="flex items-center justify-between w-full max-w-lg mt-3 px-2">
                <p
                    id="modal-title"
                    class="text-zinc-300 font-mono text-xs uppercase tracking-wider truncate"
                >
                </p>
                <span
                    id="modal-counter"
                    class="text-orange-500 font-mono text-xs uppercase tracking-wider bg-zinc-900 border border-zinc-800 px-2.5 py-1 rounded-md shrink-0 ml-3"
                >
                    1 / 1
                </span>
            </div>
        </div>
    </div>

    {/* Dedicated edit screen */}
    <section
        id="edit-modal"
        aria-labelledby="edit-media-title"
        class="hidden space-y-6"
    >
        <div class="flex flex-col gap-4 border-b border-zinc-800/80 pb-5 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <h2 id="edit-media-title" tabindex="-1" class="text-2xl font-bold tracking-tight text-white focus:outline-none sm:text-3xl">Edit media item</h2>
                    <p class="mt-1 text-sm text-zinc-400">
                        Update metadata or manage assets for this post
                    </p>
                </div>
                <button
                    id="edit-modal-close"
                    type="button"
                    class="inline-flex min-h-10 items-center justify-center gap-2 self-start rounded-lg border border-zinc-700 bg-zinc-900 px-4 text-xs font-mono uppercase tracking-wider text-zinc-300 transition-colors hover:bg-zinc-800 sm:self-auto"
                    ><svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/><path d="M9 12h12"/></svg>Back to archive</button
                >
        </div>
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-4 shadow-xl sm:p-7">
            <form id="edit-form" class="space-y-4">
                <input type="hidden" id="edit-id" />

                <div>
                    <label
                        for="edit-title"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5"
                        >Title *</label
                    >
                    <input
                        type="text"
                        id="edit-title"
                        required
                        class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500"
                    />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label
                            for="edit-category"
                            class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5"
                            >Category</label
                        >
                        <input
                            type="text"
                            id="edit-category"
                            class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500"
                        />
                    </div>

                    <div>
                        <label
                            for="edit-hashtags"
                            class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5"
                            >Hashtags (Comma-separated)</label
                        >
                        <input
                            type="text"
                            id="edit-hashtags"
                            class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500"
                        />
                    </div>
                </div>

                <div>
                    <label
                        for="edit-description"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5"
                        >Description</label
                    >
                    <textarea
                        id="edit-description"
                        rows="3"
                        class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500 resize-none custom-scrollbar"
                    ></textarea>
                </div>

                <div class="border-t border-zinc-800/80 pt-4 space-y-3">
                    <label class="block text-xs font-mono uppercase tracking-wider text-zinc-300">
                        Current Assets
                    </label>
                    <div id="edit-assets-list" class="flex flex-wrap gap-2 max-h-40 overflow-y-auto p-2 bg-zinc-950/60 rounded-lg border border-zinc-800/80 custom-scrollbar">
                    </div>

                    <div>
                        <label class="block text-[11px] font-mono text-zinc-400 mb-1.5">
                            Add files to this media item. Save changes to upload them.
                        </label>
                        <AdminFileDropzone id="edit-add-files-dropzone" inputId="add-more-files-input" accept="image/*,video/*" multiple label="Drop images or videos here to add files" browseButtonId="add-more-files-browse" browseLabel="Browse files" selectionId="add-more-files-selection" selectionText="No files selected" feedbackId="edit-add-files-feedback" />
                        <div id="edit-add-files-preview" class="mt-3 flex flex-wrap gap-3 empty:hidden"></div>
                        <p id="edit-add-files-reorder-hint" class="hidden text-[11px] font-mono text-zinc-500">Drag files by the grip to change their order. Focus a grip and use the arrow keys to reorder.</p>
                        <p id="edit-add-files-reorder-announcement" class="sr-only" aria-live="polite" aria-atomic="true"></p>
                    </div>
                </div>

                <div id="edit-upload-progress" class="hidden space-y-2 rounded-lg border border-zinc-800 bg-zinc-950/70 p-3" aria-live="polite">
                    <div class="flex items-center justify-between gap-3 text-[11px] font-mono text-zinc-300">
                        <span id="edit-upload-progress-label" class="min-w-0 truncate">Preparing uploads...</span>
                        <span id="edit-upload-progress-percent" class="shrink-0 text-orange-400">0%</span>
                    </div>
                    <div id="edit-upload-progress-track" role="progressbar" aria-label="File upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" class="h-2 w-full overflow-hidden rounded-full bg-zinc-800">
                        <div id="edit-upload-progress-bar" class="h-full w-0 rounded-full bg-orange-500 transition-[width] duration-200 ease-out"></div>
                    </div>
                </div>

                <div
                    id="edit-status"
                    class="hidden text-xs font-mono text-center rounded-lg p-2.5"
                >
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button
                        type="button"
                        id="edit-cancel-btn"
                        class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-mono text-xs uppercase rounded-lg transition-colors cursor-pointer"
                        >Back to Archive</button
                    >
                    <button
                        type="submit"
                        id="edit-submit-btn"
                        class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black font-mono text-xs uppercase rounded-lg transition-colors cursor-pointer"
                        >Save Changes</button
                    >
                </div>
            </form>
        </div>
    </section>
</div>

<script>
    import { uploadFileToAzure } from "../../lib/azureStorage";
    import { clearAdminDraft, readAdminDraft, saveAdminDraft } from "../../lib/adminDraft";
    import { attachFileDropzone } from "../../lib/fileDropzone";
    import { createAdminPagination } from "../../lib/adminPagination";

    const API_URL = "/api/admin/content";

    const PHOTO_ICON_SVG = `<svg class="w-2.5 h-2.5 text-orange-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;
    const PLAY_ICON_SVG = `<svg class="w-2.5 h-2.5 text-orange-400 fill-current ml-0.5" viewBox="0 0 24 24"><polygon points="6,4 20,12 6,20"/></svg>`;

    const rootEl = document.getElementById("archive-manager-root");
    const userRole = rootEl?.dataset.userRole || "SuperAdmin";
    const isSuperAdmin = userRole === "SuperAdmin";

    // --- ARCHIVE LIST / DEDICATED EDITOR VIEWS ---
    const archiveListView = document.getElementById("archive-list-view");
    const archiveCreateView = document.getElementById("archive-create-view");
    const archiveCreateButton = document.getElementById("archive-create-btn");
    const archiveCreateBackButton = document.getElementById("archive-create-back");
    const editModal = document.getElementById("edit-modal");
    const dashboardHeader = document.getElementById("dashboard-root");
    const pageContent = dashboardHeader?.parentElement;
    const contentManagerRoot = document.getElementById("content-manager-root");
    const contentTabBar = contentManagerRoot?.querySelector<HTMLElement>("[role='tablist']");
    const galleryTabPanel = document.getElementById("subtab-content-gallery");
    let currentArchiveView: "list" | "create" | "edit" = "list";
    let requestedEditId = new URLSearchParams(window.location.search).get("id");

    function setArchiveView(view: "list" | "create" | "edit", editId?: string, updateUrl = true) {
        currentArchiveView = view;
        archiveListView?.classList.toggle("hidden", view !== "list");
        archiveCreateView?.classList.toggle("hidden", view !== "create");
        editModal?.classList.toggle("hidden", view !== "edit");
        dashboardHeader?.classList.toggle("hidden", view !== "list");
        if (archiveListView) archiveListView.style.display = view === "list" ? "block" : "none";
        if (archiveCreateView) archiveCreateView.style.display = view === "create" ? "block" : "none";
        if (editModal) editModal.style.display = view === "edit" ? "block" : "none";
        if (dashboardHeader) dashboardHeader.style.display = view === "list" ? "flex" : "none";
        pageContent?.classList.toggle("space-y-5", view === "list");
        pageContent?.classList.toggle("space-y-0", view !== "list");
        rootEl?.classList.toggle("space-y-8", view === "list");
        rootEl?.classList.toggle("space-y-0", view !== "list");
        contentTabBar?.classList.toggle("hidden", view !== "list");
        if (contentTabBar) contentTabBar.style.display = view === "list" ? "" : "none";
        if (galleryTabPanel) {
            const galleryIsActive = document.getElementById("subtab-btn-gallery")?.getAttribute("aria-selected") === "true";
            galleryTabPanel.classList.toggle("hidden", view !== "list" || !galleryIsActive);
            galleryTabPanel.style.display = view === "list" && galleryIsActive ? "block" : "none";
        }

        if (updateUrl) {
            const url = new URL(window.location.href);
            if (view === "list") {
                url.searchParams.delete("archive");
                url.searchParams.delete("id");
            } else {
                url.searchParams.set("archive", view);
                if (view === "edit" && editId) url.searchParams.set("id", editId);
                else url.searchParams.delete("id");
            }
            window.history.pushState({ archiveView: view, editId }, "", url);
        }

        if (view === "create") {
            document.getElementById("archive-create-title")?.focus();
        } else if (view === "edit") {
            document.getElementById("edit-media-title")?.focus();
        } else {
            archiveCreateButton?.focus();
        }
    }

    archiveCreateButton?.addEventListener("click", () => setArchiveView("create"));
    archiveCreateBackButton?.addEventListener("click", () => setArchiveView("list"));
    window.addEventListener("popstate", () => {
        const url = new URL(window.location.href);
        const view = url.searchParams.get("archive");
        const editId = url.searchParams.get("id") || undefined;
        if (view === "create") setArchiveView("create", undefined, false);
        else if (view === "edit" && editId) {
            const item = allMediaItems.find((media) => media.id === editId);
            if (item) openEditScreen(item, false);
        } else setArchiveView("list", undefined, false);
    });

    const initialArchiveView = new URLSearchParams(window.location.search).get("archive");
    if (initialArchiveView === "create") setArchiveView("create", undefined, false);

    // State
    let allMediaItems: any[] = [];
    let stagedEditFiles: Array<{ file: File; previewUrl: string; uploadedAsset?: { url: string; publicId: string; type: string } }> = [];
    let touchEditFileDrag: { pointerId: number; from: number; x: number; y: number; activated: boolean; timer: number } | null = null;
    let currentSortColumn: string = "createdAt";
    let sortDirection: "asc" | "desc" = "desc";
    const mediaPagination = createAdminPagination("media", "media items", renderMediaTable);

    let selectedUploadFiles: File[] = [];
    let rememberedUploadFileNames: string[] = [];
    let activePreUploadIndex: number = -1;
    let coverFileIndex: number = 0;
    const customVideoPosters: Map<File, File> = new Map();
    const selectedFilePreviewUrls = new Map<File, string>();
    const archiveReorderHint = document.getElementById("archive-reorder-hint");
    const archiveReorderAnnouncement = document.getElementById("archive-reorder-announcement");
    let touchArchiveDrag: { pointerId: number; fromFile: File; x: number; y: number; activated: boolean; timer: number } | null = null;

    function getSelectedFilePreviewUrl(file: File) {
        let url = selectedFilePreviewUrls.get(file);
        if (!url) {
            url = URL.createObjectURL(file);
            selectedFilePreviewUrls.set(file, url);
        }
        return url;
    }

    let currentGalleryAssets: any[] = [];
    let currentGalleryIndex: number = 0;
    let currentGalleryTitle: string = "";


    // --- FILE PRE-UPLOAD PREVIEW SYSTEM ---
    const filesInput = document.getElementById("files-input") as HTMLInputElement;
    const selectFilesBtn = document.getElementById("select-files-btn");
    const filesDropzone = document.getElementById("files-dropzone");
    attachFileDropzone(filesDropzone, filesInput, { feedback: document.getElementById("files-drop-feedback"), nextStep: "submit" });
    const fileCountLabel = document.getElementById("file-count-label");
    const preUploadPreviewContainer = document.getElementById("pre-upload-preview");

    const preUploadModal = document.getElementById("pre-upload-modal");
    const preUploadModalImg = document.getElementById("pre-upload-modal-img") as HTMLImageElement;
    const preUploadModalVideo = document.getElementById("pre-upload-modal-video") as HTMLVideoElement;
    const preUploadModalFilename = document.getElementById("pre-upload-modal-filename");
    const preUploadModalCloseBtn = document.getElementById("pre-upload-modal-close");
    const preUploadModalDiscardBtn = document.getElementById("pre-upload-modal-discard-btn");
    const preUploadModalCaptureBtn = document.getElementById("pre-upload-modal-capture-btn");

    selectFilesBtn?.addEventListener("click", () => filesInput?.click());

    function appendSelectedFiles(files: File[]) {
        const acceptedFiles = files.filter((file) => {
            const extension = file.name.toLowerCase().match(/\.[^.]+$/)?.[0] || "";
            const supportedExtension = /\.(avif|bmp|gif|heic|heif|jpeg|jpg|m4v|mkv|mov|mp4|png|webm|webp)$/i.test(extension);
            return file.type.startsWith("image/") || file.type.startsWith("video/") || supportedExtension;
        });
        const rejectedCount = files.length - acceptedFiles.length;
        const existingKeys = new Set(selectedUploadFiles.map((file) => `${file.name}:${file.size}:${file.lastModified}`));
        const newFiles = acceptedFiles.filter((file) => !existingKeys.has(`${file.name}:${file.size}:${file.lastModified}`));

        if (newFiles.length) selectedUploadFiles = [...selectedUploadFiles, ...newFiles];
        rememberedUploadFileNames = selectedUploadFiles.map((file) => file.name);
        renderPreUploadPreviews();

        if (rejectedCount) {
            showStatus(`${rejectedCount} unsupported file(s) were skipped. Choose image or video files.`, "error");
        } else if (newFiles.length) {
            showStatus(`${newFiles.length} file(s) added.`, "success");
        }
    }

    filesInput?.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files.length > 0) {
            appendSelectedFiles(Array.from(target.files));
            target.value = "";
        }
    });

    /**
     * Captura el fotograma actual del elemento <video> en el modal y genera un archivo WebP ligero.
     */
    function captureCurrentVideoFrame(videoEl: HTMLVideoElement, fileName: string): Promise<File | null> {
        return new Promise((resolve) => {
            if (!videoEl || videoEl.readyState < 2) return resolve(null);

            const canvas = document.createElement("canvas");
            canvas.width = videoEl.videoWidth || 1280;
            canvas.height = videoEl.videoHeight || 720;

            const ctx = canvas.getContext("2d");
            if (!ctx) return resolve(null);

            ctx.drawImage(videoEl, 0, 0, canvas.width, canvas.height);

            canvas.toBlob(
                (blob) => {
                    if (!blob) return resolve(null);
                    const posterName = `${fileName.replace(/\.[^/.]+$/, "")}_poster.webp`;
                    const posterFile = new File([blob], posterName, { type: "image/webp" });
                    resolve(posterFile);
                },
                "image/webp",
                0.82
            );
        });
    }

    function removeSelectedFile(index: number) {
        if (index < 0 || index >= selectedUploadFiles.length) return;
        const [removedFile] = selectedUploadFiles.splice(index, 1);
        const previewUrl = selectedFilePreviewUrls.get(removedFile);
        if (previewUrl) URL.revokeObjectURL(previewUrl);
        selectedFilePreviewUrls.delete(removedFile);
        customVideoPosters.delete(removedFile);
        rememberedUploadFileNames = selectedUploadFiles.map((file) => file.name);

        // Ajustar el índice de la portada principal (Cover)
        if (coverFileIndex === index) {
            coverFileIndex = 0;
        } else if (coverFileIndex > index) {
            coverFileIndex--;
        }

        renderPreUploadPreviews();
    }

    function renderPreUploadPreviews() {
        if (!preUploadPreviewContainer || !fileCountLabel) return;
        const previousRects = new Map(Array.from(preUploadPreviewContainer.querySelectorAll<HTMLElement>("[data-file-key]"), (tile) => [tile.dataset.fileKey!, tile.getBoundingClientRect()]));

        if (coverFileIndex >= selectedUploadFiles.length) {
            coverFileIndex = 0;
        }

        fileCountLabel.innerText = selectedUploadFiles.length > 0
            ? `${selectedUploadFiles.length} file(s) selected`
            : "No files selected";
        archiveReorderHint?.classList.toggle("hidden", selectedUploadFiles.length < 2);

        preUploadPreviewContainer.innerHTML = selectedUploadFiles
            .map((file, index) => {
                const tempUrl = getSelectedFilePreviewUrl(file);
                const isVideo = file.type.startsWith("video/");
                const fileTypeIcon = isVideo ? PLAY_ICON_SVG : PHOTO_ICON_SVG;
                const isCover = index === coverFileIndex;
                const hasCustomPoster = customVideoPosters.has(file);

                return `
                <div 
                    data-file-index="${index}"
                    data-file-key="${tempUrl}"
                    class="pre-upload-thumb relative group size-24 overflow-hidden rounded-lg border ${isCover ? 'border-orange-500 ring-2 ring-orange-500/30' : 'border-zinc-800'} bg-black transition-[border-color,box-shadow,transform] duration-150"
                    title="Click to preview file"
                >
                    ${
                        isVideo
                            ? `<video src="${tempUrl}#t=0.1" class="w-full h-full object-cover pointer-events-none"></video>`
                            : `<img src="${tempUrl}" class="w-full h-full object-cover pointer-events-none" />`
                    }
                    
                    <span class="absolute top-1 left-1 bg-zinc-950/80 border border-zinc-800/80 rounded-md w-5 h-5 flex items-center justify-center shadow-md z-10 pointer-events-none select-none">
                        ${fileTypeIcon}
                    </span>

                    <button type="button" draggable="true" data-archive-drag-handle="${index}" aria-label="Drag file ${index + 1} to reorder" title="Drag to reorder" class="absolute left-1 top-7 inline-flex size-7 touch-none cursor-grab items-center justify-center rounded bg-zinc-950/90 text-zinc-100 hover:text-orange-400 active:cursor-grabbing focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange-400">
                      <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="currentColor"><circle cx="5" cy="3" r="1"/><circle cx="11" cy="3" r="1"/><circle cx="5" cy="8" r="1"/><circle cx="11" cy="8" r="1"/><circle cx="5" cy="13" r="1"/><circle cx="11" cy="13" r="1"/></svg>
                    </button>

                    <button
                        type="button"
                        data-cover-index="${index}"
                        class="set-cover-btn absolute bottom-1 left-1 px-1.5 py-0.5 ${isCover ? 'bg-orange-500 text-zinc-950 font-bold' : 'bg-zinc-950/80 text-zinc-400 hover:text-orange-400'} border border-zinc-800 rounded text-[9px] font-mono transition-colors shadow-md z-10"
                        title="Set as main cover asset"
                    >
                        ${isCover ? '<svg class="inline size-3.5" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.8 2.8 5.7 6.3.9-4.6 4.5 1.1 6.3-5.6-3-5.6 3 1.1-6.3L3 9.4l6.3-.9L12 2.8Z"/></svg> Cover' : 'Set Cover'}
                    </button>

                    ${hasCustomPoster ? `<span class="absolute bottom-1 right-1 inline-flex items-center gap-1 bg-emerald-500 text-zinc-950 text-[9px] font-mono px-1 rounded shadow-md z-10 font-bold" title="Custom video frame captured"><svg class="size-3" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="15" rx="2"/><circle cx="12" cy="13" r="3"/></svg>Poster</span>` : ''}

                    <button
                        type="button"
                        data-remove-index="${index}"
                        class="remove-file-btn absolute top-1 right-1 bg-zinc-950/80 hover:bg-zinc-950 text-zinc-400 hover:text-orange-500 border border-zinc-800/80 rounded-md w-5 h-5 flex items-center justify-center text-[10px] font-mono transition-colors cursor-pointer shadow-md z-10"
                        title="Remove file"
                    >
                        ✕
                    </button>
                </div>
            `;
            })
            .join("");

        preUploadPreviewContainer.querySelectorAll(".set-cover-btn").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const idx = parseInt((e.currentTarget as HTMLElement).dataset.coverIndex || "0");
                coverFileIndex = idx;
                renderPreUploadPreviews();
            });
        });

        preUploadPreviewContainer.querySelectorAll(".remove-file-btn").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const index = parseInt((e.currentTarget as HTMLElement).dataset.removeIndex || "-1");
                if (index > -1) removeSelectedFile(index);
            });
        });

        preUploadPreviewContainer.querySelectorAll(".pre-upload-thumb").forEach((thumb) => {
            thumb.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;
                if (target.closest(".remove-file-btn") || target.closest(".set-cover-btn") || target.closest("[data-archive-drag-handle]")) return;
                const index = parseInt((e.currentTarget as HTMLElement).dataset.fileIndex || "-1");
                if (index > -1) openPreUploadModal(index);
            });
        });

        preUploadPreviewContainer.querySelectorAll<HTMLElement>("[data-file-key]").forEach((tile) => {
            const previous = previousRects.get(tile.dataset.fileKey!);
            if (previous) {
                const current = tile.getBoundingClientRect();
                const dx = previous.left - current.left;
                const dy = previous.top - current.top;
                if (dx || dy) tile.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "translate(0, 0)" }], { duration: 180, easing: "ease-out" });
            }
            tile.addEventListener("dragover", (event) => {
                event.preventDefault();
                tile.classList.add("ring-2", "ring-orange-400", "scale-105", "z-10");
            });
            tile.addEventListener("dragleave", () => tile.classList.remove("ring-2", "ring-orange-400", "scale-105", "z-10"));
            tile.addEventListener("drop", (event) => {
                event.preventDefault();
                moveSelectedFile(Number((event as DragEvent).dataTransfer?.getData("text/plain")), Number(tile.dataset.fileIndex));
            });
        });
        preUploadPreviewContainer.querySelectorAll<HTMLButtonElement>("[data-archive-drag-handle]").forEach((handle) => {
            handle.addEventListener("keydown", (event) => {
                const keyboardEvent = event as KeyboardEvent;
                const earlier = keyboardEvent.key === "ArrowLeft" || keyboardEvent.key === "ArrowUp";
                const later = keyboardEvent.key === "ArrowRight" || keyboardEvent.key === "ArrowDown";
                if (!earlier && !later) return;
                keyboardEvent.preventDefault();
                const from = Number(handle.dataset.archiveDragHandle);
                if (moveSelectedFile(from, from + (earlier ? -1 : 1))) preUploadPreviewContainer?.querySelector<HTMLButtonElement>(`[data-archive-drag-handle="${from + (earlier ? -1 : 1)}"]`)?.focus();
            });
            handle.addEventListener("pointerdown", (event) => {
                const pointer = event as PointerEvent;
                if (pointer.pointerType !== "touch") return;
                const from = Number(handle.dataset.archiveDragHandle);
                const file = selectedUploadFiles[from];
                if (!file) return;
                touchArchiveDrag = { pointerId: pointer.pointerId, fromFile: file, x: pointer.clientX, y: pointer.clientY, activated: false, timer: window.setTimeout(() => {
                    if (touchArchiveDrag?.pointerId !== pointer.pointerId) return;
                    touchArchiveDrag.activated = true;
                    handle.closest<HTMLElement>("[data-file-key]")?.classList.add("opacity-40");
                }, 160) };
            });
            handle.addEventListener("pointermove", (event) => {
                const pointer = event as PointerEvent;
                if (touchArchiveDrag?.pointerId === pointer.pointerId && !touchArchiveDrag.activated && Math.hypot(pointer.clientX - touchArchiveDrag.x, pointer.clientY - touchArchiveDrag.y) > 7) {
                    window.clearTimeout(touchArchiveDrag.timer);
                    touchArchiveDrag = null;
                }
            });
            handle.addEventListener("dragstart", (event) => {
                const from = Number(handle.dataset.archiveDragHandle);
                (event as DragEvent).dataTransfer?.setData("text/plain", String(from));
                if ((event as DragEvent).dataTransfer) (event as DragEvent).dataTransfer!.effectAllowed = "move";
                handle.closest<HTMLElement>("[data-file-key]")?.classList.add("opacity-40");
            });
        });
    }

    function moveSelectedFile(from: number, to: number) {
        if (!Number.isInteger(from) || !Number.isInteger(to) || from < 0 || to < 0 || from >= selectedUploadFiles.length || to >= selectedUploadFiles.length || from === to) return false;
        const coverFile = selectedUploadFiles[coverFileIndex];
        const activeFile = selectedUploadFiles[activePreUploadIndex];
        const [moved] = selectedUploadFiles.splice(from, 1);
        selectedUploadFiles.splice(to, 0, moved);
        coverFileIndex = Math.max(0, selectedUploadFiles.indexOf(coverFile));
        if (activeFile) activePreUploadIndex = selectedUploadFiles.indexOf(activeFile);
        rememberedUploadFileNames = selectedUploadFiles.map((file) => file.name);
        renderPreUploadPreviews();
        archiveReorderAnnouncement && (archiveReorderAnnouncement.textContent = `File moved to position ${to + 1} of ${selectedUploadFiles.length}.`);
        return true;
    }

    window.addEventListener("pointermove", (event) => {
        if (!touchArchiveDrag?.activated || touchArchiveDrag.pointerId !== event.pointerId) return;
        const target = document.elementFromPoint(event.clientX, event.clientY)?.closest<HTMLElement>("#pre-upload-preview [data-file-key]");
        preUploadPreviewContainer?.querySelectorAll("[data-file-key]").forEach((tile) => tile.classList.remove("ring-2", "ring-orange-400", "scale-105", "z-10"));
        target?.classList.add("ring-2", "ring-orange-400", "scale-105", "z-10");
    });
    window.addEventListener("pointerup", (event) => {
        if (!touchArchiveDrag || touchArchiveDrag.pointerId !== event.pointerId) return;
        window.clearTimeout(touchArchiveDrag.timer);
        const drag = touchArchiveDrag;
        touchArchiveDrag = null;
        const target = document.elementFromPoint(event.clientX, event.clientY)?.closest<HTMLElement>("#pre-upload-preview [data-file-index]");
        const from = selectedUploadFiles.indexOf(drag.fromFile);
        const to = target ? Number(target.dataset.fileIndex) : -1;
        if (drag.activated) moveSelectedFile(from, to);
        preUploadPreviewContainer?.querySelectorAll("[data-file-key]").forEach((tile) => tile.classList.remove("opacity-40", "ring-2", "ring-orange-400", "scale-105", "z-10"));
    });
    window.addEventListener("pointercancel", () => {
        if (touchArchiveDrag) window.clearTimeout(touchArchiveDrag.timer);
        touchArchiveDrag = null;
        preUploadPreviewContainer?.querySelectorAll("[data-file-key]").forEach((tile) => tile.classList.remove("opacity-40", "ring-2", "ring-orange-400", "scale-105", "z-10"));
    });
    preUploadPreviewContainer?.addEventListener("dragend", () => preUploadPreviewContainer.querySelectorAll("[data-file-key]").forEach((tile) => tile.classList.remove("opacity-40", "ring-2", "ring-orange-400", "scale-105", "z-10")));

    function openPreUploadModal(index: number) {
        if (!preUploadModal || index < 0 || index >= selectedUploadFiles.length) return;
        
        activePreUploadIndex = index;
        const file = selectedUploadFiles[index];
        const tempUrl = URL.createObjectURL(file);
        const isVideo = file.type.startsWith("video/");

        if (isVideo) {
            if (preUploadModalImg) preUploadModalImg.classList.add("hidden");
            if (preUploadModalVideo) {
                preUploadModalVideo.src = tempUrl;
                preUploadModalVideo.classList.remove("hidden");
            }
            if (preUploadModalCaptureBtn) preUploadModalCaptureBtn.classList.remove("hidden");
        } else {
            if (preUploadModalVideo) {
                preUploadModalVideo.pause();
                preUploadModalVideo.classList.add("hidden");
            }
            if (preUploadModalImg) {
                preUploadModalImg.src = tempUrl;
                preUploadModalImg.classList.remove("hidden");
            }
            if (preUploadModalCaptureBtn) preUploadModalCaptureBtn.classList.add("hidden");
        }

        if (preUploadModalFilename) preUploadModalFilename.innerText = file.name;
        preUploadModal.classList.remove("hidden");
    }

    preUploadModalCaptureBtn?.addEventListener("click", async () => {
        if (activePreUploadIndex < 0 || !preUploadModalVideo) return;
        
        const currentFile = selectedUploadFiles[activePreUploadIndex];
        const posterFile = await captureCurrentVideoFrame(preUploadModalVideo, currentFile.name);

        if (posterFile) {
            customVideoPosters.set(currentFile, posterFile);
            renderPreUploadPreviews();
            showStatus("Video poster frame captured successfully!", "success");
        }
    });

    function closePreUploadModal() {
        if (preUploadModal) preUploadModal.classList.add("hidden");
        if (preUploadModalVideo) preUploadModalVideo.pause();
        activePreUploadIndex = -1;
    }

    preUploadModalCloseBtn?.addEventListener("click", closePreUploadModal);
    preUploadModal?.addEventListener("click", (e) => {
        if (e.target === preUploadModal) closePreUploadModal();
    });

    preUploadModalDiscardBtn?.addEventListener("click", () => {
        if (activePreUploadIndex > -1 && activePreUploadIndex < selectedUploadFiles.length) {
            const idxToRemove = activePreUploadIndex;
            closePreUploadModal();
            removeSelectedFile(idxToRemove);
        }
    });

    // --- HANDLE UPLOAD FORM SUBMIT (SUBIDA DIRECTA A AZURE BLOB STORAGE) ---
    const uploadForm = document.getElementById("upload-form") as HTMLFormElement;
    const uploadBtn = document.getElementById("upload-btn") as HTMLButtonElement;
    const statusMsg = document.getElementById("status-message") as HTMLDivElement;
    
    const progressContainer = document.getElementById("upload-progress-container");
    const progressBar = document.getElementById("upload-progress-bar");
    const progressPercentage = document.getElementById("upload-percentage");
    const statusText = document.getElementById("upload-status-text");
    const archiveDraftKey = "uv.admin.archive-upload-draft.v1";
    const archiveDraftNotice = document.getElementById("archive-draft-notice");
    const archiveDraftNoticeText = document.getElementById("archive-draft-notice-text");
    const archiveDraftClearButton = document.getElementById("archive-draft-clear");

    type ArchiveDraftValues = {
        title: string;
        category: string;
        hashtags: string;
        description: string;
        fileNames: string[];
        isArchived?: boolean;
    };

    function getArchiveDraftValues(): ArchiveDraftValues {
        return {
            title: (document.getElementById("title") as HTMLInputElement).value,
            category: (document.getElementById("category") as HTMLInputElement).value,
            hashtags: (document.getElementById("hashtags") as HTMLInputElement).value,
            description: (document.getElementById("description") as HTMLTextAreaElement).value,
            fileNames: selectedUploadFiles.length
                ? selectedUploadFiles.map((file) => file.name)
                : rememberedUploadFileNames,
            isArchived: (document.getElementById("archive-is-archived") as HTMLInputElement).checked,
        };
    }

    function showArchiveDraftNotice(uploadInterrupted: boolean, fileNames: string[]) {
        if (!archiveDraftNotice || !archiveDraftNoticeText) return;
        const fileNote = fileNames.length ? ` Selected files: ${fileNames.join(", ")}.` : "";
        archiveDraftNoticeText.textContent = uploadInterrupted
            ? `An upload was interrupted. Your form details were restored. Select the same file(s) again to resume the upload.${fileNote}`
            : `Your saved archive draft was restored. Select the same file(s) again if you need to resume an interrupted upload.${fileNote}`;
        archiveDraftNotice.classList.remove("hidden");
        const archivePanelIsActive = document.getElementById("subtab-content-archive")?.style.display !== "none";
        if (archivePanelIsActive) setArchiveView("create");
    }

    function persistArchiveDraft(uploadInterrupted = false) {
        saveAdminDraft(archiveDraftKey, getArchiveDraftValues(), uploadInterrupted);
    }

    const savedArchiveDraft = readAdminDraft<ArchiveDraftValues>(archiveDraftKey);
    if (savedArchiveDraft) {
        const values = savedArchiveDraft.values;
        rememberedUploadFileNames = values.fileNames || [];
        (document.getElementById("title") as HTMLInputElement).value = values.title || "";
        (document.getElementById("category") as HTMLInputElement).value = values.category || "General";
        (document.getElementById("hashtags") as HTMLInputElement).value = values.hashtags || "";
        (document.getElementById("description") as HTMLTextAreaElement).value = values.description || "";
        (document.getElementById("archive-is-archived") as HTMLInputElement).checked = Boolean(values.isArchived);
        showArchiveDraftNotice(savedArchiveDraft.uploadInterrupted, values.fileNames || []);
    }

    uploadForm?.addEventListener("input", () => persistArchiveDraft());
    uploadForm?.addEventListener("change", () => persistArchiveDraft());
    archiveDraftClearButton?.addEventListener("click", () => {
        clearAdminDraft(archiveDraftKey);
        archiveDraftNotice?.classList.add("hidden");
    });

    uploadForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!uploadBtn) return;

        if (selectedUploadFiles.length === 0) {
            showStatus("Please select at least one image or video file.", "error");
            return;
        }

        persistArchiveDraft(true);


        uploadBtn.disabled = true;
        if (archiveCreateBackButton instanceof HTMLButtonElement) archiveCreateBackButton.disabled = true;
        uploadBtn.innerText = "Processing Direct Azure Upload...";
        statusMsg.classList.add("hidden");
        progressContainer?.classList.remove("hidden");
        if (progressBar) progressBar.style.width = "0%";
        if (progressPercentage) progressPercentage.innerText = "0%";

        const titleVal = (document.getElementById("title") as HTMLInputElement).value;
        const categoryVal = (document.getElementById("category") as HTMLInputElement).value;
        const hashtagsVal = (document.getElementById("hashtags") as HTMLInputElement).value;
        const descriptionVal = (document.getElementById("description") as HTMLTextAreaElement).value;

        const hashtagsArray = hashtagsVal
            ? hashtagsVal.split(",").map((t) => t.trim()).filter(Boolean)
            : [];

        try {
            const uploadedAssets: { url: string; publicId: string; type: string; isCover: boolean; thumbnailUrl?: string }[] = [];
            const totalFiles = selectedUploadFiles.length;
            const totalUploadUnits = totalFiles + selectedUploadFiles.filter((file) => customVideoPosters.has(file)).length;
            let completedUploadUnits = 0;
            const uploadAndTrack = async (file: File, targetPath: string, label: string) => {
                if (statusText) statusText.innerText = `${label}: ${file.name}`;
                const result = await uploadFileToAzure(file, targetPath, (filePercent) => {
                    const totalProgress = Math.min(Math.round(((completedUploadUnits + filePercent / 100) / totalUploadUnits) * 95), 95);
                    if (progressBar) progressBar.style.width = `${totalProgress}%`;
                    if (progressPercentage) progressPercentage.innerText = `${totalProgress}%`;
                });
                completedUploadUnits++;
                const totalProgress = Math.min(Math.round((completedUploadUnits / totalUploadUnits) * 95), 95);
                if (progressBar) progressBar.style.width = `${totalProgress}%`;
                if (progressPercentage) progressPercentage.innerText = `${totalProgress}%`;
                return result;
            };

            for (let i = 0; i < totalFiles; i++) {
                const file = selectedUploadFiles[i];
                const isVideo = file.type.startsWith("video/");
                const isCover = i === coverFileIndex;

                let thumbnailUrl: string | undefined = undefined;

                // Subir el Poster del video a Azure (archive-media/thumbnails) si existe una captura
                if (isVideo && customVideoPosters.has(file)) {
                    const posterFile = customVideoPosters.get(file)!;
                    if (statusText) statusText.innerText = `Uploading video poster frame to Azure...`;
                    const posterResult = await uploadAndTrack(posterFile, "archive-media/thumbnails", `Video poster ${i + 1} of ${totalFiles}`);
                    thumbnailUrl = posterResult.url;
                }

                const targetPath = isVideo ? "archive-media/videos" : "archive-media/photos";
                if (statusText) statusText.innerText = `Authorizing & uploading ${file.name} to Azure (${i + 1}/${totalFiles})...`;

                const azureResult = await uploadAndTrack(file, targetPath, `File ${i + 1} of ${totalFiles}`);

                uploadedAssets.push({
                    url: azureResult.url,
                    publicId: azureResult.publicId,
                    type: isVideo ? "video" : "image",
                    isCover,
                    ...(thumbnailUrl && { thumbnailUrl }),
                });
            }

            if (statusText) statusText.innerText = "Registering record in database...";
            if (progressBar) progressBar.style.width = "98%";
            if (progressPercentage) progressPercentage.innerText = "98%";

            const finalPayload = {
                title: titleVal,
                description: descriptionVal || "",
                category: categoryVal || "General",
                hashtags: hashtagsArray,
                isArchived: (document.getElementById("archive-is-archived") as HTMLInputElement).checked,
                assets: uploadedAssets,
            };

            const finalRes = await fetch(`${API_URL}/media/upload`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(finalPayload),
            });

            const responseData = await finalRes.json();
            if (!finalRes.ok) throw new Error(responseData.message || "Failed to register media item.");

            if (progressBar) progressBar.style.width = "100%";
            if (progressPercentage) progressPercentage.innerText = "100%";
            if (statusText) statusText.innerText = "Upload completed successfully!";

            showStatus("Files uploaded to Azure and registered successfully!", "success");
            uploadForm.reset();
            selectedUploadFiles = [];
            for (const previewUrl of selectedFilePreviewUrls.values()) URL.revokeObjectURL(previewUrl);
            selectedFilePreviewUrls.clear();
            customVideoPosters.clear();
            coverFileIndex = 0;
            renderPreUploadPreviews();
            clearAdminDraft(archiveDraftKey);
            archiveDraftNotice?.classList.add("hidden");
            await fetchMediaList();

            setTimeout(() => {
                progressContainer?.classList.add("hidden");
                setArchiveView("list");
            }, 1500);

        } catch (err: any) {
            showStatus(err.message || "An error occurred during upload.", "error");
            if (statusText) statusText.innerText = "Upload paused. Resolve the issue and submit again to continue.";
        } finally {
            uploadBtn.disabled = false;
            if (archiveCreateBackButton instanceof HTMLButtonElement) archiveCreateBackButton.disabled = false;
            uploadBtn.innerText = "Upload to Archive";
        }
    });

    function showStatus(msg: string, type: "success" | "error") {
        if (!statusMsg) return;
        statusMsg.innerText = msg;
        statusMsg.classList.remove("hidden");
        if (type === "success") {
            statusMsg.className = "text-xs font-mono text-center rounded-lg p-3 bg-emerald-950/80 text-emerald-400 border border-emerald-800";
        } else {
            statusMsg.className = "text-xs font-mono text-center rounded-lg p-3 bg-red-950/80 text-red-400 border border-red-800";
        }
    }

    // Refresh
    const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement;
    refreshBtn?.addEventListener("click", async () => {
        refreshBtn.disabled = true;
        const label = refreshBtn.querySelector("span");
        if (label) label.innerText = "Refreshing...";
        await fetchMediaList();
        if (label) label.innerText = "Refresh";
        refreshBtn.disabled = false;
    });

    // Filters
    document.getElementById("search-input")?.addEventListener("input", () => { mediaPagination.reset(); renderMediaTable(); });
    document.getElementById("filter-type")?.addEventListener("change", () => { mediaPagination.reset(); renderMediaTable(); });
    document.getElementById("filter-status")?.addEventListener("change", () => { mediaPagination.reset(); renderMediaTable(); });
    const clearMediaFiltersBtn = document.getElementById("clear-media-filters-btn") as HTMLButtonElement | null;
    const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
    const mediaTypeFilter = document.getElementById("filter-type") as HTMLSelectElement | null;
    const mediaStatusFilter = document.getElementById("filter-status") as HTMLSelectElement | null;
    const updateMediaResetState = () => {
        if (clearMediaFiltersBtn) clearMediaFiltersBtn.disabled = !Boolean(searchInput?.value.trim()) && mediaTypeFilter?.value === "ALL" && mediaStatusFilter?.value === "ALL";
    };
    searchInput?.addEventListener("input", updateMediaResetState);
    mediaTypeFilter?.addEventListener("change", updateMediaResetState);
    mediaStatusFilter?.addEventListener("change", updateMediaResetState);
    clearMediaFiltersBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        if (mediaTypeFilter) mediaTypeFilter.value = "ALL";
        if (mediaStatusFilter) mediaStatusFilter.value = "ALL";
        updateMediaResetState();
        mediaPagination.reset();
        renderMediaTable();
    });

    // Sorting
    const mobileSortSelect = document.getElementById("media-mobile-sort") as HTMLSelectElement;
    const mobileSortDirectionBtn = document.getElementById("media-mobile-sort-direction") as HTMLButtonElement;

    mobileSortSelect?.addEventListener("change", () => {
        currentSortColumn = mobileSortSelect.value;
        sortDirection = currentSortColumn === "createdAt" ? "desc" : "asc";
        updateSortHeadersUI();
        mediaPagination.reset();
        renderMediaTable();
    });

    mobileSortDirectionBtn?.addEventListener("click", () => {
        sortDirection = sortDirection === "asc" ? "desc" : "asc";
        updateSortHeadersUI();
        mediaPagination.reset();
        renderMediaTable();
    });

    document.querySelectorAll(".sort-header").forEach((header) => {
        header.addEventListener("click", (e) => {
            const target = e.currentTarget as HTMLElement;
            const column = target.getAttribute("data-sort");
            if (!column) return;

            if (currentSortColumn === column) {
                sortDirection = sortDirection === "asc" ? "desc" : "asc";
            } else {
                currentSortColumn = column;
                sortDirection = column === "createdAt" ? "desc" : "asc";
            }

            updateSortHeadersUI();
            mediaPagination.reset();
            renderMediaTable();
        });
    });

    function updateSortHeadersUI() {
        document.querySelectorAll(".sort-header").forEach((header) => {
            const el = header as HTMLElement;
            const column = el.getAttribute("data-sort");
            const iconSpan = el.querySelector(".sort-icon") as HTMLElement;

            if (column === currentSortColumn) {
                el.classList.add("text-orange-500");
                el.classList.remove("text-zinc-400");
                if (iconSpan) {
                    iconSpan.innerText = sortDirection === "asc" ? "↑" : "↓";
                    iconSpan.classList.add("opacity-100");
                    iconSpan.classList.remove("opacity-40");
                }
            } else {
                el.classList.remove("text-orange-500");
                el.classList.add("text-zinc-400");
                if (iconSpan) {
                    iconSpan.innerText = "↕";
                    iconSpan.classList.add("opacity-40");
                    iconSpan.classList.remove("opacity-100");
                }
            }
        });

        if (mobileSortSelect) mobileSortSelect.value = currentSortColumn;
        if (mobileSortDirectionBtn) {
            mobileSortDirectionBtn.innerText = currentSortColumn === "createdAt"
                ? sortDirection === "desc" ? "Newest first" : "Oldest first"
                : sortDirection === "asc" ? "Ascending" : "Descending";
        }
    }

    // Modal Carousel
    const imageModal = document.getElementById("image-modal");
    const modalImg = document.getElementById("modal-img") as HTMLImageElement;
    const modalVideo = document.getElementById("modal-video") as HTMLVideoElement;
    const modalTitle = document.getElementById("modal-title");
    const modalCounter = document.getElementById("modal-counter");
    const modalCloseBtn = document.getElementById("modal-close-btn");
    const modalPrevBtn = document.getElementById("modal-prev-btn");
    const modalNextBtn = document.getElementById("modal-next-btn");

    function openMediaGallery(assets: any[], initialIndex: number = 0, title: string = "") {
        if (!imageModal || !assets || assets.length === 0) return;

        currentGalleryAssets = assets;
        currentGalleryIndex = initialIndex;
        currentGalleryTitle = title;

        updateGalleryView();
        imageModal.classList.remove("hidden");
    }

    function updateGalleryView() {
        if (currentGalleryAssets.length === 0) return;

        const currentAsset = currentGalleryAssets[currentGalleryIndex];
        if (!currentAsset) return;

        const isVideo = currentAsset.type === "video";

        if (isVideo) {
            if (modalImg) modalImg.classList.add("hidden");
            if (modalVideo) {
                modalVideo.src = currentAsset.url;
                modalVideo.classList.remove("hidden");
            }
        } else {
            if (modalVideo) {
                modalVideo.pause();
                modalVideo.classList.add("hidden");
            }
            if (modalImg) {
                modalImg.src = currentAsset.url;
                modalImg.classList.remove("hidden");
            }
        }

        if (modalTitle) modalTitle.innerText = currentGalleryTitle;
        if (modalCounter) {
            modalCounter.innerText = `${currentGalleryIndex + 1} / ${currentGalleryAssets.length}`;
        }

        const hasMultiple = currentGalleryAssets.length > 1;
        if (modalPrevBtn) modalPrevBtn.style.display = hasMultiple ? "flex" : "none";
        if (modalNextBtn) modalNextBtn.style.display = hasMultiple ? "flex" : "none";
    }

    function prevGalleryItem() {
        if (currentGalleryAssets.length <= 1) return;
        currentGalleryIndex = (currentGalleryIndex - 1 + currentGalleryAssets.length) % currentGalleryAssets.length;
        updateGalleryView();
    }

    function nextGalleryItem() {
        if (currentGalleryAssets.length <= 1) return;
        currentGalleryIndex = (currentGalleryIndex + 1) % currentGalleryAssets.length;
        updateGalleryView();
    }

    function closeImageModal() {
        if (imageModal) imageModal.classList.add("hidden");
        if (modalVideo) modalVideo.pause();
        currentGalleryAssets = [];
        currentGalleryIndex = 0;
        currentGalleryTitle = "";
    }

    modalPrevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        prevGalleryItem();
    });

    modalNextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        nextGalleryItem();
    });

    modalCloseBtn?.addEventListener("click", closeImageModal);
    imageModal?.addEventListener("click", (e) => {
        if (e.target === imageModal) closeImageModal();
    });

    // Edit Modal
    const editModalCloseBtn = document.getElementById("edit-modal-close");
    const editCancelBtn = document.getElementById("edit-cancel-btn");
    const editForm = document.getElementById("edit-form") as HTMLFormElement;
    const editStatus = document.getElementById("edit-status") as HTMLDivElement;
    const editAssetsList = document.getElementById("edit-assets-list");
    const addMoreFilesInput = document.getElementById("add-more-files-input") as HTMLInputElement;
    const addMoreFilesPreview = document.getElementById("edit-add-files-preview");
    const editReorderHint = document.getElementById("edit-add-files-reorder-hint");
    const editReorderAnnouncement = document.getElementById("edit-add-files-reorder-announcement");
    const editUploadProgress = document.getElementById("edit-upload-progress");
    const editUploadProgressLabel = document.getElementById("edit-upload-progress-label");
    const editUploadProgressPercent = document.getElementById("edit-upload-progress-percent");
    const editUploadProgressTrack = document.getElementById("edit-upload-progress-track");
    const editUploadProgressBar = document.getElementById("edit-upload-progress-bar");
    document.getElementById("add-more-files-browse")?.addEventListener("click", () => addMoreFilesInput?.click());
    attachFileDropzone(document.getElementById("edit-add-files-dropzone"), addMoreFilesInput, { feedback: document.getElementById("edit-add-files-feedback"), nextStep: "submit" });

    function renderStagedEditFiles() {
        const label = document.getElementById("add-more-files-selection");
        if (label) label.textContent = stagedEditFiles.length ? `${stagedEditFiles.length} file(s) ready to upload` : "No files selected";
        editReorderHint?.classList.toggle("hidden", stagedEditFiles.length < 2);
        if (!addMoreFilesPreview) return;
        const previousRects = new Map(Array.from(addMoreFilesPreview.querySelectorAll<HTMLElement>("[data-edit-staged-key]"), (tile) => [tile.dataset.editStagedKey!, tile.getBoundingClientRect()]));
        addMoreFilesPreview.innerHTML = stagedEditFiles.map(({ file, previewUrl }, index) => {
            const isVideo = file.type.startsWith("video/");
            return `<div data-edit-staged-index="${index}" data-edit-staged-key="${previewUrl}" class="relative size-24 overflow-hidden rounded-lg border ${stagedEditFiles[index].uploadedAsset ? "border-emerald-600/70" : "border-orange-500/50"} bg-zinc-950 transition-[border-color,box-shadow,transform] duration-150">
                ${isVideo ? `<video src="${previewUrl}#t=0.1" class="h-full w-full object-cover"></video>` : `<img src="${previewUrl}" alt="Preview ${file.name}" class="h-full w-full object-cover" />`}
                <span class="absolute bottom-0 left-0 right-0 truncate bg-zinc-950/90 px-1 py-0.5 text-center text-[9px] font-mono ${stagedEditFiles[index].uploadedAsset ? "text-emerald-300" : "text-orange-300"}">${stagedEditFiles[index].uploadedAsset ? "Uploaded" : "Ready"}</span>
                <button type="button" draggable="true" data-edit-staged-handle="${index}" aria-label="Drag file ${index + 1} to reorder" title="Drag to reorder" class="absolute left-1 top-1 inline-flex size-7 touch-none cursor-grab items-center justify-center rounded bg-zinc-950/90 text-zinc-100 hover:text-orange-400 active:cursor-grabbing focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange-400"><svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="currentColor"><circle cx="5" cy="3" r="1"/><circle cx="11" cy="3" r="1"/><circle cx="5" cy="8" r="1"/><circle cx="11" cy="8" r="1"/><circle cx="5" cy="13" r="1"/><circle cx="11" cy="13" r="1"/></svg></button>
                <button type="button" data-remove-staged-edit-file="${index}" aria-label="Remove file ${index + 1}" class="absolute right-1 top-1 flex size-6 items-center justify-center rounded bg-zinc-950/90 text-xs text-zinc-200 hover:text-orange-400">×</button>
            </div>`;
        }).join("");
        addMoreFilesPreview.querySelectorAll<HTMLElement>("[data-edit-staged-key]").forEach((tile) => {
            const previous = previousRects.get(tile.dataset.editStagedKey!);
            if (previous) {
                const current = tile.getBoundingClientRect();
                const dx = previous.left - current.left;
                const dy = previous.top - current.top;
                if (dx || dy) tile.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "translate(0, 0)" }], { duration: 180, easing: "ease-out" });
            }
            tile.addEventListener("dragover", (event) => { event.preventDefault(); tile.classList.add("ring-2", "ring-orange-400", "scale-105", "z-10"); });
            tile.addEventListener("dragleave", () => tile.classList.remove("ring-2", "ring-orange-400", "scale-105", "z-10"));
            tile.addEventListener("drop", (event) => {
                event.preventDefault();
                moveStagedEditFile(Number((event as DragEvent).dataTransfer?.getData("text/plain")), Number(tile.dataset.editStagedIndex));
            });
        });
        addMoreFilesPreview.querySelectorAll<HTMLButtonElement>("[data-edit-staged-handle]").forEach((handle) => {
            handle.addEventListener("keydown", (event) => {
                const keyEvent = event as KeyboardEvent;
                const earlier = keyEvent.key === "ArrowLeft" || keyEvent.key === "ArrowUp";
                const later = keyEvent.key === "ArrowRight" || keyEvent.key === "ArrowDown";
                if (!earlier && !later) return;
                keyEvent.preventDefault();
                const from = Number(handle.dataset.editStagedHandle);
                const to = from + (earlier ? -1 : 1);
                if (moveStagedEditFile(from, to)) addMoreFilesPreview?.querySelector<HTMLButtonElement>(`[data-edit-staged-handle="${to}"]`)?.focus();
            });
            handle.addEventListener("pointerdown", (event) => {
                const pointer = event as PointerEvent;
                if (pointer.pointerType !== "touch") return;
                const from = Number(handle.dataset.editStagedHandle);
                touchEditFileDrag = { pointerId: pointer.pointerId, from, x: pointer.clientX, y: pointer.clientY, activated: false, timer: window.setTimeout(() => {
                    if (touchEditFileDrag?.pointerId !== pointer.pointerId) return;
                    touchEditFileDrag.activated = true;
                    handle.closest<HTMLElement>("[data-edit-staged-key]")?.classList.add("opacity-40");
                }, 160) };
            });
            handle.addEventListener("pointermove", (event) => {
                const pointer = event as PointerEvent;
                if (touchEditFileDrag?.pointerId === pointer.pointerId && !touchEditFileDrag.activated && Math.hypot(pointer.clientX - touchEditFileDrag.x, pointer.clientY - touchEditFileDrag.y) > 7) {
                    window.clearTimeout(touchEditFileDrag.timer);
                    touchEditFileDrag = null;
                }
            });
            handle.addEventListener("dragstart", (event) => {
                (event as DragEvent).dataTransfer?.setData("text/plain", handle.dataset.editStagedHandle || "");
                if ((event as DragEvent).dataTransfer) (event as DragEvent).dataTransfer!.effectAllowed = "move";
                handle.closest<HTMLElement>("[data-edit-staged-key]")?.classList.add("opacity-40");
            });
        });
        addMoreFilesPreview.querySelectorAll<HTMLButtonElement>("[data-remove-staged-edit-file]").forEach((button) => {
            button.addEventListener("click", () => {
                const index = Number(button.dataset.removeStagedEditFile);
                const [removed] = stagedEditFiles.splice(index, 1);
                if (removed) URL.revokeObjectURL(removed.previewUrl);
                renderStagedEditFiles();
            });
        });
    }

    function moveStagedEditFile(from: number, to: number) {
        if (!Number.isInteger(from) || !Number.isInteger(to) || from < 0 || to < 0 || from >= stagedEditFiles.length || to >= stagedEditFiles.length || from === to) return false;
        const [moved] = stagedEditFiles.splice(from, 1);
        stagedEditFiles.splice(to, 0, moved);
        renderStagedEditFiles();
        if (editReorderAnnouncement) editReorderAnnouncement.textContent = `File moved to position ${to + 1} of ${stagedEditFiles.length}.`;
        return true;
    }

    addMoreFilesPreview?.addEventListener("dragend", () => addMoreFilesPreview.querySelectorAll("[data-edit-staged-key]").forEach((tile) => tile.classList.remove("opacity-40", "ring-2", "ring-orange-400", "scale-105", "z-10")));
    window.addEventListener("pointermove", (event) => {
        if (!touchEditFileDrag?.activated || touchEditFileDrag.pointerId !== event.pointerId) return;
        const target = document.elementFromPoint(event.clientX, event.clientY)?.closest<HTMLElement>("#edit-add-files-preview [data-edit-staged-key]");
        addMoreFilesPreview?.querySelectorAll("[data-edit-staged-key]").forEach((tile) => tile.classList.remove("ring-2", "ring-orange-400", "scale-105", "z-10"));
        target?.classList.add("ring-2", "ring-orange-400", "scale-105", "z-10");
    });
    window.addEventListener("pointerup", (event) => {
        if (!touchEditFileDrag || touchEditFileDrag.pointerId !== event.pointerId) return;
        window.clearTimeout(touchEditFileDrag.timer);
        const drag = touchEditFileDrag;
        touchEditFileDrag = null;
        const target = document.elementFromPoint(event.clientX, event.clientY)?.closest<HTMLElement>("#edit-add-files-preview [data-edit-staged-index]");
        if (drag.activated) moveStagedEditFile(drag.from, target ? Number(target.dataset.editStagedIndex) : -1);
        addMoreFilesPreview?.querySelectorAll("[data-edit-staged-key]").forEach((tile) => tile.classList.remove("opacity-40", "ring-2", "ring-orange-400", "scale-105", "z-10"));
    });
    window.addEventListener("pointercancel", () => {
        if (touchEditFileDrag) window.clearTimeout(touchEditFileDrag.timer);
        touchEditFileDrag = null;
        addMoreFilesPreview?.querySelectorAll("[data-edit-staged-key]").forEach((tile) => tile.classList.remove("opacity-40", "ring-2", "ring-orange-400", "scale-105", "z-10"));
    });

    addMoreFilesInput?.addEventListener("change", () => {
        const files = Array.from(addMoreFilesInput.files || []);
        addMoreFilesInput.value = "";
        for (const file of files) stagedEditFiles.push({ file, previewUrl: URL.createObjectURL(file) });
        renderStagedEditFiles();
        const feedback = document.getElementById("edit-add-files-feedback");
        if (feedback && files.length) feedback.textContent = `${files.length} file(s) added. Save changes to upload.`;
    });

    function closeEditModal() {
        setArchiveView("list");
        if (editStatus) editStatus.className = "hidden text-xs font-mono text-center rounded-lg p-2.5";
        editUploadProgress?.classList.add("hidden");
        if (editUploadProgressBar) editUploadProgressBar.style.width = "0%";
        if (editUploadProgressPercent) editUploadProgressPercent.textContent = "0%";
        if (addMoreFilesInput) addMoreFilesInput.value = "";
        stagedEditFiles.forEach((item) => URL.revokeObjectURL(item.previewUrl));
        stagedEditFiles = [];
        renderStagedEditFiles();
    }

    editModalCloseBtn?.addEventListener("click", closeEditModal);
    editCancelBtn?.addEventListener("click", closeEditModal);

    window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            closeImageModal();
            closePreUploadModal();
            if (currentArchiveView !== "list") setArchiveView("list");
        }
        if (imageModal && !imageModal.classList.contains("hidden")) {
            if (e.key === "ArrowLeft") prevGalleryItem();
            if (e.key === "ArrowRight") nextGalleryItem();
        }
    });

    function renderEditAssets(item: any) {
        if (!editAssetsList) return;
        const assets = item.media || [];

        if (assets.length === 0) {
            editAssetsList.innerHTML = `<span class="text-xs text-zinc-500 font-mono py-1">No assets attached.</span>`;
            return;
        }

        editAssetsList.innerHTML = assets
            .map((asset: any) => {
                const isVideo = asset.type === "video";
                const fileTypeIcon = isVideo ? PLAY_ICON_SVG : PHOTO_ICON_SVG;

                return `
                <div 
                    data-asset-url="${asset.url}"
                    data-asset-type="${asset.type}"
                    class="edit-asset-thumb relative group w-20 h-20 rounded-lg border border-zinc-800 overflow-hidden bg-black flex items-center justify-center cursor-pointer hover:border-orange-500/60 transition-all shrink-0"
                    title="Click to preview file"
                >
                    ${
                        isVideo
                            ? `<video src="${asset.thumbnailUrl || asset.url + '#t=0.1'}" class="w-full h-full object-cover pointer-events-none"></video>`
                            : `<img src="${asset.url}" class="w-full h-full object-cover pointer-events-none" />`
                    }
                    <span
                        class="absolute top-1 left-1 bg-zinc-950/80 border border-zinc-800/80 rounded-md w-5 h-5 flex items-center justify-center shadow-md z-10 pointer-events-none select-none"
                    >
                        ${fileTypeIcon}
                    </span>

                    <button
                        type="button"
                        data-asset-id="${asset.id}"
                        data-item-id="${item.id}"
                        class="delete-asset-btn absolute top-1 right-1 bg-zinc-950/80 hover:bg-zinc-950 text-zinc-400 hover:text-orange-500 border border-zinc-800/80 rounded-md w-5 h-5 flex items-center justify-center text-[10px] font-mono transition-colors cursor-pointer shadow-md z-10"
                        title="Delete asset"
                    >
                        ✕
                    </button>
                </div>
            `;
            })
            .join("");

        editAssetsList.querySelectorAll(".edit-asset-thumb").forEach((thumb, index) => {
            thumb.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;
                if (target.closest(".delete-asset-btn")) return;
                if (assets && assets.length > 0) {
                    openMediaGallery(assets, index, item.title || "");
                }
            });
        });

        editAssetsList.querySelectorAll(".delete-asset-btn").forEach((btn) => {
            btn.addEventListener("click", async (e) => {
                e.stopPropagation();
                const el = e.currentTarget as HTMLElement;
                const assetId = el.dataset.assetId;
                const itemId = el.dataset.itemId;
                if (!assetId || !confirm("Delete this file permanently?")) return;


                try {
                    const res = await fetch(`${API_URL}/media/assets/${assetId}`, {
                        method: "DELETE",
                    });

                    if (!res.ok) throw new Error("Failed to delete asset.");

                    await fetchMediaList();
                    const updatedItem = allMediaItems.find((m) => m.id === itemId);
                    if (updatedItem) renderEditAssets(updatedItem);
                } catch (err: any) {
                    alert(err.message || "Error deleting asset.");
                }
            });
        });
    }

    function openEditScreen(item: any, updateUrl = true) {
        stagedEditFiles.forEach((entry) => URL.revokeObjectURL(entry.previewUrl));
        stagedEditFiles = [];
        renderStagedEditFiles();
        (document.getElementById("edit-id") as HTMLInputElement).value = item.id;
        (document.getElementById("edit-title") as HTMLInputElement).value = item.title || "";
        (document.getElementById("edit-category") as HTMLInputElement).value = item.category || "";
        (document.getElementById("edit-hashtags") as HTMLInputElement).value = item.hashtags?.join(", ") || "";
        (document.getElementById("edit-description") as HTMLTextAreaElement).value = item.description || "";
        const title = document.getElementById("edit-media-title");
        if (title) title.textContent = `Edit ${item.title || "media item"}`;
        renderEditAssets(item);
        setArchiveView("edit", item.id, updateUrl);
    }

    editForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const editId = (document.getElementById("edit-id") as HTMLInputElement).value;

        if (!editId) return;

        const updatedData = {
            title: (document.getElementById("edit-title") as HTMLInputElement).value,
            category: (document.getElementById("edit-category") as HTMLInputElement).value || "General",
            description: (document.getElementById("edit-description") as HTMLTextAreaElement).value,
            hashtags: (document.getElementById("edit-hashtags") as HTMLInputElement).value
                .split(",")
                .map((h) => h.trim())
                .filter(Boolean),
        };

        const submitButton = document.getElementById("edit-submit-btn") as HTMLButtonElement | null;
        if (submitButton) submitButton.disabled = true;

        try {
            if (stagedEditFiles.length) {
                editUploadProgress?.classList.remove("hidden");
                if (editUploadProgressLabel) editUploadProgressLabel.textContent = `Preparing ${stagedEditFiles.length} file(s)...`;
                if (editUploadProgressPercent) editUploadProgressPercent.textContent = "0%";
                if (editUploadProgressTrack) editUploadProgressTrack.setAttribute("aria-valuenow", "0");
                if (editUploadProgressBar) editUploadProgressBar.style.width = "0%";
                const newAssets: { url: string; publicId: string; type: string }[] = [];
                let completedFiles = 0;
                for (let index = 0; index < stagedEditFiles.length; index++) {
                    const staged = stagedEditFiles[index];
                    const { file } = staged;
                    if (!staged.uploadedAsset) {
                        const isVideo = file.type.startsWith("video/");
                        const targetPath = isVideo ? "archive-media/videos" : "archive-media/photos";
                        const setProgress = (filePercent: number) => {
                            const value = Math.min(Math.round(((completedFiles + filePercent / 100) / stagedEditFiles.length) * 95), 95);
                            if (editUploadProgressLabel) editUploadProgressLabel.textContent = `Uploading file ${index + 1} of ${stagedEditFiles.length}: ${file.name}`;
                            if (editUploadProgressPercent) editUploadProgressPercent.textContent = `${value}%`;
                            if (editUploadProgressTrack) editUploadProgressTrack.setAttribute("aria-valuenow", String(value));
                            if (editUploadProgressBar) editUploadProgressBar.style.width = `${value}%`;
                        };
                        const result = await uploadFileToAzure(file, targetPath, setProgress);
                        staged.uploadedAsset = { url: result.url, publicId: result.publicId, type: isVideo ? "video" : "image" };
                        renderStagedEditFiles();
                    }
                    completedFiles++;
                    const value = Math.min(Math.round((completedFiles / stagedEditFiles.length) * 95), 95);
                    if (editUploadProgressPercent) editUploadProgressPercent.textContent = `${value}%`;
                    if (editUploadProgressTrack) editUploadProgressTrack.setAttribute("aria-valuenow", String(value));
                    if (editUploadProgressBar) editUploadProgressBar.style.width = `${value}%`;
                    newAssets.push(staged.uploadedAsset);
                }

                if (editUploadProgressLabel) editUploadProgressLabel.textContent = "Saving uploaded assets...";
                if (editUploadProgressPercent) editUploadProgressPercent.textContent = "98%";
                if (editUploadProgressTrack) editUploadProgressTrack.setAttribute("aria-valuenow", "98");
                if (editUploadProgressBar) editUploadProgressBar.style.width = "98%";
                const assetsResponse = await fetch(`${API_URL}/media/${editId}/assets`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ assets: newAssets }),
                });
                if (!assetsResponse.ok) throw new Error("Failed to add new files to record.");

                stagedEditFiles.forEach((entry) => URL.revokeObjectURL(entry.previewUrl));
                stagedEditFiles = [];
                renderStagedEditFiles();
                await fetchMediaList();
                const updatedItem = allMediaItems.find((item) => item.id === editId);
                if (updatedItem) renderEditAssets(updatedItem);
            }

            const res = await fetch(`${API_URL}/media/${editId}`, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(updatedData),
            });

            if (!res.ok) throw new Error("Failed to update item.");

            if (!stagedEditFiles.length) {
                // Metadata-only edit has no media upload progress to display.
                editUploadProgress?.classList.add("hidden");
            } else {
                if (editUploadProgressLabel) editUploadProgressLabel.textContent = "Changes saved successfully.";
                if (editUploadProgressPercent) editUploadProgressPercent.textContent = "100%";
                if (editUploadProgressTrack) editUploadProgressTrack.setAttribute("aria-valuenow", "100");
                if (editUploadProgressBar) editUploadProgressBar.style.width = "100%";
            }

            closeEditModal();
            await fetchMediaList();
        } catch (err: any) {
            if (editUploadProgress && !editUploadProgress.classList.contains("hidden") && editUploadProgressLabel) editUploadProgressLabel.textContent = "Upload paused. Resolve the issue and save again to continue.";
            if (editStatus) {
                editStatus.innerText = err.message || "Error updating item.";
                editStatus.className = "text-xs font-mono text-center rounded-lg p-2.5 bg-red-950/80 text-red-400 border border-red-800 block";
            }
        } finally {
            if (submitButton) submitButton.disabled = false;
        }
    });

    async function fetchMediaList() {
        const tableBody = document.getElementById("media-table-body");
        const cardList = document.getElementById("media-card-list");
        if (!tableBody) return;

        try {
            const response = await fetch(`${API_URL}/media?includeArchived=true`);
            if (!response.ok) throw new Error("Failed to load gallery items.");

            allMediaItems = await response.json();
            renderMediaTable();
        } catch (err) {
            tableBody.innerHTML = `
        <tr>
          <td colspan="6" class="py-8 text-center text-red-400 font-mono">Error loading media items. Check server status.</td>
        </tr>`;
            if (cardList) cardList.innerHTML = `<p class="rounded-xl border border-red-900/60 bg-red-950/20 p-4 text-sm text-red-300">Error loading media items. Check server status.</p>`;
        }
    }

    function renderMediaTable() {
        const tableBody = document.getElementById("media-table-body");
        const cardList = document.getElementById("media-card-list");
        if (!tableBody) return;

        const searchQuery = (document.getElementById("search-input") as HTMLInputElement)?.value.toLowerCase().trim() || "";
        const filterType = (document.getElementById("filter-type") as HTMLSelectElement)?.value || "ALL";
        const filterStatus = (document.getElementById("filter-status") as HTMLSelectElement)?.value || "ALL";

        let processedItems = allMediaItems.filter((item) => {
            const assets = item.media || [];
            
            if (filterType === "image" && !assets.some((a: any) => a.type === "image")) return false;
            if (filterType === "video" && !assets.some((a: any) => a.type === "video")) return false;

            if (filterStatus === "ACTIVE" && item.isArchived) return false;
            if (filterStatus === "ARCHIVED" && !item.isArchived) return false;

            if (searchQuery) {
                const matchTitle = item.title?.toLowerCase().includes(searchQuery);
                const matchCategory = item.category?.toLowerCase().includes(searchQuery);
                const matchHashtags = item.hashtags?.some((h: string) => h.toLowerCase().includes(searchQuery));
                if (!matchTitle && !matchCategory && !matchHashtags) return false;
            }

            return true;
        });

        processedItems.sort((a, b) => {
            let valA: any = a[currentSortColumn];
            let valB: any = b[currentSortColumn];

            if (currentSortColumn === "createdAt") {
                valA = new Date(valA || 0).getTime();
                valB = new Date(valB || 0).getTime();
            } else if (currentSortColumn === "title") {
                valA = (valA || "").toString().toLowerCase();
                valB = (valB || "").toString().toLowerCase();
            } else if (currentSortColumn === "isArchived") {
                valA = valA ? 1 : 0;
                valB = valB ? 1 : 0;
            }

            if (valA < valB) return sortDirection === "asc" ? -1 : 1;
            if (valA > valB) return sortDirection === "asc" ? 1 : -1;
            return 0;
        });

        if (!processedItems || processedItems.length === 0) {
            mediaPagination.slice(processedItems);
            tableBody.innerHTML = `
        <tr>
          <td colspan="6" class="py-8 text-center text-zinc-500 font-mono">No matching media items found.</td>
        </tr>`;
            if (cardList) cardList.innerHTML = `<p class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-5 text-center text-sm text-zinc-400">No matching media items found.</p>`;
            return;
        }

        const pageItems = mediaPagination.slice(processedItems);

        const mobileCards: string[] = [];
        tableBody.innerHTML = pageItems
            .map((item: any) => {
                const assets = item.media || [];
                const primaryAsset = assets.find((a: any) => a.isCover) || assets[0];
                const countBadge = assets.length > 1 ? `<span class="bg-orange-500/20 text-orange-400 border border-orange-500/30 text-[10px] px-1.5 py-0.5 rounded font-mono ml-1">${assets.length} items</span>` : '';

                let previewHtml = `<div class="size-24 bg-zinc-800 rounded-lg border border-zinc-700 flex items-center justify-center text-zinc-500 text-[10px] font-mono">EMPTY</div>`;

                if (primaryAsset) {
                    if (primaryAsset.type === "image") {
                        previewHtml = `<img 
              src="${primaryAsset.url}" 
              alt="${item.title}" 
              data-item-id="${item.id}"
              class="preview-thumb size-24 object-cover rounded-lg border border-zinc-800 cursor-pointer hover:opacity-80 hover:border-orange-500 transition-all"
              title="Click to open gallery"
            />`;
                    } else {
                        previewHtml = primaryAsset.thumbnailUrl 
                            ? `<img 
                                src="${primaryAsset.thumbnailUrl}" 
                                alt="${item.title}" 
                                data-item-id="${item.id}"
                                class="preview-thumb size-24 object-cover rounded-lg border border-zinc-800 cursor-pointer hover:opacity-80 hover:border-orange-500 transition-all"
                                title="Click to open gallery"
                               />`
                            : `<div 
                                data-item-id="${item.id}"
                                class="preview-thumb size-24 bg-zinc-800 rounded-lg border border-zinc-700 flex items-center justify-center text-orange-500 font-bold text-xs cursor-pointer hover:border-orange-500 transition-all"
                                title="Click to open gallery"
                               >VIDEO</div>`;
                    }
                }

                const statusBadge = item.isArchived
                    ? `<span class="px-2 py-0.5 text-[10px] font-mono bg-amber-950/60 text-amber-400 border border-amber-900/80 rounded-full">Archived</span>`
                    : `<span class="px-2 py-0.5 text-[10px] font-mono bg-emerald-950/60 text-emerald-400 border border-emerald-900/80 rounded-full">Active</span>`;

                const hashtagsStr = item.hashtags?.length > 0 ? item.hashtags.map((h: string) => `#${h}`).join(" ") : "";

                const createdDate = item.createdAt
                    ? new Date(item.createdAt).toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                      })
                    : "N/A";

                const actionsHtml = `
            <button type="button" data-action="edit" data-id="${item.id}" aria-label="Edit ${item.title}" title="Edit" class="action-btn inline-flex size-10 items-center justify-center rounded-lg bg-zinc-800 text-zinc-200 transition-colors hover:bg-zinc-700"><svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m14 5 5 5M4 20l4.5-1 11-11a2.1 2.1 0 0 0-3-3l-11 11L4 20Z"/></svg></button>
            <button type="button" data-action="archive" data-id="${item.id}" aria-label="${item.isArchived ? "Restore" : "Archive"} ${item.title}" title="${item.isArchived ? "Restore" : "Archive"}" class="action-btn inline-flex size-10 items-center justify-center rounded-lg border border-amber-900/50 bg-amber-950/40 text-amber-300 transition-colors hover:bg-amber-900/60"><svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v13H3zM2 4h20v3H2zM9 11h6"/></svg></button>
            ${isSuperAdmin ? `<button type="button" data-action="delete" data-id="${item.id}" aria-label="Delete ${item.title}" title="Delete" class="action-btn inline-flex size-10 items-center justify-center rounded-lg border border-red-900/50 bg-red-950/40 text-red-300 transition-colors hover:bg-red-900/60"><svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 14h10l1-14M9 7V4h6v3"/></svg></button>` : ""}`;

                mobileCards.push(`
        <article class="rounded-xl border border-zinc-800 bg-zinc-900/70 p-4 text-left shadow-sm">
          <div class="flex min-w-0 items-start gap-3">
            <div class="size-24 shrink-0">${previewHtml}</div>
            <div class="min-w-0 flex-1">
              <div class="flex min-w-0 flex-wrap items-center gap-2">
                <h3 class="min-w-0 break-words text-sm font-bold leading-5 text-white">${item.title}</h3>
                ${countBadge}
              </div>
              <p class="mt-1 break-words text-[11px] font-mono leading-4 text-zinc-400">${item.category || "General"}${hashtagsStr ? ` <span class="px-1 text-zinc-600">·</span> ${hashtagsStr}` : ""}</p>
              ${item.description ? `<p class="mt-2 line-clamp-2 text-xs leading-5 text-zinc-400">${item.description}</p>` : ""}
              <div class="mt-2.5 flex flex-wrap items-center gap-2">
                <span class="text-[11px] font-mono text-zinc-300">${assets.length} ${assets.length === 1 ? "file" : "files"}</span>
                ${statusBadge}
                <time class="text-[11px] font-mono text-zinc-500">${createdDate}</time>
              </div>
            </div>
            <div class="flex h-24 shrink-0 self-center flex-col items-center justify-between gap-1" aria-label="Media actions">${actionsHtml.replaceAll("size-10", "size-7")}</div>
          </div>
        </article>`);

                return `
        <tr class="hover:bg-zinc-800/30 transition-colors">
          <td data-label="Preview" class="py-3 px-4">${previewHtml}</td>
          <td data-label="Title and info" class="py-3 px-4">
            <div class="font-bold text-white">${item.title} ${countBadge}</div>
            <div class="text-[11px] text-zinc-400 font-mono">${item.category || "General"} ${hashtagsStr ? "• " + hashtagsStr : ""}</div>
          </td>
          <td data-label="Assets" class="py-3 px-4 font-mono text-zinc-300 text-xs">
            ${assets.length} file(s)
          </td>
          <td data-label="Status" class="py-3 px-4">${statusBadge}</td>
          <td data-label="Date" class="py-3 px-4 text-zinc-400 font-mono text-xs">${createdDate}</td>
          <td data-label="Actions" class="py-3 px-4 text-right">
            <div class="flex items-center justify-end gap-2">
              ${actionsHtml}
            </div>
          </td>
        </tr>`;
            })
            .join("");

        if (cardList) cardList.innerHTML = mobileCards.join("");

        [tableBody, cardList].forEach((host) => host?.querySelectorAll(".preview-thumb").forEach((thumb) => {
            thumb.addEventListener("click", (e) => {
                const el = e.currentTarget as HTMLElement;
                const itemId = el.dataset.itemId;
                if (!itemId) return;

                const item = allMediaItems.find((m) => m.id === itemId);
                if (item && item.media && item.media.length > 0) {
                    openMediaGallery(item.media, 0, item.title || "");
                }
            });
        }));

        [tableBody, cardList].forEach((host) => host?.querySelectorAll(".action-btn").forEach((btn) => {
            btn.addEventListener("click", async (e) => {
                const el = e.currentTarget as HTMLElement;
                const action = el.dataset.action;
                const id = el.dataset.id;
                if (!id || !action) return;

                if (action === "edit") {
                    const item = allMediaItems.find((m) => m.id === id);
                    if (!item) return;
                    openEditScreen(item);
                } else if (action === "archive") {
                    await fetch(`${API_URL}/media/${id}/archive`, {
                        method: "PATCH",
                    });
                    await fetchMediaList();
                } else if (action === "delete") {
                    if (!confirm("Are you sure you want to permanently delete this media item and all associated cloud files?")) return;
                    await fetch(`${API_URL}/media/${id}`, {
                        method: "DELETE",
                    });
                    await fetchMediaList();
                }
            });
        }));
    }

    async function initializeArchiveView() {
        await fetchMediaList();
        if (requestedEditId) {
            const item = allMediaItems.find((media) => media.id === requestedEditId);
            requestedEditId = null;
            if (item) openEditScreen(item, false);
            else setArchiveView("list", undefined, false);
        }
    }

    void initializeArchiveView();
</script>
