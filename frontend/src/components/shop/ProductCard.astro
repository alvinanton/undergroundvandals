---
// src/components/shop/ProductCard.astro
import type { ProductPublic } from '../../types/ecommerce';

interface Props {
  product: ProductPublic;
}

const { product } = Astro.props;

// Quetzal formatting: "Q" prefix is the convention, not Intl's "GTQ" code
const formattedPrice = `Q${product.price.toFixed(2)}`;
---

<a
  href={`/shop/${product.id}`}
  class="product-card-item bg-zinc-900 rounded-xl overflow-hidden border border-zinc-800 hover:border-orange-500/40 transition-all duration-300 shadow-lg group flex flex-col"
>
  <div class="relative aspect-square w-full overflow-hidden bg-zinc-950">
    {product.thumbnailUrl ? (
      <>
        <img
          src={product.thumbnailUrl}
          alt={product.name}
          loading="lazy"
          class="product-thumb w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="hidden w-full h-full flex-col items-center justify-center bg-zinc-950 p-4 text-center border border-zinc-800/50 absolute inset-0">
          <span class="text-zinc-600 text-xs font-mono">[ IMAGE UNAVAILABLE ]</span>
        </div>
      </>
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center bg-zinc-950 p-4 text-center border border-zinc-800/50">
        <span class="text-zinc-600 text-xs font-mono">[ NO IMAGE ]</span>
      </div>
    )}

    <span class="absolute top-3 right-3 bg-black/60 backdrop-blur-md text-[10px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full text-zinc-300 border border-zinc-700/50 pointer-events-none">
      {product.isDigital ? 'Digital' : 'Physical'}
    </span>
  </div>

  <div class="p-4 flex flex-col grow">
    <h3 class="text-white font-bold text-sm leading-snug line-clamp-2 group-hover:text-orange-400 transition-colors">
      {product.name}
    </h3>

    {product.shortDescription && (
      <p class="text-zinc-400 text-xs mt-1.5 line-clamp-2 leading-relaxed">
        {product.shortDescription}
      </p>
    )}

    <div class="mt-auto pt-3 flex items-center justify-between">
      <span class="text-orange-500 font-black text-base font-mono">
        {formattedPrice}
      </span>
      <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider group-hover:text-orange-400 transition-colors">
        View details →
      </span>
    </div>
  </div>
</a>