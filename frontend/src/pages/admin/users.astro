---
import Layout from "../../layouts/Layout.astro";
import UsersManager from "../../components/admin/UsersManager.astro";

// SSR Verification & Role Guard
if (!Astro.locals.user) {
    return Astro.redirect("/admin/login");
}

const user = Astro.locals.user as { role: string; email: string; name?: string; username?: string };
const isAdmin = user?.role === "Admin";

// Security Check: Redirect non-admin users to main dashboard
if (!isAdmin) {
    return Astro.redirect("/admin");
}

---

<Layout title="Users Management | Underground Vandals">
    <div class="space-y-5 pb-12">
        {/* Header */}
        <div
            class="flex flex-col gap-3 border-b border-zinc-800/80 pb-4"
            id="dashboard-root"
            data-is-admin="true"
        >
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">User management</h1>
                <p class="mt-1 max-w-2xl text-sm text-zinc-400">Manage administrator and editor access.</p>
            </div>
        </div>

        {/* Users Manager Component */}
        <UsersManager isAdmin={true} />
    </div>
</Layout>
