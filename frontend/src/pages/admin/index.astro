---
import Layout from "../../layouts/Layout.astro";

// SSR Check
const token = Astro.cookies.get("uv_auth_token")?.value;
if (!token) {
    return Astro.redirect("/admin/login");
}

const user = Astro.locals.user as { role: string; email: string; name?: string; username?: string };
const isAdmin = user?.role === "Admin";

// Extract username or fallback from email/name safely
const username =
    user?.username ||
    user?.name ||
    (user?.email ? user.email.split("@")[0] : "User");
---

<Layout title="Admin Dashboard | Underground Vandals">
    <div class="space-y-8 max-w-5xl mx-auto pb-12">
        {/* Header with Username */}
        <div
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-800/80 pb-6"
            id="dashboard-root"
            data-is-admin={isAdmin ? "true" : "false"}
        >
            <div>
                <span
                    class="text-xs font-mono bg-zinc-900 border border-zinc-800 px-3 py-1 rounded-full text-orange-500 uppercase tracking-widest inline-block mb-2"
                >
                    Control Panel • {user?.role || "Editor"}
                </span>
                <h1
                    class="text-3xl font-black uppercase tracking-tight text-white"
                >
                    Welcome, <span class="text-orange-500">{username}</span>
                </h1>
            </div>
        </div>

        {/* Navigation Bar */}
        <div
            class="flex flex-wrap items-center justify-between gap-3 bg-zinc-900/80 border border-zinc-800/80 p-2.5 rounded-xl backdrop-blur-md shadow-lg"
        >
            <div class="flex items-center gap-2 overflow-x-auto w-full sm:w-auto">
                {/* 1. Public Gallery */}
                <a
                    href="/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3.5 py-2 bg-zinc-950 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 font-mono text-xs uppercase tracking-wider rounded-lg transition-colors flex items-center gap-2 shrink-0"
                >
                    🌐 View Gallery <span class="text-[10px] text-zinc-500">↗</span>
                </a>

                {/* 2. Content Management (Current Active) */}
                <a
                    href="/admin"
                    class="px-3.5 py-2 bg-orange-500/10 border border-orange-500/40 text-orange-400 font-mono text-xs uppercase tracking-wider rounded-lg flex items-center gap-2 shrink-0 font-bold"
                >
                    📁 Content Management
                </a>

                {/* 3. Users Management (Admin Only) */}
                {
                    isAdmin && (
                        <a
                            href="/admin/users"
                            class="px-3.5 py-2 bg-zinc-950 hover:bg-zinc-800 border border-zinc-800 hover:border-orange-500/30 text-zinc-300 hover:text-orange-400 font-mono text-xs uppercase tracking-wider rounded-lg transition-colors flex items-center gap-2 shrink-0"
                        >
                            👥 Users Management
                        </a>
                    )
                }
            </div>

            {/* Logout Button */}
            <button
                id="logout-btn"
                class="px-4 py-2 bg-zinc-950 hover:bg-red-950/50 border border-zinc-800 hover:border-red-900/60 text-zinc-400 hover:text-red-400 font-mono text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer ml-auto"
            >
                Sign Out
            </button>
        </div>

        {/* Section 1: Upload Form */}
        <div
            class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur-md shadow-xl space-y-6"
        >
            <div>
                <h2
                    class="text-lg font-bold text-white uppercase tracking-wide"
                >
                    Upload New Media
                </h2>
                <p class="text-xs text-zinc-400 mt-0.5">
                    Add photos or videos to the archive.
                </p>
            </div>

            <form id="upload-form" class="space-y-5">
                <div>
                    <label
                        for="title"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2"
                    >
                        Title *
                    </label>
                    <input
                        type="text"
                        id="title"
                        name="title"
                        required
                        class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors text-sm"
                        placeholder="e.g. Street Art Piece #01"
                    />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label
                            for="category"
                            class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2"
                        >
                            Category
                        </label>
                        <input
                            type="text"
                            id="category"
                            name="category"
                            value="General"
                            class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors text-sm"
                            placeholder="e.g. Trains, Walls, General"
                        />
                    </div>

                    <div>
                        <label
                            class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2"
                        >
                            Files (Images / Videos) *
                        </label>
                        <div class="flex items-center gap-3">
                            <input
                                type="file"
                                id="files-input"
                                accept="image/*,video/*"
                                multiple
                                class="hidden"
                            />
                            <button
                                type="button"
                                id="select-files-btn"
                                class="px-4 py-2.5 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-200 font-mono text-xs rounded-lg transition-colors cursor-pointer"
                            >
                                📁 Choose Files
                            </button>
                            <span id="file-count-label" class="text-xs font-mono text-zinc-400">
                                No files selected
                            </span>
                        </div>
                    </div>
                </div>

                {/* Container for Pre-upload Previews */}
                <div id="pre-upload-preview" class="flex flex-wrap gap-3 empty:hidden custom-scrollbar"></div>

                <div>
                    <label
                        for="hashtags"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2"
                    >
                        Hashtags (Comma-separated)
                    </label>
                    <input
                        type="text"
                        id="hashtags"
                        name="hashtags"
                        class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors text-sm"
                        placeholder="graffiti, streetart, vandals"
                    />
                </div>

                <div>
                    <label
                        for="description"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2"
                    >
                        Description (Optional)
                    </label>
                    <textarea
                        id="description"
                        name="description"
                        rows="3"
                        class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors resize-none text-sm"
                        placeholder="Optional details about location, artist, date..."
                    ></textarea>
                </div>

                {/* Status Message Container */}
                <div
                    id="status-message"
                    class="hidden text-xs font-mono text-center rounded-lg p-3"
                >
                </div>

                {/* Live Progress Bar Container */}
                <div id="upload-progress-container" class="hidden space-y-2 pt-2">
                    <div class="flex justify-between text-xs font-mono">
                        <span id="upload-status-text" class="text-orange-400">Preparing upload...</span>
                        <span id="upload-percentage" class="text-zinc-400">0%</span>
                    </div>
                    <div class="w-full bg-zinc-950 rounded-full h-2 overflow-hidden border border-zinc-800">
                        <div id="upload-progress-bar" class="bg-orange-500 h-full w-0 transition-all duration-150 ease-out"></div>
                    </div>
                </div>

                <button
                    type="submit"
                    id="upload-btn"
                    class="w-full py-3.5 px-4 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black uppercase tracking-wider text-xs rounded-lg shadow-lg hover:shadow-orange-500/10 transition-all cursor-pointer disabled:opacity-50"
                >
                    Upload to Gallery
                </button>
            </form>
        </div>

        {/* Section 2: Media Management List */}
        <div
            class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur-md shadow-xl space-y-6"
        >
            <div
                class="flex items-center justify-between border-b border-zinc-800/80 pb-4"
            >
                <div>
                    <h2
                        class="text-lg font-bold text-white uppercase tracking-wide"
                    >
                        Manage Gallery Media
                    </h2>
                    <p class="text-xs text-zinc-400 mt-0.5">
                        View, edit, archive, or permanently delete gallery items
                    </p>
                </div>
                <button
                    id="refresh-btn"
                    class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-mono text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer disabled:opacity-50"
                >
                    ↻ Refresh
                </button>
            </div>

            {/* Search & Filters Bar */}
            <div
                class="grid grid-cols-1 sm:grid-cols-4 gap-3 bg-zinc-950/50 p-3 rounded-xl border border-zinc-800/60"
            >
                <div class="sm:col-span-2">
                    <input
                        type="text"
                        id="search-input"
                        placeholder="Search title, category, hashtag..."
                        class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 placeholder-zinc-500 text-xs focus:outline-none focus:border-orange-500 font-mono"
                    />
                </div>
                <div>
                    <select
                        id="filter-type"
                        class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 text-xs focus:outline-none focus:border-orange-500 font-mono cursor-pointer"
                    >
                        <option value="ALL">All Media Types</option>
                        <option value="image">Has Images</option>
                        <option value="video">Has Videos</option>
                    </select>
                </div>
                <div>
                    <select
                        id="filter-status"
                        class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 text-xs focus:outline-none focus:border-orange-500 font-mono cursor-pointer"
                    >
                        <option value="ALL">All Statuses</option>
                        <option value="ACTIVE">Active</option>
                        <option value="ARCHIVED">Archived</option>
                    </select>
                </div>
            </div>

            {/* Media Table Container */}
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr
                            class="border-b border-zinc-800 text-[11px] font-mono uppercase tracking-wider text-zinc-400 select-none"
                        >
                            <th class="py-3 px-4">Preview</th>
                            <th
                                class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header"
                                data-sort="title"
                            >
                                Title & Info <span
                                    class="sort-icon inline-block ml-1 opacity-40"
                                    >↕</span
                                >
                            </th>
                            <th class="py-3 px-4">Assets Count</th>
                            <th
                                class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header"
                                data-sort="isArchived"
                            >
                                Status <span
                                    class="sort-icon inline-block ml-1 opacity-40"
                                    >↕</span
                                >
                            </th>
                            <th
                                class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header text-orange-500"
                                data-sort="createdAt"
                            >
                                Date <span
                                    class="sort-icon inline-block ml-1 opacity-100"
                                    >↓</span
                                >
                            </th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody
                        id="media-table-body"
                        class="divide-y divide-zinc-800/50 text-xs"
                    >
                        <tr>
                            <td
                                colspan="6"
                                class="py-8 text-center text-zinc-500 font-mono"
                                >Loading media items...</td
                            >
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {/* Pre-Upload File Preview Modal */}
    <div
        id="pre-upload-modal"
        class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex flex-col items-center justify-center p-4"
    >
        <div
            class="relative max-w-4xl max-h-[90vh] w-full flex flex-col items-center gap-4"
        >
            <button
                id="pre-upload-modal-close"
                class="absolute -top-12 right-0 text-zinc-300 hover:text-orange-500 text-xs font-mono uppercase tracking-wider bg-zinc-900 border border-zinc-800 px-3 py-1.5 rounded-lg cursor-pointer transition-colors"
            >
                ✕ Close
            </button>
            <div id="pre-upload-modal-media-container" class="w-full flex justify-center items-center">
                <img
                    id="pre-upload-modal-img"
                    src=""
                    alt=""
                    class="max-w-full max-h-[75vh] object-contain rounded-xl shadow-2xl border border-zinc-800/80 hidden"
                />
                <video
                    id="pre-upload-modal-video"
                    controls
                    class="max-w-full max-h-[75vh] rounded-xl shadow-2xl border border-zinc-800/80 hidden"
                ></video>
            </div>
            <div class="flex flex-wrap items-center justify-between w-full max-w-lg bg-zinc-900/90 border border-zinc-800 p-3 rounded-xl gap-3">
                <p
                    id="pre-upload-modal-filename"
                    class="text-zinc-300 font-mono text-xs uppercase tracking-wider truncate max-w-[250px]"
                >
                </p>
                <button
                    type="button"
                    id="pre-upload-modal-discard-btn"
                    class="px-3.5 py-1.5 bg-red-950/60 hover:bg-red-900/80 border border-red-800/80 text-red-400 hover:text-red-300 font-mono text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer flex items-center gap-1.5 ml-auto"
                >
                    ✕ Discard File
                </button>
            </div>
        </div>
    </div>

    {/* Full Image/Media Preview Carousel Modal */}
    <div
        id="image-modal"
        class="fixed inset-0 bg-black/80 backdrop-blur-md z-[60] hidden flex flex-col items-center justify-center p-4"
    >
        <div
            class="relative max-w-4xl max-h-[90vh] w-full flex flex-col items-center justify-center"
        >
            <button
                id="modal-close-btn"
                class="absolute -top-12 right-0 text-zinc-300 hover:text-orange-500 text-xs font-mono uppercase tracking-wider bg-zinc-900 border border-zinc-800 px-3 py-1.5 rounded-lg cursor-pointer transition-colors z-20"
            >
                ✕ Close
            </button>

            {/* Previous Carousel Button */}
            <button
                id="modal-prev-btn"
                class="absolute left-2 top-1/2 -translate-y-1/2 z-20 bg-zinc-900/80 hover:bg-zinc-800 text-zinc-200 hover:text-orange-500 border border-zinc-800/80 w-10 h-10 rounded-full flex items-center justify-center transition-colors cursor-pointer select-none"
                title="Previous item"
            >
                ❮
            </button>

            {/* Next Carousel Button */}
            <button
                id="modal-next-btn"
                class="absolute right-2 top-1/2 -translate-y-1/2 z-20 bg-zinc-900/80 hover:bg-zinc-800 text-zinc-200 hover:text-orange-500 border border-zinc-800/80 w-10 h-10 rounded-full flex items-center justify-center transition-colors cursor-pointer select-none"
                title="Next item"
            >
                ❯
            </button>

            <div id="modal-media-container" class="w-full flex justify-center items-center">
                <img
                    id="modal-img"
                    src=""
                    alt=""
                    class="max-w-full max-h-[75vh] object-contain rounded-xl shadow-2xl border border-zinc-800/80 hidden"
                />
                <video
                    id="modal-video"
                    controls
                    class="max-w-full max-h-[75vh] rounded-xl shadow-2xl border border-zinc-800/80 hidden"
                ></video>
            </div>

            <div class="flex items-center justify-between w-full max-w-lg mt-3 px-2">
                <p
                    id="modal-title"
                    class="text-zinc-300 font-mono text-xs uppercase tracking-wider truncate"
                >
                </p>
                <span
                    id="modal-counter"
                    class="text-orange-500 font-mono text-xs uppercase tracking-wider bg-zinc-900 border border-zinc-800 px-2.5 py-1 rounded-md shrink-0 ml-3"
                >
                    1 / 1
                </span>
            </div>
        </div>
    </div>

    {/* Edit Media Modal */}
    <div
        id="edit-modal"
        class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4"
    >
        <div
            class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 sm:p-8 max-w-lg w-full space-y-5 shadow-2xl relative max-h-[90vh] overflow-y-auto custom-scrollbar"
        >
            <div
                class="flex justify-between items-center border-b border-zinc-800/80 pb-4"
            >
                <div>
                    <h3
                        class="text-base font-bold text-white uppercase tracking-wide"
                    >
                        Edit Media Item
                    </h3>
                    <p class="text-xs text-zinc-400">
                        Update metadata or manage assets for this post
                    </p>
                </div>
                <button
                    id="edit-modal-close"
                    class="text-zinc-400 hover:text-orange-500 font-mono text-sm cursor-pointer transition-colors"
                    >✕</button
                >
            </div>

            <form id="edit-form" class="space-y-4">
                <input type="hidden" id="edit-id" />

                <div>
                    <label
                        for="edit-title"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5"
                        >Title *</label
                    >
                    <input
                        type="text"
                        id="edit-title"
                        required
                        class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500"
                    />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label
                            for="edit-category"
                            class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5"
                            >Category</label
                        >
                        <input
                            type="text"
                            id="edit-category"
                            class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500"
                        />
                    </div>

                    <div>
                        <label
                            for="edit-hashtags"
                            class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5"
                            >Hashtags (Comma-separated)</label
                        >
                        <input
                            type="text"
                            id="edit-hashtags"
                            class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500"
                        />
                    </div>
                </div>

                <div>
                    <label
                        for="edit-description"
                        class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5"
                        >Description</label
                    >
                    <textarea
                        id="edit-description"
                        rows="3"
                        class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500 resize-none custom-scrollbar"
                    ></textarea>
                </div>

                {/* Manage Assets Section inside Edit Modal */}
                <div class="border-t border-zinc-800/80 pt-4 space-y-3">
                    <label class="block text-xs font-mono uppercase tracking-wider text-zinc-300">
                        Current Assets
                    </label>
                    <div id="edit-assets-list" class="flex flex-wrap gap-2 max-h-40 overflow-y-auto p-2 bg-zinc-950/60 rounded-lg border border-zinc-800/80 custom-scrollbar">
                        <!-- Dynamic assets thumbnails render here -->
                    </div>

                    <div>
                        <label class="block text-[11px] font-mono text-zinc-400 mb-1.5">
                            Add More Files to this Media Item (Direct Cloud Upload):
                        </label>
                        <div class="flex items-center gap-2">
                            <input
                                type="file"
                                id="add-more-files-input"
                                accept="image/*,video/*"
                                multiple
                                class="text-xs text-zinc-400 file:mr-2 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-xs file:font-mono file:bg-zinc-800 file:text-zinc-200 cursor-pointer"
                            />
                            <button
                                type="button"
                                id="add-files-btn"
                                class="px-3 py-1.5 bg-orange-500/20 hover:bg-orange-500/30 text-orange-400 border border-orange-500/30 font-mono text-xs rounded transition-colors cursor-pointer shrink-0"
                            >
                                + Upload
                            </button>
                        </div>
                    </div>
                </div>

                <div
                    id="edit-status"
                    class="hidden text-xs font-mono text-center rounded-lg p-2.5"
                >
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button
                        type="button"
                        id="edit-cancel-btn"
                        class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-mono text-xs uppercase rounded-lg transition-colors cursor-pointer"
                        >Cancel</button
                    >
                    <button
                        type="submit"
                        id="edit-submit-btn"
                        class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black font-mono text-xs uppercase rounded-lg transition-colors cursor-pointer"
                        >Save Changes</button
                    >
                </div>
            </form>
        </div>
    </div>
</Layout>

<style>
    /* Custom Dark Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #09090b;
        border-radius: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #27272a;
        border-radius: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #3f3f46;
    }
    .custom-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: #27272a #09090b;
    }
</style>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:5098";

    // Minimal SVGs for file types
    const PHOTO_ICON_SVG = `<svg class="w-2.5 h-2.5 text-orange-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;
    const PLAY_ICON_SVG = `<svg class="w-2.5 h-2.5 text-orange-400 fill-current ml-0.5" viewBox="0 0 24 24"><polygon points="6,4 20,12 6,20"/></svg>`;

    // Client Role Check
    const isAdmin =
        document.getElementById("dashboard-root")?.dataset.isAdmin === "true";

    // State
    let allMediaItems: any[] = [];
    let currentSortColumn: string = "createdAt";
    let sortDirection: "asc" | "desc" = "desc";
    let selectedUploadFiles: File[] = [];
    let activePreUploadIndex: number = -1;

    // Gallery Carousel State
    let currentGalleryAssets: any[] = [];
    let currentGalleryIndex: number = 0;
    let currentGalleryTitle: string = "";

    // Helper to extract JWT Token from cookies
    function getToken(): string | undefined {
        return document.cookie
            .split("; ")
            .find((row) => row.startsWith("uv_auth_token="))
            ?.split("=")[1];
    }

    // Handle Logout
    document.getElementById("logout-btn")?.addEventListener("click", () => {
        document.cookie = "uv_auth_token=; path=/; max-age=0;";
        window.location.href = "/admin/login";
    });

    // --- FILE PRE-UPLOAD PREVIEW SYSTEM ---
    const filesInput = document.getElementById("files-input") as HTMLInputElement;
    const selectFilesBtn = document.getElementById("select-files-btn");
    const fileCountLabel = document.getElementById("file-count-label");
    const preUploadPreviewContainer = document.getElementById("pre-upload-preview");

    // Pre-Upload Modal Elements
    const preUploadModal = document.getElementById("pre-upload-modal");
    const preUploadModalImg = document.getElementById("pre-upload-modal-img") as HTMLImageElement;
    const preUploadModalVideo = document.getElementById("pre-upload-modal-video") as HTMLVideoElement;
    const preUploadModalFilename = document.getElementById("pre-upload-modal-filename");
    const preUploadModalCloseBtn = document.getElementById("pre-upload-modal-close");
    const preUploadModalDiscardBtn = document.getElementById("pre-upload-modal-discard-btn");

    selectFilesBtn?.addEventListener("click", () => filesInput?.click());

    filesInput?.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files.length > 0) {
            const newFiles = Array.from(target.files);
            selectedUploadFiles = [...selectedUploadFiles, ...newFiles];
            target.value = ""; // Clear native input
            renderPreUploadPreviews();
        }
    });

    function renderPreUploadPreviews() {
        if (!preUploadPreviewContainer || !fileCountLabel) return;

        fileCountLabel.innerText = selectedUploadFiles.length > 0
            ? `${selectedUploadFiles.length} file(s) selected`
            : "No files selected";

        preUploadPreviewContainer.innerHTML = selectedUploadFiles
            .map((file, index) => {
                const tempUrl = URL.createObjectURL(file);
                const isVideo = file.type.startsWith("video/");
                const fileTypeIcon = isVideo ? PLAY_ICON_SVG : PHOTO_ICON_SVG;

                return `
                <div 
                    data-file-index="${index}"
                    class="pre-upload-thumb relative group w-20 h-20 rounded-lg border border-zinc-800 overflow-hidden bg-black flex items-center justify-center cursor-pointer hover:border-orange-500/60 transition-all"
                    title="Click to preview file"
                >
                    ${
                        isVideo
                            ? `<video src="${tempUrl}" class="w-full h-full object-cover pointer-events-none"></video>`
                            : `<img src="${tempUrl}" class="w-full h-full object-cover pointer-events-none" />`
                    }
                    <span
                        class="absolute top-1 left-1 bg-zinc-950/80 border border-zinc-800/80 rounded-md w-5 h-5 flex items-center justify-center shadow-md z-10 pointer-events-none select-none"
                        title="${isVideo ? "Video file" : "Image file"}"
                    >
                        ${fileTypeIcon}
                    </span>

                    <button
                        type="button"
                        data-remove-index="${index}"
                        class="remove-file-btn absolute top-1 right-1 bg-zinc-950/80 hover:bg-zinc-950 text-zinc-400 hover:text-orange-500 border border-zinc-800/80 rounded-md w-5 h-5 flex items-center justify-center text-[10px] font-mono transition-colors cursor-pointer shadow-md z-10"
                        title="Remove file"
                    >
                        ✕
                    </button>
                </div>
            `;
            })
            .join("");

        // Attach delete events to pre-upload items
        preUploadPreviewContainer.querySelectorAll(".remove-file-btn").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation(); // Prevent opening modal
                const index = parseInt((e.currentTarget as HTMLElement).dataset.removeIndex || "-1");
                if (index > -1) {
                    selectedUploadFiles.splice(index, 1);
                    renderPreUploadPreviews();
                }
            });
        });

        // Attach click event to thumbnails for full preview
        preUploadPreviewContainer.querySelectorAll(".pre-upload-thumb").forEach((thumb) => {
            thumb.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;
                if (target.closest(".remove-file-btn")) return;
                const index = parseInt((e.currentTarget as HTMLElement).dataset.fileIndex || "-1");
                if (index > -1) openPreUploadModal(index);
            });
        });
    }

    // Modal logic for Pre-Upload files
    function openPreUploadModal(index: number) {
        if (!preUploadModal || index < 0 || index >= selectedUploadFiles.length) return;
        
        activePreUploadIndex = index;
        const file = selectedUploadFiles[index];
        const tempUrl = URL.createObjectURL(file);
        const isVideo = file.type.startsWith("video/");

        if (isVideo) {
            if (preUploadModalImg) preUploadModalImg.classList.add("hidden");
            if (preUploadModalVideo) {
                preUploadModalVideo.src = tempUrl;
                preUploadModalVideo.classList.remove("hidden");
            }
        } else {
            if (preUploadModalVideo) {
                preUploadModalVideo.pause();
                preUploadModalVideo.classList.add("hidden");
            }
            if (preUploadModalImg) {
                preUploadModalImg.src = tempUrl;
                preUploadModalImg.classList.remove("hidden");
            }
        }

        if (preUploadModalFilename) {
            preUploadModalFilename.innerText = file.name;
        }

        preUploadModal.classList.remove("hidden");
    }

    function closePreUploadModal() {
        if (preUploadModal) preUploadModal.classList.add("hidden");
        if (preUploadModalVideo) preUploadModalVideo.pause();
        activePreUploadIndex = -1;
    }

    preUploadModalCloseBtn?.addEventListener("click", closePreUploadModal);
    
    preUploadModal?.addEventListener("click", (e) => {
        if (e.target === preUploadModal) closePreUploadModal();
    });

    preUploadModalDiscardBtn?.addEventListener("click", () => {
        if (activePreUploadIndex > -1 && activePreUploadIndex < selectedUploadFiles.length) {
            selectedUploadFiles.splice(activePreUploadIndex, 1);
            renderPreUploadPreviews();
            closePreUploadModal();
        }
    });

    // --- HANDLE UPLOAD FORM SUBMIT (DIRECT-TO-CLOUD WITH LIVE PROGRESS BAR) ---
    const uploadForm = document.getElementById("upload-form") as HTMLFormElement;
    const uploadBtn = document.getElementById("upload-btn") as HTMLButtonElement;
    const statusMsg = document.getElementById("status-message") as HTMLDivElement;
    
    const progressContainer = document.getElementById("upload-progress-container");
    const progressBar = document.getElementById("upload-progress-bar");
    const progressPercentage = document.getElementById("upload-percentage");
    const statusText = document.getElementById("upload-status-text");

    uploadForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!uploadBtn) return;

        if (selectedUploadFiles.length === 0) {
            showStatus("Please select at least one image or video file.", "error");
            return;
        }

        const token = getToken();
        if (!token) {
            showStatus("Authentication token missing. Please sign in again.", "error");
            return;
        }

        uploadBtn.disabled = true;
        uploadBtn.innerText = "Processing Direct Upload...";
        statusMsg.classList.add("hidden");
        progressContainer?.classList.remove("hidden");

        const titleVal = (document.getElementById("title") as HTMLInputElement).value;
        const categoryVal = (document.getElementById("category") as HTMLInputElement).value;
        const hashtagsVal = (document.getElementById("hashtags") as HTMLInputElement).value;
        const descriptionVal = (document.getElementById("description") as HTMLInputElement).value;

        const hashtagsArray = hashtagsVal
            ? hashtagsVal.split(",").map((t) => t.trim()).filter(Boolean)
            : [];

        try {
            const uploadedAssets: { url: string; publicId: string; type: string }[] = [];
            const totalFiles = selectedUploadFiles.length;

            for (let i = 0; i < totalFiles; i++) {
                const file = selectedUploadFiles[i];
                const isVideo = file.type.startsWith("video/");
                const folder = isVideo ? "underground_vandals/videos" : "underground_vandals/photos";

                if (statusText) statusText.innerText = `Authorizing file ${i + 1} of ${totalFiles}...`;
                if (progressBar) progressBar.style.width = `${Math.round(((i) / totalFiles) * 30)}%`;
                if (progressPercentage) progressPercentage.innerText = `${Math.round(((i) / totalFiles) * 30)}%`;

                // 1. Fetch secure signature from ASP.NET Core backend
                const sigRes = await fetch(`${API_URL}/api/media/upload-signature?folder=${folder}`, {
                    method: "GET",
                    headers: { Authorization: `Bearer ${token}` },
                });

                if (!sigRes.ok) throw new Error("Failed to obtain upload authorization signature.");
                const sigData = await sigRes.json();

                if (statusText) statusText.innerText = `Uploading ${file.name} directly to Cloudinary...`;

                // 2. Upload file directly to Cloudinary using XMLHttpRequest for real-time progress
                const formData = new FormData();
                formData.append("file", file);
                formData.append("api_key", sigData.apiKey);
                formData.append("timestamp", sigData.timestamp.toString());
                formData.append("signature", sigData.signature);
                formData.append("folder", sigData.folder);

                const resourceType = isVideo ? "video" : "image";
                const cloudinaryUrl = `https://api.cloudinary.com/v1_1/${sigData.cloudName}/${resourceType}/upload`;

                const cloudData: any = await new Promise((resolve, reject) => {
                    const xhr = new XMLHttpRequest();
                    xhr.open("POST", cloudinaryUrl, true);

                    xhr.upload.onprogress = (event) => {
                        if (event.lengthComputable) {
                            const fileProgress = (event.loaded / event.total) * (70 / totalFiles);
                            const baseProgress = (i / totalFiles) * 70;
                            const totalProgress = Math.min(Math.round(baseProgress + fileProgress + 30), 95);

                            if (progressBar) progressBar.style.width = `${totalProgress}%`;
                            if (progressPercentage) progressPercentage.innerText = `${totalProgress}%`;
                        }
                    };

                    xhr.onload = () => {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            resolve(JSON.parse(xhr.responseText));
                        } else {
                            try {
                                const errJson = JSON.parse(xhr.responseText);
                                reject(new Error(errJson.error?.message || "Cloudinary upload error"));
                            } catch {
                                reject(new Error("Cloudinary upload failed with status " + xhr.status));
                            }
                        }
                    };

                    xhr.onerror = () => reject(new Error("Network error during direct cloud upload."));
                    xhr.send(formData);
                });

                uploadedAssets.push({
                    url: cloudData.secure_url,
                    publicId: cloudData.public_id,
                    type: isVideo ? "video" : "image",
                });
            }

            if (statusText) statusText.innerText = "Registering record in database...";
            if (progressBar) progressBar.style.width = "98%";
            if (progressPercentage) progressPercentage.innerText = "98%";

            // 3. Send lightweight JSON metadata payload back to ASP.NET Core backend
            const finalPayload = {
                title: titleVal,
                description: descriptionVal || "",
                category: categoryVal || "General",
                hashtags: hashtagsArray,
                assets: uploadedAssets,
            };

            const finalRes = await fetch(`${API_URL}/api/media/upload`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify(finalPayload),
            });

            const responseData = await finalRes.json();
            if (!finalRes.ok) throw new Error(responseData.message || "Failed to register media item.");

            if (progressBar) progressBar.style.width = "100%";
            if (progressPercentage) progressPercentage.innerText = "100%";
            if (statusText) statusText.innerText = "Upload completed successfully!";

            showStatus("Files uploaded and registered successfully!", "success");
            uploadForm.reset();
            selectedUploadFiles = [];
            renderPreUploadPreviews();
            await fetchMediaList();

            setTimeout(() => {
                progressContainer?.classList.add("hidden");
            }, 2000);

        } catch (err: any) {
            showStatus(err.message || "An error occurred during upload.", "error");
            progressContainer?.classList.add("hidden");
        } finally {
            uploadBtn.disabled = false;
            uploadBtn.innerText = "Upload to Gallery";
        }
    });

    function showStatus(msg: string, type: "success" | "error") {
        if (!statusMsg) return;
        statusMsg.innerText = msg;
        statusMsg.classList.remove("hidden");
        if (type === "success") {
            statusMsg.className = "text-xs font-mono text-center rounded-lg p-3 bg-emerald-950/80 text-emerald-400 border border-emerald-800";
        } else {
            statusMsg.className = "text-xs font-mono text-center rounded-lg p-3 bg-red-950/80 text-red-400 border border-red-800";
        }
    }

    // Handle Refresh Button
    const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement;
    refreshBtn?.addEventListener("click", async () => {
        refreshBtn.disabled = true;
        refreshBtn.innerText = "↻ Refreshing...";
        await fetchMediaList();
        refreshBtn.innerText = "↻ Refresh";
        refreshBtn.disabled = false;
    });

    // Filter & Search Event Listeners
    document.getElementById("search-input")?.addEventListener("input", renderMediaTable);
    document.getElementById("filter-type")?.addEventListener("change", renderMediaTable);
    document.getElementById("filter-status")?.addEventListener("change", renderMediaTable);

    // Sorting Event Listeners
    document.querySelectorAll(".sort-header").forEach((header) => {
        header.addEventListener("click", (e) => {
            const target = e.currentTarget as HTMLElement;
            const column = target.getAttribute("data-sort");
            if (!column) return;

            if (currentSortColumn === column) {
                sortDirection = sortDirection === "asc" ? "desc" : "asc";
            } else {
                currentSortColumn = column;
                sortDirection = column === "createdAt" ? "desc" : "asc";
            }

            updateSortHeadersUI();
            renderMediaTable();
        });
    });

    function updateSortHeadersUI() {
        document.querySelectorAll(".sort-header").forEach((header) => {
            const el = header as HTMLElement;
            const column = el.getAttribute("data-sort");
            const iconSpan = el.querySelector(".sort-icon") as HTMLElement;

            if (column === currentSortColumn) {
                el.classList.add("text-orange-500");
                el.classList.remove("text-zinc-400");
                if (iconSpan) {
                    iconSpan.innerText = sortDirection === "asc" ? "↑" : "↓";
                    iconSpan.classList.add("opacity-100");
                    iconSpan.classList.remove("opacity-40");
                }
            } else {
                el.classList.remove("text-orange-500");
                el.classList.add("text-zinc-400");
                if (iconSpan) {
                    iconSpan.innerText = "↕";
                    iconSpan.classList.add("opacity-40");
                    iconSpan.classList.remove("opacity-100");
                }
            }
        });
    }

    // Media Gallery Carousel Modal Controls
    const imageModal = document.getElementById("image-modal");
    const modalImg = document.getElementById("modal-img") as HTMLImageElement;
    const modalVideo = document.getElementById("modal-video") as HTMLVideoElement;
    const modalTitle = document.getElementById("modal-title");
    const modalCounter = document.getElementById("modal-counter");
    const modalCloseBtn = document.getElementById("modal-close-btn");
    const modalPrevBtn = document.getElementById("modal-prev-btn");
    const modalNextBtn = document.getElementById("modal-next-btn");

    function openMediaGallery(assets: any[], initialIndex: number = 0, title: string = "") {
        if (!imageModal || !assets || assets.length === 0) return;

        currentGalleryAssets = assets;
        currentGalleryIndex = initialIndex;
        currentGalleryTitle = title;

        updateGalleryView();
        imageModal.classList.remove("hidden");
    }

    function updateGalleryView() {
        if (currentGalleryAssets.length === 0) return;

        const currentAsset = currentGalleryAssets[currentGalleryIndex];
        if (!currentAsset) return;

        const isVideo = currentAsset.type === "video";

        if (isVideo) {
            if (modalImg) modalImg.classList.add("hidden");
            if (modalVideo) {
                modalVideo.src = currentAsset.url;
                modalVideo.classList.remove("hidden");
            }
        } else {
            if (modalVideo) {
                modalVideo.pause();
                modalVideo.classList.add("hidden");
            }
            if (modalImg) {
                modalImg.src = currentAsset.url;
                modalImg.classList.remove("hidden");
            }
        }

        if (modalTitle) modalTitle.innerText = currentGalleryTitle;
        if (modalCounter) {
            modalCounter.innerText = `${currentGalleryIndex + 1} / ${currentGalleryAssets.length}`;
        }

        const hasMultiple = currentGalleryAssets.length > 1;
        if (modalPrevBtn) modalPrevBtn.style.display = hasMultiple ? "flex" : "none";
        if (modalNextBtn) modalNextBtn.style.display = hasMultiple ? "flex" : "none";
    }

    function prevGalleryItem() {
        if (currentGalleryAssets.length <= 1) return;
        currentGalleryIndex = (currentGalleryIndex - 1 + currentGalleryAssets.length) % currentGalleryAssets.length;
        updateGalleryView();
    }

    function nextGalleryItem() {
        if (currentGalleryAssets.length <= 1) return;
        currentGalleryIndex = (currentGalleryIndex + 1) % currentGalleryAssets.length;
        updateGalleryView();
    }

    function closeImageModal() {
        if (imageModal) imageModal.classList.add("hidden");
        if (modalVideo) modalVideo.pause();
        currentGalleryAssets = [];
        currentGalleryIndex = 0;
        currentGalleryTitle = "";
    }

    modalPrevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        prevGalleryItem();
    });

    modalNextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        nextGalleryItem();
    });

    modalCloseBtn?.addEventListener("click", closeImageModal);
    imageModal?.addEventListener("click", (e) => {
        if (e.target === imageModal) closeImageModal();
    });

    // Edit Modal Controls & Asset Management
    const editModal = document.getElementById("edit-modal");
    const editModalCloseBtn = document.getElementById("edit-modal-close");
    const editCancelBtn = document.getElementById("edit-cancel-btn");
    const editForm = document.getElementById("edit-form") as HTMLFormElement;
    const editStatus = document.getElementById("edit-status") as HTMLDivElement;
    const editAssetsList = document.getElementById("edit-assets-list");
    const addMoreFilesInput = document.getElementById("add-more-files-input") as HTMLInputElement;
    const addFilesBtn = document.getElementById("add-files-btn");

    function closeEditModal() {
        if (editModal) editModal.classList.add("hidden");
        if (editStatus) editStatus.className = "hidden text-xs font-mono text-center rounded-lg p-2.5";
        if (addMoreFilesInput) addMoreFilesInput.value = "";
    }

    editModalCloseBtn?.addEventListener("click", closeEditModal);
    editCancelBtn?.addEventListener("click", closeEditModal);

    editModal?.addEventListener("click", (e) => {
        if (e.target === editModal) closeEditModal();
    });

    window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            closeImageModal();
            closeEditModal();
            closePreUploadModal();
        }
        if (imageModal && !imageModal.classList.contains("hidden")) {
            if (e.key === "ArrowLeft") prevGalleryItem();
            if (e.key === "ArrowRight") nextGalleryItem();
        }
    });

    // Render Assets inside Edit Modal
    function renderEditAssets(item: any) {
        if (!editAssetsList) return;
        const assets = item.media || [];

        if (assets.length === 0) {
            editAssetsList.innerHTML = `<span class="text-xs text-zinc-500 font-mono py-1">No assets attached.</span>`;
            return;
        }

        editAssetsList.innerHTML = assets
            .map((asset: any) => {
                const isVideo = asset.type === "video";
                const fileTypeIcon = isVideo ? PLAY_ICON_SVG : PHOTO_ICON_SVG;

                return `
                <div 
                    data-asset-url="${asset.url}"
                    data-asset-type="${asset.type}"
                    class="edit-asset-thumb relative group w-20 h-20 rounded-lg border border-zinc-800 overflow-hidden bg-black flex items-center justify-center cursor-pointer hover:border-orange-500/60 transition-all shrink-0"
                    title="Click to preview file"
                >
                    ${
                        isVideo
                            ? `<video src="${asset.url}#t=0.1" class="w-full h-full object-cover pointer-events-none"></video>`
                            : `<img src="${asset.url}" class="w-full h-full object-cover pointer-events-none" />`
                    }
                    <span
                        class="absolute top-1 left-1 bg-zinc-950/80 border border-zinc-800/80 rounded-md w-5 h-5 flex items-center justify-center shadow-md z-10 pointer-events-none select-none"
                        title="${isVideo ? "Video file" : "Image file"}"
                    >
                        ${fileTypeIcon}
                    </span>

                    <button
                        type="button"
                        data-asset-id="${asset.id}"
                        data-item-id="${item.id}"
                        class="delete-asset-btn absolute top-1 right-1 bg-zinc-950/80 hover:bg-zinc-950 text-zinc-400 hover:text-orange-500 border border-zinc-800/80 rounded-md w-5 h-5 flex items-center justify-center text-[10px] font-mono transition-colors cursor-pointer shadow-md z-10"
                        title="Delete asset"
                    >
                        ✕
                    </button>
                </div>
            `;
            })
            .join("");

        editAssetsList.querySelectorAll(".edit-asset-thumb").forEach((thumb, index) => {
            thumb.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;
                if (target.closest(".delete-asset-btn")) return;
                if (assets && assets.length > 0) {
                    openMediaGallery(assets, index, item.title || "");
                }
            });
        });

        editAssetsList.querySelectorAll(".delete-asset-btn").forEach((btn) => {
            btn.addEventListener("click", async (e) => {
                e.stopPropagation();
                const el = e.currentTarget as HTMLElement;
                const assetId = el.dataset.assetId;
                const itemId = el.dataset.itemId;
                if (!assetId || !confirm("Delete this file permanently?")) return;

                const token = getToken();
                if (!token) return;

                try {
                    const res = await fetch(`${API_URL}/api/media/assets/${assetId}`, {
                        method: "DELETE",
                        headers: { Authorization: `Bearer ${token}` },
                    });

                    if (!res.ok) throw new Error("Failed to delete asset.");

                    await fetchMediaList();
                    const updatedItem = allMediaItems.find((m) => m.id === itemId);
                    if (updatedItem) renderEditAssets(updatedItem);
                } catch (err: any) {
                    alert(err.message || "Error deleting asset.");
                }
            });
        });
    }

    // Add Additional Files to Existing Item Handler (Direct Cloud Upload Integration)
    addFilesBtn?.addEventListener("click", async () => {
        const editId = (document.getElementById("edit-id") as HTMLInputElement).value;
        const files = addMoreFilesInput?.files;
        const token = getToken();

        if (!editId || !files || files.length === 0 || !token) {
            alert("Select at least one file to upload.");
            return;
        }

        try {
            const newAssets: { url: string; publicId: string; type: string }[] = [];

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const isVideo = file.type.startsWith("video/");
                const folder = isVideo ? "underground_vandals/videos" : "underground_vandals/photos";

                const sigRes = await fetch(`${API_URL}/api/media/upload-signature?folder=${folder}`, {
                    method: "GET",
                    headers: { Authorization: `Bearer ${token}` },
                });

                if (!sigRes.ok) throw new Error("Failed to obtain upload signature.");
                const sigData = await sigRes.json();

                const formData = new FormData();
                formData.append("file", file);
                formData.append("api_key", sigData.apiKey);
                formData.append("timestamp", sigData.timestamp.toString());
                formData.append("signature", sigData.signature);
                formData.append("folder", sigData.folder);

                const resourceType = isVideo ? "video" : "image";
                const cloudinaryUrl = `https://api.cloudinary.com/v1_1/${sigData.cloudName}/${resourceType}/upload`;

                const cloudData: any = await new Promise((resolve, reject) => {
                    const xhr = new XMLHttpRequest();
                    xhr.open("POST", cloudinaryUrl, true);
                    xhr.onload = () => {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            resolve(JSON.parse(xhr.responseText));
                        } else {
                            reject(new Error("Cloudinary upload failed"));
                        }
                    };
                    xhr.onerror = () => reject(new Error("Network error"));
                    xhr.send(formData);
                });

                newAssets.push({
                    url: cloudData.secure_url,
                    publicId: cloudData.public_id,
                    type: isVideo ? "video" : "image",
                });
            }

            const res = await fetch(`${API_URL}/api/media/${editId}/assets`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({ assets: newAssets }),
            });

            if (!res.ok) throw new Error("Failed to add new files to record.");

            addMoreFilesInput.value = "";
            await fetchMediaList();
            const updatedItem = allMediaItems.find((m) => m.id === editId);
            if (updatedItem) renderEditAssets(updatedItem);
        } catch (err: any) {
            alert(err.message || "Error adding files.");
        }
    });

    // Edit Item Submit Handler
    editForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const editId = (document.getElementById("edit-id") as HTMLInputElement).value;
        const token = getToken();

        if (!editId || !token) return;

        const updatedData = {
            title: (document.getElementById("edit-title") as HTMLInputElement).value,
            category: (document.getElementById("edit-category") as HTMLInputElement).value || "General",
            description: (document.getElementById("edit-description") as HTMLTextAreaElement).value,
            hashtags: (document.getElementById("edit-hashtags") as HTMLInputElement).value
                .split(",")
                .map((h) => h.trim())
                .filter(Boolean),
        };

        try {
            const res = await fetch(`${API_URL}/api/media/${editId}`, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify(updatedData),
            });

            if (!res.ok) throw new Error("Failed to update item.");

            closeEditModal();
            await fetchMediaList();
        } catch (err: any) {
            if (editStatus) {
                editStatus.innerText = err.message || "Error updating item.";
                editStatus.className = "text-xs font-mono text-center rounded-lg p-2.5 bg-red-950/80 text-red-400 border border-red-800 block";
            }
        }
    });

    // Fetch media items list from API
    async function fetchMediaList() {
        const tableBody = document.getElementById("media-table-body");
        if (!tableBody) return;

        try {
            const response = await fetch(`${API_URL}/api/media?includeArchived=true`);
            if (!response.ok) throw new Error("Failed to load gallery items.");

            allMediaItems = await response.json();
            renderMediaTable();
        } catch (err) {
            tableBody.innerHTML = `
        <tr>
          <td colspan="6" class="py-8 text-center text-red-400 font-mono">Error loading media items. Check server status.</td>
        </tr>`;
        }
    }

    // Render media table with Search, Filter & Sort logic
    function renderMediaTable() {
        const tableBody = document.getElementById("media-table-body");
        if (!tableBody) return;

        const searchQuery = (document.getElementById("search-input") as HTMLInputElement)?.value.toLowerCase().trim() || "";
        const filterType = (document.getElementById("filter-type") as HTMLSelectElement)?.value || "ALL";
        const filterStatus = (document.getElementById("filter-status") as HTMLSelectElement)?.value || "ALL";

        let processedItems = allMediaItems.filter((item) => {
            const assets = item.media || [];
            
            if (filterType === "image" && !assets.some((a: any) => a.type === "image")) return false;
            if (filterType === "video" && !assets.some((a: any) => a.type === "video")) return false;

            if (filterStatus === "ACTIVE" && item.isArchived) return false;
            if (filterStatus === "ARCHIVED" && !item.isArchived) return false;

            if (searchQuery) {
                const matchTitle = item.title?.toLowerCase().includes(searchQuery);
                const matchCategory = item.category?.toLowerCase().includes(searchQuery);
                const matchHashtags = item.hashtags?.some((h: string) => h.toLowerCase().includes(searchQuery));
                if (!matchTitle && !matchCategory && !matchHashtags) return false;
            }

            return true;
        });

        processedItems.sort((a, b) => {
            let valA: any = a[currentSortColumn];
            let valB: any = b[currentSortColumn];

            if (currentSortColumn === "createdAt") {
                valA = new Date(valA || 0).getTime();
                valB = new Date(valB || 0).getTime();
            } else if (currentSortColumn === "title") {
                valA = (valA || "").toString().toLowerCase();
                valB = (valB || "").toString().toLowerCase();
            } else if (currentSortColumn === "isArchived") {
                valA = valA ? 1 : 0;
                valB = valB ? 1 : 0;
            }

            if (valA < valB) return sortDirection === "asc" ? -1 : 1;
            if (valA > valB) return sortDirection === "asc" ? 1 : -1;
            return 0;
        });

        if (!processedItems || processedItems.length === 0) {
            tableBody.innerHTML = `
        <tr>
          <td colspan="6" class="py-8 text-center text-zinc-500 font-mono">No matching media items found.</td>
        </tr>`;
            return;
        }

        tableBody.innerHTML = processedItems
            .map((item: any) => {
                const assets = item.media || [];
                const primaryAsset = assets[0];
                const countBadge = assets.length > 1 ? `<span class="bg-orange-500/20 text-orange-400 border border-orange-500/30 text-[10px] px-1.5 py-0.5 rounded font-mono ml-1">${assets.length} items</span>` : '';

                let previewHtml = `<div class="w-12 h-12 bg-zinc-800 rounded-md border border-zinc-700 flex items-center justify-center text-zinc-500 text-[10px] font-mono">EMPTY</div>`;

                if (primaryAsset) {
                    if (primaryAsset.type === "image") {
                        previewHtml = `<img 
              src="${primaryAsset.url}" 
              alt="${item.title}" 
              data-item-id="${item.id}"
              class="preview-thumb w-12 h-12 object-cover rounded-md border border-zinc-800 cursor-pointer hover:opacity-80 hover:border-orange-500 transition-all" 
              title="Click to open gallery"
            />`;
                    } else {
                        previewHtml = `<div 
              data-item-id="${item.id}"
              class="preview-thumb w-12 h-12 bg-zinc-800 rounded-md border border-zinc-700 flex items-center justify-center text-orange-500 font-bold text-[10px] cursor-pointer hover:border-orange-500 transition-all"
              title="Click to open gallery"
            >VIDEO</div>`;
                    }
                }

                const statusBadge = item.isArchived
                    ? `<span class="px-2 py-0.5 text-[10px] font-mono bg-amber-950/60 text-amber-400 border border-amber-900/80 rounded-full">Archived</span>`
                    : `<span class="px-2 py-0.5 text-[10px] font-mono bg-emerald-950/60 text-emerald-400 border border-emerald-900/80 rounded-full">Active</span>`;

                const hashtagsStr = item.hashtags?.length > 0 ? item.hashtags.map((h: string) => `#${h}`).join(" ") : "";

                const createdDate = item.createdAt
                    ? new Date(item.createdAt).toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                      })
                    : "N/A";

                return `
        <tr class="hover:bg-zinc-800/30 transition-colors">
          <td class="py-3 px-4">${previewHtml}</td>
          <td class="py-3 px-4">
            <div class="font-bold text-white">${item.title} ${countBadge}</div>
            <div class="text-[11px] text-zinc-400 font-mono">${item.category || "General"} ${hashtagsStr ? "• " + hashtagsStr : ""}</div>
          </td>
          <td class="py-3 px-4 font-mono text-zinc-300 text-xs">
            ${assets.length} file(s)
          </td>
          <td class="py-3 px-4">${statusBadge}</td>
          <td class="py-3 px-4 text-zinc-400 font-mono text-xs">${createdDate}</td>
          <td class="py-3 px-4 text-right">
            <div class="flex items-center justify-end gap-2">
              <button data-action="edit" data-id="${item.id}" class="action-btn px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-mono text-[11px] rounded transition-colors cursor-pointer">Edit</button>
              <button data-action="archive" data-id="${item.id}" class="action-btn px-2.5 py-1 bg-amber-950/40 hover:bg-amber-900/60 text-amber-300 border border-amber-900/50 font-mono text-[11px] rounded transition-colors cursor-pointer">${item.isArchived ? "Unarchive" : "Archive"}</button>
              ${isAdmin ? `<button data-action="delete" data-id="${item.id}" class="action-btn px-2.5 py-1 bg-red-950/40 hover:bg-red-900/60 text-red-300 border border-red-900/50 font-mono text-[11px] rounded transition-colors cursor-pointer">Delete</button>` : ""}
            </div>
          </td>
        </tr>`;
            })
            .join("");

        document.querySelectorAll(".preview-thumb").forEach((thumb) => {
            thumb.addEventListener("click", (e) => {
                const el = e.currentTarget as HTMLElement;
                const itemId = el.dataset.itemId;
                if (!itemId) return;

                const item = allMediaItems.find((m) => m.id === itemId);
                if (item && item.media && item.media.length > 0) {
                    openMediaGallery(item.media, 0, item.title || "");
                }
            });
        });

        document.querySelectorAll(".action-btn").forEach((btn) => {
            btn.addEventListener("click", async (e) => {
                const el = e.currentTarget as HTMLElement;
                const action = el.dataset.action;
                const id = el.dataset.id;
                if (!id || !action) return;

                if (action === "edit") {
                    const item = allMediaItems.find((m) => m.id === id);
                    if (!item) return;

                    (document.getElementById("edit-id") as HTMLInputElement).value = item.id;
                    (document.getElementById("edit-title") as HTMLInputElement).value = item.title || "";
                    (document.getElementById("edit-category") as HTMLInputElement).value = item.category || "";
                    (document.getElementById("edit-hashtags") as HTMLInputElement).value = item.hashtags?.join(", ") || "";
                    (document.getElementById("edit-description") as HTMLTextAreaElement).value = item.description || "";

                    renderEditAssets(item);
                    editModal?.classList.remove("hidden");
                } else if (action === "archive") {
                    const token = getToken();
                    if (!token) return;
                    await fetch(`${API_URL}/api/media/${id}/archive`, {
                        method: "PATCH",
                        headers: { Authorization: `Bearer ${token}` },
                    });
                    await fetchMediaList();
                } else if (action === "delete") {
                    if (!confirm("Are you sure you want to permanently delete this media item and all associated Cloudinary files?")) return;
                    const token = getToken();
                    if (!token) return;
                    await fetch(`${API_URL}/api/media/${id}`, {
                        method: "DELETE",
                        headers: { Authorization: `Bearer ${token}` },
                    });
                    await fetchMediaList();
                }
            });
        });
    }

    // Initial Load
    fetchMediaList();
</script>