---
// src/pages/admin/index.astro
import Layout from "../../layouts/Layout.astro";
import AdminContentManager, { type UserRole } from "../../components/admin/AdminContentManager.astro";

// SSR Check
if (!Astro.locals.user) {
  return Astro.redirect("/admin/login");
}

const user = Astro.locals.user as { role: string; email: string; name?: string; username?: string };
const isAdmin = user?.role === "Admin" || user?.role === "SuperAdmin";

// Mapeo dinámico: si el rol es "Admin" o "SuperAdmin", asigna "SuperAdmin"
const userRole: UserRole = (user?.role === "Admin" || user?.role === "SuperAdmin") 
  ? "SuperAdmin" 
  : (user?.role as UserRole) || "ArchiveAdmin";
---

<Layout title="Content Management | Underground Vandals">
  <div class="space-y-5 pb-12">
    {/* Header */}
    <div
      class="flex flex-col gap-3 border-b border-zinc-800/80 pb-4"
      style={['create', 'edit'].includes(Astro.url.searchParams.get('archive') || '') || ['create', 'edit'].includes(Astro.url.searchParams.get('gallery') || '') ? 'display:none' : undefined}
      id="dashboard-root"
      data-is-admin={isAdmin ? "true" : "false"}
    >
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Content management</h1>
        <p class="mt-1 max-w-2xl text-sm text-zinc-400">Manage archive media and gallery editorial features.</p>
      </div>
    </div>

    {/* Content Manager Component */}
    <AdminContentManager userRole={userRole} isAdmin={isAdmin} />
  </div>
</Layout>
