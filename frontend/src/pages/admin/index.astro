---
import Layout from '../../layouts/Layout.astro';

// SSR Check: Verify authentication token
const token = Astro.cookies.get('uv_auth_token')?.value;
if (!token) {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Admin Dashboard | Underground Vandals">
  <div class="space-y-10 max-w-5xl mx-auto pb-12">
    
    {/* Header */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-800/80 pb-6">
      <div>
        <span class="text-xs font-mono bg-zinc-900 border border-zinc-800 px-3 py-1 rounded-full text-orange-500 uppercase tracking-widest inline-block mb-2">
          Control Panel
        </span>
        <h1 class="text-3xl font-black uppercase tracking-tight text-white">
          Admin <span class="text-orange-500">Dashboard</span>
        </h1>
      </div>

      <button 
        id="logout-btn"
        class="self-start sm:self-auto px-4 py-2 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 font-mono text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer"
      >
        Sign Out
      </button>
    </div>

    {/* Section 1: Upload Form */}
    <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur-md shadow-xl space-y-6">
      <div>
        <h2 class="text-lg font-bold text-white uppercase tracking-wide">Upload New Media</h2>
        <p class="text-xs text-zinc-400 mt-0.5">Add photos or videos directly to Cloudinary and database</p>
      </div>

      <form id="upload-form" class="space-y-5">
        <div>
          <label for="title" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
            Title *
          </label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            required 
            class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors text-sm"
            placeholder="e.g. Street Art Piece #01"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="type" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
              Media Type *
            </label>
            <select 
              id="type" 
              name="type" 
              class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 focus:outline-none focus:border-orange-500 transition-colors text-sm"
            >
              <option value="Photo">Photo</option>
              <option value="Video">Video</option>
            </select>
          </div>

          <div>
            <label for="category" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
              Category
            </label>
            <input 
              type="text" 
              id="category" 
              name="category" 
              defaultValue="General"
              class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors text-sm"
              placeholder="e.g. Trains, Walls, General"
            />
          </div>

          <div>
            <label for="file" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
              File *
            </label>
            <input 
              type="file" 
              id="file" 
              name="file" 
              accept="image/*,video/*"
              required 
              class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-xs text-zinc-400 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-mono file:bg-zinc-800 file:text-zinc-200 hover:file:bg-zinc-700 cursor-pointer"
            />
          </div>
        </div>

        <div>
          <label for="hashtags" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
            Hashtags (Comma-separated)
          </label>
          <input 
            type="text" 
            id="hashtags" 
            name="hashtags" 
            class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors text-sm"
            placeholder="graffiti, streetart, vandals"
          />
        </div>

        <div>
          <label for="description" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
            Description (Optional)
          </label>
          <textarea 
            id="description" 
            name="description" 
            rows="3"
            class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors resize-none text-sm"
            placeholder="Optional details about location, artist, date..."
          ></textarea>
        </div>

        {/* Status Message Container */}
        <div id="status-message" class="hidden text-xs font-mono text-center rounded-lg p-3"></div>

        <button 
          type="submit" 
          id="upload-btn"
          class="w-full py-3.5 px-4 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black uppercase tracking-wider text-xs rounded-lg shadow-lg hover:shadow-orange-500/10 transition-all cursor-pointer disabled:opacity-50"
        >
          Upload to Gallery
        </button>
      </form>
    </div>

    {/* Section 2: Media Management List */}
    <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur-md shadow-xl space-y-6">
      <div class="flex items-center justify-between border-b border-zinc-800/80 pb-4">
        <div>
          <h2 class="text-lg font-bold text-white uppercase tracking-wide">Manage Gallery Media</h2>
          <p class="text-xs text-zinc-400 mt-0.5">View, edit, archive, or permanently delete gallery items</p>
        </div>
        <button 
          id="refresh-btn" 
          class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-mono text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer disabled:opacity-50"
        >
          ↻ Refresh
        </button>
      </div>

      {/* Search & Filters Bar */}
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 bg-zinc-950/50 p-3 rounded-xl border border-zinc-800/60">
        <div class="sm:col-span-2">
          <input 
            type="text" 
            id="search-input" 
            placeholder="Search title, category, hashtag..." 
            class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 placeholder-zinc-500 text-xs focus:outline-none focus:border-orange-500 font-mono"
          />
        </div>
        <div>
          <select 
            id="filter-type" 
            class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 text-xs focus:outline-none focus:border-orange-500 font-mono cursor-pointer"
          >
            <option value="ALL">All Types</option>
            <option value="Photo">Photos</option>
            <option value="Video">Videos</option>
          </select>
        </div>
        <div>
          <select 
            id="filter-status" 
            class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 text-xs focus:outline-none focus:border-orange-500 font-mono cursor-pointer"
          >
            <option value="ALL">All Statuses</option>
            <option value="ACTIVE">Active</option>
            <option value="ARCHIVED">Archived</option>
          </select>
        </div>
      </div>

      {/* Media Table Container */}
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-zinc-800 text-[11px] font-mono uppercase tracking-wider text-zinc-400 select-none">
              <th class="py-3 px-4">Preview</th>
              <th class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header" data-sort="title">
                Title & Info <span class="sort-icon inline-block ml-1 opacity-40">↕</span>
              </th>
              <th class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header" data-sort="type">
                Type <span class="sort-icon inline-block ml-1 opacity-40">↕</span>
              </th>
              <th class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header" data-sort="isArchived">
                Status <span class="sort-icon inline-block ml-1 opacity-40">↕</span>
              </th>
              <th class="py-3 px-4 cursor-pointer hover:text-white transition-colors sort-header text-orange-500" data-sort="createdAt">
                Date <span class="sort-icon inline-block ml-1 opacity-100">↓</span>
              </th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="media-table-body" class="divide-y divide-zinc-800/50 text-xs">
            <tr>
              <td colspan="6" class="py-8 text-center text-zinc-500 font-mono">Loading media items...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  {/* Full Image Preview Modal */}
  <div id="image-modal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex flex-col items-center justify-center p-4">
    <div class="relative max-w-4xl max-h-[90vh] w-full flex flex-col items-center">
      <button 
        id="modal-close-btn" 
        class="absolute -top-12 right-0 text-zinc-300 hover:text-orange-500 text-xs font-mono uppercase tracking-wider bg-zinc-900 border border-zinc-800 px-3 py-1.5 rounded-lg cursor-pointer transition-colors"
      >
        ✕ Close
      </button>
      <img 
        id="modal-img" 
        src="" 
        alt="" 
        class="max-w-full max-h-[80vh] object-contain rounded-xl shadow-2xl border border-zinc-800/80" 
      />
      <p id="modal-title" class="text-zinc-300 font-mono text-xs mt-3 text-center uppercase tracking-wider"></p>
    </div>
  </div>

  {/* Edit Media Modal */}
  <div id="edit-modal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 sm:p-8 max-w-lg w-full space-y-5 shadow-2xl relative">
      <div class="flex justify-between items-center border-b border-zinc-800/80 pb-4">
        <div>
          <h3 class="text-base font-bold text-white uppercase tracking-wide">Edit Media Item</h3>
          <p class="text-xs text-zinc-400">Update metadata without changing the uploaded file</p>
        </div>
        <button id="edit-modal-close" class="text-zinc-400 hover:text-white font-mono text-sm cursor-pointer">✕</button>
      </div>

      <form id="edit-form" class="space-y-4">
        <input type="hidden" id="edit-id" />

        <div>
          <label for="edit-title" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5">Title *</label>
          <input type="text" id="edit-title" required class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="edit-category" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5">Category</label>
            <input type="text" id="edit-category" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500" />
          </div>

          <div>
            <label for="edit-hashtags" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5">Hashtags (Comma-separated)</label>
            <input type="text" id="edit-hashtags" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500" />
          </div>
        </div>

        <div>
          <label for="edit-description" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5">Description</label>
          <textarea id="edit-description" rows="3" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs focus:outline-none focus:border-orange-500 resize-none"></textarea>
        </div>

        <div id="edit-status" class="hidden text-xs font-mono text-center rounded-lg p-2.5"></div>

        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="edit-cancel-btn" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-mono text-xs uppercase rounded-lg transition-colors cursor-pointer">Cancel</button>
          <button type="submit" id="edit-submit-btn" class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black font-mono text-xs uppercase rounded-lg transition-colors cursor-pointer">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:5098';

  // State
  let allMediaItems: any[] = [];
  let currentSortColumn: string = 'createdAt';
  let sortDirection: 'asc' | 'desc' = 'desc';

  // Helper to extract JWT Token from cookies
  function getToken(): string | undefined {
    return document.cookie
      .split('; ')
      .find(row => row.startsWith('uv_auth_token='))
      ?.split('=')[1];
  }

  // Handle Logout
  document.getElementById('logout-btn')?.addEventListener('click', () => {
    document.cookie = 'uv_auth_token=; path=/; max-age=0;';
    window.location.href = '/admin/login';
  });

  // Handle Refresh Button
  const refreshBtn = document.getElementById('refresh-btn') as HTMLButtonElement;
  refreshBtn?.addEventListener('click', async () => {
    refreshBtn.disabled = true;
    refreshBtn.innerText = '↻ Refreshing...';
    await fetchMediaList();
    refreshBtn.innerText = '↻ Refresh';
    refreshBtn.disabled = false;
  });

  // Filter & Search Event Listeners
  document.getElementById('search-input')?.addEventListener('input', renderMediaTable);
  document.getElementById('filter-type')?.addEventListener('change', renderMediaTable);
  document.getElementById('filter-status')?.addEventListener('change', renderMediaTable);

  // Sorting Event Listeners
  document.querySelectorAll('.sort-header').forEach(header => {
    header.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const column = target.getAttribute('data-sort');
      if (!column) return;

      if (currentSortColumn === column) {
        sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
      } else {
        currentSortColumn = column;
        sortDirection = column === 'createdAt' ? 'desc' : 'asc';
      }

      updateSortHeadersUI();
      renderMediaTable();
    });
  });

  function updateSortHeadersUI() {
    document.querySelectorAll('.sort-header').forEach(header => {
      const el = header as HTMLElement;
      const column = el.getAttribute('data-sort');
      const iconSpan = el.querySelector('.sort-icon') as HTMLElement;

      if (column === currentSortColumn) {
        el.classList.add('text-orange-500');
        el.classList.remove('text-zinc-400');
        if (iconSpan) {
          iconSpan.innerText = sortDirection === 'asc' ? '↑' : '↓';
          iconSpan.classList.add('opacity-100');
          iconSpan.classList.remove('opacity-40');
        }
      } else {
        el.classList.remove('text-orange-500');
        el.classList.add('text-zinc-400');
        if (iconSpan) {
          iconSpan.innerText = '↕';
          iconSpan.classList.add('opacity-40');
          iconSpan.classList.remove('opacity-100');
        }
      }
    });
  }

  // Image Preview Modal Controls
  const imageModal = document.getElementById('image-modal');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const modalCloseBtn = document.getElementById('modal-close-btn');

  function closeImageModal() {
    if (imageModal) imageModal.classList.add('hidden');
  }

  modalCloseBtn?.addEventListener('click', closeImageModal);
  imageModal?.addEventListener('click', (e) => {
    if (e.target !== modalImg) closeImageModal();
  });

  // Edit Modal Controls
  const editModal = document.getElementById('edit-modal');
  const editModalCloseBtn = document.getElementById('edit-modal-close');
  const editCancelBtn = document.getElementById('edit-cancel-btn');
  const editForm = document.getElementById('edit-form') as HTMLFormElement;
  const editStatus = document.getElementById('edit-status') as HTMLDivElement;

  function closeEditModal() {
    if (editModal) editModal.classList.add('hidden');
    if (editStatus) editStatus.className = 'hidden text-xs font-mono text-center rounded-lg p-2.5';
  }

  editModalCloseBtn?.addEventListener('click', closeEditModal);
  editCancelBtn?.addEventListener('click', closeEditModal);

  // Close Modals on ESC key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeImageModal();
      closeEditModal();
    }
  });

  // Fetch media items list from API
  async function fetchMediaList() {
    const tableBody = document.getElementById('media-table-body');
    if (!tableBody) return;

    try {
      const response = await fetch(`${API_URL}/api/media?includeArchived=true`);
      if (!response.ok) throw new Error('Failed to load gallery items.');

      allMediaItems = await response.json();
      renderMediaTable();

    } catch (err) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="6" class="py-8 text-center text-red-400 font-mono">Error loading media items. Check server status.</td>
        </tr>`;
    }
  }

  // Render media table with Search, Filter & Sort logic
  function renderMediaTable() {
    const tableBody = document.getElementById('media-table-body');
    if (!tableBody) return;

    const searchQuery = (document.getElementById('search-input') as HTMLInputElement)?.value.toLowerCase().trim() || '';
    const filterType = (document.getElementById('filter-type') as HTMLSelectElement)?.value || 'ALL';
    const filterStatus = (document.getElementById('filter-status') as HTMLSelectElement)?.value || 'ALL';

    // 1. Filter items
    let processedItems = allMediaItems.filter(item => {
      const isPhoto = item.type === 'Photo' || item.type === 0;
      const itemTypeStr = isPhoto ? 'Photo' : 'Video';

      if (filterType !== 'ALL' && itemTypeStr.toLowerCase() !== filterType.toLowerCase()) {
        return false;
      }

      if (filterStatus === 'ACTIVE' && item.isArchived) return false;
      if (filterStatus === 'ARCHIVED' && !item.isArchived) return false;

      if (searchQuery) {
        const matchTitle = item.title?.toLowerCase().includes(searchQuery);
        const matchCategory = item.category?.toLowerCase().includes(searchQuery);
        const matchHashtags = item.hashtags?.some((h: string) => h.toLowerCase().includes(searchQuery));
        if (!matchTitle && !matchCategory && !matchHashtags) {
          return false;
        }
      }

      return true;
    });

    // 2. Sort items
    processedItems.sort((a, b) => {
      let valA: any = a[currentSortColumn];
      let valB: any = b[currentSortColumn];

      if (currentSortColumn === 'createdAt') {
        valA = new Date(valA || 0).getTime();
        valB = new Date(valB || 0).getTime();
      } else if (currentSortColumn === 'title') {
        valA = (valA || '').toString().toLowerCase();
        valB = (valB || '').toString().toLowerCase();
      } else if (currentSortColumn === 'type') {
        valA = (a.type === 'Photo' || a.type === 0 ? 'Photo' : 'Video').toLowerCase();
        valB = (b.type === 'Photo' || b.type === 0 ? 'Photo' : 'Video').toLowerCase();
      } else if (currentSortColumn === 'isArchived') {
        valA = valA ? 1 : 0;
        valB = valB ? 1 : 0;
      }

      if (valA < valB) return sortDirection === 'asc' ? -1 : 1;
      if (valA > valB) return sortDirection === 'asc' ? 1 : -1;
      return 0;
    });

    if (!processedItems || processedItems.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="6" class="py-8 text-center text-zinc-500 font-mono">No matching media items found.</td>
        </tr>`;
      return;
    }

    tableBody.innerHTML = processedItems.map((item: any) => {
      const isPhoto = item.type === 'Photo' || item.type === 0;
      const statusBadge = item.isArchived
        ? `<span class="px-2 py-0.5 text-[10px] font-mono bg-amber-950/60 text-amber-400 border border-amber-900/80 rounded-full">Archived</span>`
        : `<span class="px-2 py-0.5 text-[10px] font-mono bg-emerald-950/60 text-emerald-400 border border-emerald-900/80 rounded-full">Active</span>`;

      const previewHtml = isPhoto
        ? `<img 
            src="${item.url}" 
            alt="${item.title}" 
            data-full-url="${item.url}"
            class="preview-thumb w-12 h-12 object-cover rounded-md border border-zinc-800 cursor-pointer hover:opacity-80 hover:border-orange-500 transition-all" 
            title="Click to expand"
          />`
        : `<div class="w-12 h-12 bg-zinc-800 rounded-md border border-zinc-700 flex items-center justify-center text-orange-500 font-bold text-xs">VIDEO</div>`;

      const hashtagsStr = item.hashtags?.length > 0 ? item.hashtags.map((h: string) => `#${h}`).join(' ') : '';

      const createdDate = item.createdAt 
        ? new Date(item.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
        : 'N/A';

      return `
        <tr class="hover:bg-zinc-800/30 transition-colors">
          <td class="py-3 px-4 align-middle">${previewHtml}</td>
          <td class="py-3 px-4 align-middle">
            <div class="font-bold text-zinc-200">${item.title}</div>
            <div class="text-[11px] text-zinc-500 font-mono">${item.category || 'General'} ${hashtagsStr ? '• ' + hashtagsStr : ''}</div>
          </td>
          <td class="py-3 px-4 align-middle font-mono text-zinc-400">${isPhoto ? 'Photo' : 'Video'}</td>
          <td class="py-3 px-4 align-middle">${statusBadge}</td>
          <td class="py-3 px-4 align-middle font-mono text-zinc-400 text-[11px] whitespace-nowrap">${createdDate}</td>
          <td class="py-3 px-4 align-middle text-right whitespace-nowrap">
            <div class="flex items-center justify-end gap-2">
              <button 
                data-edit-id="${item.id}" 
                class="edit-btn px-2.5 py-1 text-[11px] font-mono bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded transition-colors cursor-pointer"
              >
                Edit
              </button>
              <button 
                data-archive-id="${item.id}" 
                class="archive-btn px-2.5 py-1 text-[11px] font-mono bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded transition-colors cursor-pointer"
              >
                ${item.isArchived ? 'Unarchive' : 'Archive'}
              </button>
              <button 
                data-delete-id="${item.id}" 
                class="delete-btn px-2.5 py-1 text-[11px] font-mono bg-red-950/60 hover:bg-red-900/80 text-red-300 border border-red-900/60 rounded transition-colors cursor-pointer"
              >
                Delete
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    attachActionListeners();
  }

  // Attach button click events for Edit, Archive, Delete, and Image Preview
  function attachActionListeners() {
    const token = getToken();

    // Image Preview Click Event
    document.querySelectorAll('.preview-thumb').forEach(thumb => {
      thumb.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLImageElement;
        const fullUrl = target.getAttribute('data-full-url') || target.src;
        const title = target.alt;

        if (modalImg && imageModal) {
          modalImg.src = fullUrl;
          modalImg.alt = title;
          if (modalTitle) modalTitle.innerText = title;
          imageModal.classList.remove('hidden');
        }
      });
    });

    // Edit Item Event
    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-edit-id');
        const item = allMediaItems.find(m => m.id === id);

        if (!item || !editModal) return;

        (document.getElementById('edit-id') as HTMLInputElement).value = item.id;
        (document.getElementById('edit-title') as HTMLInputElement).value = item.title || '';
        (document.getElementById('edit-category') as HTMLInputElement).value = item.category || 'General';
        (document.getElementById('edit-description') as HTMLTextAreaElement).value = item.description || '';
        (document.getElementById('edit-hashtags') as HTMLInputElement).value = item.hashtags ? item.hashtags.join(', ') : '';

        editModal.classList.remove('hidden');
      });
    });

    // Toggle Archive
    document.querySelectorAll('.archive-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-archive-id');
        if (!id) return;

        target.disabled = true;
        target.innerText = '...';

        try {
          const res = await fetch(`${API_URL}/api/media/${id}/archive`, {
            method: 'PATCH',
            headers: { 'Authorization': `Bearer ${token}` }
          });

          if (!res.ok) throw new Error();
          fetchMediaList();
        } catch {
          alert('Failed to update archive status.');
          target.disabled = false;
        }
      });
    });

    // Delete Item
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-delete-id');
        if (!id) return;

        if (!confirm('Are you sure you want to delete this media? It will be removed from Cloudinary and database permanently.')) {
          return;
        }

        target.disabled = true;
        target.innerText = '...';

        try {
          const res = await fetch(`${API_URL}/api/media/${id}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
          });

          if (!res.ok) throw new Error();
          fetchMediaList();
        } catch {
          alert('Failed to delete media item.');
          target.disabled = false;
        }
      });
    });
  }

  // Edit Form Submit Handler
  editForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById('edit-submit-btn') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.innerText = 'SAVING...';

    const id = (document.getElementById('edit-id') as HTMLInputElement).value;
    const title = (document.getElementById('edit-title') as HTMLInputElement).value;
    const category = (document.getElementById('edit-category') as HTMLInputElement).value;
    const description = (document.getElementById('edit-description') as HTMLTextAreaElement).value;
    const hashtagsRaw = (document.getElementById('edit-hashtags') as HTMLInputElement).value;

    const hashtags = hashtagsRaw
      ? hashtagsRaw.split(',').map(tag => tag.trim().replace(/^#/, '')).filter(tag => tag.length > 0)
      : [];

    const token = getToken();

    try {
      const response = await fetch(`${API_URL}/api/media/${id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          title,
          category,
          description,
          hashtags
        })
      });

      if (!response.ok) {
        throw new Error('Failed to update media item.');
      }

      closeEditModal();
      fetchMediaList();

    } catch (err: any) {
      if (editStatus) {
        editStatus.innerText = `❌ ${err.message || 'Failed to update.'}`;
        editStatus.className = 'text-xs font-mono text-center rounded-lg p-2.5 bg-red-950/40 border border-red-900/60 text-red-400';
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = 'SAVE CHANGES';
    }
  });

  // Upload Form Handler
  const form = document.getElementById('upload-form') as HTMLFormElement;
  const statusDiv = document.getElementById('status-message') as HTMLDivElement;
  const uploadBtn = document.getElementById('upload-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    statusDiv.className = 'hidden text-xs font-mono text-center rounded-lg p-3';
    uploadBtn.disabled = true;
    uploadBtn.innerText = 'UPLOADING TO CLOUDINARY...';

    const rawFormData = new FormData(form);
    const payload = new FormData();

    payload.append('Title', rawFormData.get('title') as string);
    payload.append('Type', rawFormData.get('type') as string);
    payload.append('Category', (rawFormData.get('category') as string) || 'General');

    const desc = rawFormData.get('description') as string;
    if (desc) payload.append('Description', desc);

    const fileInput = document.getElementById('file') as HTMLInputElement;
    if (fileInput.files?.[0]) {
      payload.append('File', fileInput.files[0]);
    }

    const hashtagsInput = rawFormData.get('hashtags') as string;
    if (hashtagsInput) {
      const tags = hashtagsInput
        .split(',')
        .map(tag => tag.trim().replace(/^#/, ''))
        .filter(tag => tag.length > 0);

      tags.forEach(tag => payload.append('Hashtags', tag));
    }

    const token = getToken();

    try {
      const response = await fetch(`${API_URL}/api/media/upload`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
        body: payload
      });

      let data: any = {};
      const contentType = response.headers.get('content-type');
      if (contentType && contentType.includes('application/json')) {
        data = await response.json();
      }

      if (!response.ok) {
        throw new Error(data.message || `Server returned status ${response.status}`);
      }

      statusDiv.innerText = '✅ Media uploaded successfully!';
      statusDiv.classList.add('bg-emerald-950/40', 'border', 'border-emerald-900/60', 'text-emerald-400');
      statusDiv.classList.remove('hidden');
      form.reset();

      fetchMediaList();

    } catch (err: any) {
      statusDiv.innerText = `❌ ${err.message || 'Failed to upload.'}`;
      statusDiv.classList.add('bg-red-950/40', 'border', 'border-red-900/60', 'text-red-400');
      statusDiv.classList.remove('hidden');
    } finally {
      uploadBtn.disabled = false;
      uploadBtn.innerText = 'UPLOAD TO GALLERY';
    }
  });

  // Initial load on page mount
  fetchMediaList();
</script>