---
import Layout from "../../layouts/Layout.astro";
import ProductsManager from "../../components/admin/ProductsManager.astro";

// SSR Check
if (!Astro.locals.user) {
    return Astro.redirect("/admin/login");
}

const user = Astro.locals.user as { role: string; email: string; name?: string; username?: string };
const isAdmin = user?.role === "Admin";

---

<Layout title="Products Management | Underground Vandals">
    <div class="space-y-5 pb-12">
        {/* Header */}
        <div
            class="flex flex-col gap-3 border-b border-zinc-800/80 pb-4"
            style={['create', 'edit'].includes(Astro.url.searchParams.get('product') || '') ? 'display:none' : undefined}
            id="dashboard-root"
            data-is-admin={isAdmin ? "true" : "false"}
        >
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Product catalog</h1>
                <p class="mt-1 max-w-2xl text-sm text-zinc-400">Review and manage products from your connected store.</p>
            </div>
        </div>

        {/* Products Manager Component */}
        <ProductsManager isAdmin={isAdmin} />
    </div>
</Layout>
