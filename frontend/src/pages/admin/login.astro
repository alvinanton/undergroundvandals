---
import Layout from '../../layouts/Layout.astro'; 

const token = Astro.cookies.get('uv_auth_token')?.value;
if (token) {
  return Astro.redirect('/admin');
}
---

<Layout title="Admin Login | Underground Vandals">
  <div class="flex flex-col items-center justify-center min-h-[70vh]">
    <div class="w-full max-w-md bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-8 backdrop-blur-md shadow-2xl">
      
      <div class="text-center mb-8">
        <span class="text-xs font-mono bg-zinc-950 border border-zinc-800 px-3 py-1 rounded-full text-zinc-400 uppercase tracking-widest inline-block mb-3">
          Restricted Area
        </span>
        <h1 class="text-2xl font-black uppercase tracking-tight text-white">
          Admin <span class="text-orange-500">Access</span>
        </h1>
        <p class="text-xs text-zinc-400 mt-1">
          Enter your credentials to manage content
        </p>
      </div>

      <form id="login-form" class="space-y-5">
        <div>
          <label for="email" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
            Email
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors"
            placeholder="admin@undergroundvandals.com"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
            Password
          </label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required 
            class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 transition-colors"
            placeholder="••••••••"
          />
        </div>

        <div 
          id="error-message" 
          class="hidden text-red-400 text-xs font-mono text-center bg-red-950/40 border border-red-900/60 rounded-lg p-3"
        ></div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-3.5 px-4 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black uppercase tracking-wider text-xs rounded-lg shadow-lg hover:shadow-orange-500/10 transition-all cursor-pointer disabled:opacity-50"
        >
          Sign In
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.innerText = 'AUTHENTICATING...';

    const formData = new FormData(form);
    const email = formData.get('email');
    const password = formData.get('password');

    try {
      const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:5098';
      
      const response = await fetch(`${apiUrl}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || 'Invalid credentials.');
      }

      document.cookie = `uv_auth_token=${data.token}; path=/; max-age=28800; SameSite=Lax; ${location.protocol === 'https:' ? 'Secure;' : ''}`;

      window.location.href = '/admin';

    } catch (err: any) {
      errorDiv.innerText = err.message || 'An error occurred during authentication.';
      errorDiv.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = 'SIGN IN';
    }
  });
</script>