---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Underground Vandals | Street Art, Archive & Shop">
  <div class="space-y-16 py-4">
    {/* HERO SECTION */}
    <section class="relative bg-zinc-900/40 border border-zinc-800/80 rounded-3xl p-8 sm:p-14 overflow-hidden text-center sm:text-left">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-orange-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="max-w-2xl relative z-10 space-y-6">
        <span class="text-xs font-mono bg-zinc-900 border border-zinc-800 px-3 py-1 rounded-full text-orange-500 uppercase tracking-widest inline-block">
          Official Collective
        </span>
        <h1 class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-white leading-none">
          Underground <span class="text-orange-500">Vandals</span>
        </h1>
        <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
          Documenting street art culture, preserving underground graffiti archives, featuring exclusive interviews, and offering official merchandise.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 pt-2 justify-center sm:justify-start">
          <a
            href="/shop"
            class="px-6 py-3.5 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black uppercase tracking-wider text-xs rounded-xl shadow-lg hover:shadow-orange-500/10 transition-all text-center"
          >
            Visit Shop →
          </a>
          <a
            href="/archive"
            class="px-6 py-3.5 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-200 font-mono text-xs uppercase tracking-wider rounded-xl transition-colors text-center"
          >
            Explore Archive
          </a>
        </div>
      </div>
    </section>

    {/* NAVIGATION CARDS GRID */}
    <div class="grid md:grid-cols-3 gap-6">
      {/* ARCHIVE CARD */}
      <a
        href="/archive"
        class="group relative bg-zinc-900/60 border border-zinc-800 hover:border-orange-500/40 rounded-2xl p-8 flex flex-col justify-between h-72 transition-all duration-300 overflow-hidden"
      >
        <div class="space-y-3 relative z-10">
          <span class="text-xs font-mono text-zinc-500 uppercase tracking-wider">01 / Photo Archive</span>
          <h2 class="text-2xl font-black uppercase text-white group-hover:text-orange-400 transition-colors">
            Street Archive
          </h2>
          <p class="text-zinc-400 text-xs leading-relaxed">
            High-resolution database of street art, train actions, and graffiti walls worldwide.
          </p>
        </div>
        <span class="text-xs font-mono text-orange-500 uppercase tracking-wider font-bold relative z-10 flex items-center gap-1">
          Open Archive <span class="group-hover:translate-x-1 transition-transform">→</span>
        </span>
      </a>

      {/* GALLERY CARD */}
      <a
        href="/gallery"
        class="group relative bg-zinc-900/60 border border-zinc-800 hover:border-orange-500/40 rounded-2xl p-8 flex flex-col justify-between h-72 transition-all duration-300 overflow-hidden"
      >
        <div class="space-y-3 relative z-10">
          <span class="text-xs font-mono text-zinc-500 uppercase tracking-wider">02 / Editorial Hub</span>
          <h2 class="text-2xl font-black uppercase text-white group-hover:text-orange-400 transition-colors">
            Gallery & Exclusives
          </h2>
          <p class="text-zinc-400 text-xs leading-relaxed">
            Exclusive artist spotlights, video premieres, and exhibition retrospectives.
          </p>
        </div>
        <span class="text-xs font-mono text-orange-500 uppercase tracking-wider font-bold relative z-10 flex items-center gap-1">
          Explore Gallery <span class="group-hover:translate-x-1 transition-transform">→</span>
        </span>
      </a>

      {/* SHOP CARD */}
      <a
        href="/shop"
        class="group relative bg-zinc-900/60 border border-zinc-800 hover:border-orange-500/40 rounded-2xl p-8 flex flex-col justify-between h-72 transition-all duration-300 overflow-hidden"
      >
        <div class="space-y-3 relative z-10">
          <span class="text-xs font-mono text-zinc-500 uppercase tracking-wider">03 / Store</span>
          <h2 class="text-2xl font-black uppercase text-white group-hover:text-orange-400 transition-colors">
            Official Shop
          </h2>
          <p class="text-zinc-400 text-xs leading-relaxed">
            Apparel, limited physical items, stickers, and digital assets from Underground Vandals.
          </p>
        </div>
        <span class="text-xs font-mono text-orange-500 uppercase tracking-wider font-bold relative z-10 flex items-center gap-1">
          Visit Store <span class="group-hover:translate-x-1 transition-transform">→</span>
        </span>
      </a>
    </div>
  </div>
</Layout>