---
// src/pages/shop/cart.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Cart | Underground Vandals">
  <div class="space-y-8 max-w-3xl mx-auto">
    <div class="border-b border-zinc-800/80 pb-6">
      <span class="text-xs font-mono bg-zinc-900 border border-zinc-800 px-3 py-1 rounded-full text-orange-500 uppercase tracking-widest inline-block mb-2">
        Cart
      </span>
      <h1 class="text-3xl font-black uppercase tracking-tight text-white">
        Your <span class="text-orange-500">Cart</span>
      </h1>
    </div>

    <div id="cart-root">
      <p class="text-zinc-500 font-mono text-sm text-center py-10">Loading cart...</p>
    </div>
  </div>
</Layout>

<script>
  import { getCart, updateQuantity, removeFromCart, type CartItem } from '../../lib/cart';
  import { getProductById } from '../../services/ecommerce/productService';
  import type { ProductPublic } from '../../types/ecommerce';

  const root = document.getElementById('cart-root');

  interface ResolvedLine {
    item: CartItem;
    product: ProductPublic;
  }

  async function loadCart() {
    if (!root) return;

    const cart = getCart();

    if (cart.length === 0) {
      renderEmpty(false);
      return;
    }

    root.innerHTML = `<p class="text-zinc-500 font-mono text-sm text-center py-10">Loading cart...</p>`;

    const results = await Promise.all(
      cart.map(async (item) => ({ item, product: await getProductById(item.productId) })),
    );

    const stale = results.filter((r) => r.product === null);
    const valid: ResolvedLine[] = results
      .filter((r): r is { item: CartItem; product: ProductPublic } => r.product !== null)
      .map((r) => ({ item: r.item, product: r.product }));

    stale.forEach((r) => removeFromCart(r.item.productId));

    if (valid.length === 0) {
      renderEmpty(stale.length > 0);
      return;
    }

    renderCart(valid, stale.length > 0);
  }

  function renderEmpty(hadStaleItems: boolean) {
    if (!root) return;
    root.innerHTML = `
      <div class="py-16 text-center space-y-4">
        ${hadStaleItems ? `<p class="text-amber-400 text-xs font-mono">Some items are no longer available and were removed from your cart.</p>` : ''}
        <p class="text-zinc-500 font-mono text-sm">Your cart is empty.</p>
        <a href="/shop" class="inline-block px-5 py-2.5 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black uppercase tracking-wider text-xs rounded-lg transition-colors">
          Go to Shop
        </a>
      </div>
    `;
  }

  function renderCart(lines: ResolvedLine[], hadStaleItems: boolean) {
    if (!root) return;

    const subtotal = lines.reduce((sum, l) => sum + l.product.price * l.item.quantity, 0);
    const hasPhysical = lines.some((l) => !l.product.isDigital);

    root.innerHTML = `
      ${hadStaleItems ? `<p class="text-amber-400 text-xs font-mono mb-4">Some items are no longer available and were removed from your cart.</p>` : ''}
      <div class="space-y-3">
        ${lines.map((l) => cartLineHtml(l)).join('')}
      </div>

      <div class="mt-6 pt-6 border-t border-zinc-800/80 space-y-2">
        <div class="flex justify-between text-sm">
          <span class="text-zinc-400 font-mono">Subtotal</span>
          <span class="text-white font-mono font-bold">Q${subtotal.toFixed(2)}</span>
        </div>
        ${
          hasPhysical
            ? `<div class="flex justify-between text-xs">
                <span class="text-zinc-500 font-mono">Shipping</span>
                <span class="text-zinc-500 font-mono">Calculated at next step</span>
              </div>`
            : ''
        }
      </div>

      <a
        href="/shop/checkout"
        class="block mt-6 w-full text-center py-3.5 px-4 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black uppercase tracking-wider text-xs rounded-lg shadow-lg hover:shadow-orange-500/10 transition-all"
      >
        Proceed to Checkout
      </a>
    `;

    root.querySelectorAll<HTMLInputElement>('.cart-qty-input').forEach((input) => {
      input.addEventListener('change', () => {
        const productId = Number(input.dataset.productId);
        const quantity = Math.max(1, Math.min(99, Number(input.value) || 1));
        updateQuantity(productId, quantity);
        loadCart();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('.cart-remove-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const productId = Number(btn.dataset.productId);
        removeFromCart(productId);
        loadCart();
      });
    });
  }

  function cartLineHtml(line: ResolvedLine): string {
    const { item, product } = line;
    const lineSubtotal = (product.price * item.quantity).toFixed(2);
    const safeName = escapeHtml(product.name);

    const thumb = product.thumbnailUrl
      ? `<img src="${product.thumbnailUrl}" alt="${safeName}" class="w-16 h-16 object-cover rounded-lg border border-zinc-800 shrink-0" onerror="this.outerHTML='<div class=&quot;w-16 h-16 rounded-lg border border-zinc-800 bg-zinc-950 flex items-center justify-center text-[9px] text-zinc-600 font-mono shrink-0&quot;>N/A</div>'" />`
      : `<div class="w-16 h-16 rounded-lg border border-zinc-800 bg-zinc-950 flex items-center justify-center text-[9px] text-zinc-600 font-mono shrink-0">N/A</div>`;

    return `
      <div class="flex items-center gap-3 sm:gap-4 bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-3">
        ${thumb}
        <div class="flex-1 min-w-0">
          <a href="/shop/${product.id}" class="text-sm font-bold text-white hover:text-orange-400 transition-colors line-clamp-1">
            ${safeName}
          </a>
          <p class="text-xs text-zinc-500 font-mono mt-0.5">Q${product.price.toFixed(2)} each</p>
        </div>
        <input
          type="number"
          min="1"
          max="99"
          value="${item.quantity}"
          data-product-id="${product.id}"
          class="cart-qty-input w-16 px-2 py-1.5 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 font-mono text-xs text-center focus:outline-none focus:border-orange-500 shrink-0"
        />
        <span class="w-16 sm:w-20 text-right text-sm font-mono font-bold text-orange-500 shrink-0">Q${lineSubtotal}</span>
        <button
          type="button"
          data-product-id="${product.id}"
          class="cart-remove-btn px-2 py-1.5 bg-red-950/40 hover:bg-red-900/60 text-red-300 border border-red-900/50 font-mono text-[11px] rounded-lg transition-colors shrink-0"
          title="Remove from cart"
        >
          ✕
        </button>
      </div>
    `;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  loadCart();
</script>