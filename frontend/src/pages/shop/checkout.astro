---
// src/pages/shop/checkout.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Checkout | Underground Vandals">
  <div class="space-y-8 max-w-2xl mx-auto">
    <div class="border-b border-zinc-800/80 pb-6">
      <span class="text-xs font-mono bg-zinc-900 border border-zinc-800 px-3 py-1 rounded-full text-orange-500 uppercase tracking-widest inline-block mb-2">
        Checkout
      </span>
      <h1 class="text-3xl font-black uppercase tracking-tight text-white">
        Confirm <span class="text-orange-500">Order</span>
      </h1>
    </div>

    <div id="checkout-root">
      <p class="text-zinc-500 font-mono text-sm text-center py-10">Loading...</p>
    </div>
  </div>
</Layout>

<script>
  import { getCart, removeFromCart, clearCart, type CartItem } from '../../lib/cart';
  import { getProductById } from '../../services/ecommerce/productService';
  import { checkout, previewShipping } from '../../services/ecommerce/orderService';
  import { PaymentMethod } from '../../types/ecommerce';
  import type { ProductPublic, ApiProblemDetails } from '../../types/ecommerce';

  const root = document.getElementById('checkout-root');

  interface ResolvedLine {
    item: CartItem;
    product: ProductPublic;
  }

  let resolvedLines: ResolvedLine[] = [];
  let hasPhysical = false;
  let subtotal = 0;

  async function init() {
    if (!root) return;

    const cart = getCart();
    if (cart.length === 0) {
      renderEmpty();
      return;
    }

    const results = await Promise.all(
      cart.map(async (item) => ({ item, product: await getProductById(item.productId) })),
    );

    const stale = results.filter((r) => r.product === null);
    stale.forEach((r) => removeFromCart(r.item.productId));

    resolvedLines = results
      .filter((r): r is { item: CartItem; product: ProductPublic } => r.product !== null)
      .map((r) => ({ item: r.item, product: r.product }));

    if (resolvedLines.length === 0) {
      renderEmpty(stale.length > 0);
      return;
    }

    hasPhysical = resolvedLines.some((l) => !l.product.isDigital);
    subtotal = resolvedLines.reduce((sum, l) => sum + l.product.price * l.item.quantity, 0);

    render(stale.length > 0);
  }

  function renderEmpty(hadStaleItems: boolean = false) {
    if (!root) return;
    root.innerHTML = `
      <div class="py-16 text-center space-y-4">
        ${hadStaleItems ? `<p class="text-amber-400 text-xs font-mono">Some items are no longer available and were removed from your cart.</p>` : ''}
        <p class="text-zinc-500 font-mono text-sm">Your cart is empty.</p>
        <a href="/shop" class="inline-block px-5 py-2.5 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black uppercase tracking-wider text-xs rounded-lg transition-colors">
          Go to Shop
        </a>
      </div>
    `;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function render(hadStaleItems: boolean) {
    if (!root) return;

    const summaryRows = resolvedLines
      .map(
        (l) => `
        <div class="flex justify-between text-xs py-1.5">
          <span class="text-zinc-400">${escapeHtml(l.product.name)} <span class="text-zinc-600">× ${l.item.quantity}</span></span>
          <span class="text-zinc-300 font-mono">Q${(l.product.price * l.item.quantity).toFixed(2)}</span>
        </div>
      `,
      )
      .join('');

    root.innerHTML = `
      ${hadStaleItems ? `<p class="text-amber-400 text-xs font-mono mb-4">Some items are no longer available and were removed from your cart.</p>` : ''}

      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-5">
        <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">Order Summary</h2>
        <div class="divide-y divide-zinc-800/50">${summaryRows}</div>
        <div class="flex justify-between text-sm pt-3 mt-2 border-t border-zinc-800/80">
          <span class="text-zinc-400 font-mono">Subtotal</span>
          <span class="text-white font-mono font-bold">Q${subtotal.toFixed(2)}</span>
        </div>
        ${
          hasPhysical
            ? `<div class="flex justify-between text-xs mt-1" id="shipping-row">
                <span class="text-zinc-500 font-mono">Shipping</span>
                <span class="text-zinc-500 font-mono" id="shipping-amount">Enter your address</span>
              </div>`
            : ''
        }
        <p class="text-[10px] text-zinc-600 font-mono mt-2">Final total will be confirmed when processing the order.</p>
        <a href="/shop/cart" class="text-[11px] text-zinc-500 hover:text-orange-400 font-mono mt-3 inline-block transition-colors">
          ← Edit cart
        </a>
      </div>

      <form id="checkout-form" class="space-y-5 mt-6">
        <div>
          <label for="customerName" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
            Full Name *
          </label>
          <input
            type="text" id="customerName" required
            class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 text-sm"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="customerEmail" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
              Email Address *
            </label>
            <input
              type="email" id="customerEmail" required
              class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 text-sm"
            />
          </div>
          <div>
            <label for="customerPhone" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
              Phone (optional)
            </label>
            <input
              type="tel" id="customerPhone"
              class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 text-sm"
            />
          </div>
        </div>

        ${
          hasPhysical
            ? `<div>
                <label for="shippingAddress" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-2">
                  Shipping Address *
                </label>
                <textarea
                  id="shippingAddress" required rows="3"
                  placeholder="Zone, city, references..."
                  class="w-full px-4 py-3 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-orange-500 text-sm resize-none"
                ></textarea>
              </div>`
            : ''
        }

        <div class="bg-zinc-900/40 border border-zinc-800/60 rounded-lg p-3">
          <p class="text-xs font-mono text-zinc-400">
            💳 Payment via <span class="text-zinc-200">bank transfer</span>. We will share transfer details once your order is confirmed.
          </p>
        </div>

        <div id="checkout-status" class="hidden text-xs font-mono text-center rounded-lg p-3"></div>

        <button
          type="submit" id="checkout-submit-btn"
          class="w-full py-3.5 px-4 bg-orange-500 hover:bg-orange-600 text-zinc-950 font-black uppercase tracking-wider text-xs rounded-lg shadow-lg hover:shadow-orange-500/10 transition-all cursor-pointer disabled:opacity-50"
        >
          Confirm Order
        </button>
      </form>
    `;

    wireForm();
  }

  function showStatus(msg: string, type: 'success' | 'error') {
    const el = document.getElementById('checkout-status');
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
    el.className =
      type === 'success'
        ? 'text-xs font-mono text-center rounded-lg p-3 bg-emerald-950/80 text-emerald-400 border border-emerald-800'
        : 'text-xs font-mono text-center rounded-lg p-3 bg-red-950/80 text-red-400 border border-red-800';
  }

  function friendlyCheckoutError(problem: ApiProblemDetails): string {
    const map: Record<string, string> = {
      EmptyCart: 'Your cart is empty.',
      TooManyItems: problem.detail || 'Your cart has too many items.',
      InvalidQuantity: problem.detail || 'Invalid quantity in cart.',
      DuplicateProduct: 'Duplicate product in cart. Please reload the page and try again.',
      ProductNotFound: 'One of the products is no longer available. Return to cart to update it.',
      ProductInactive: 'One of the products is no longer available. Return to cart to update it.',
      InsufficientStock: problem.detail || 'Insufficient stock for one of the items.',
      ShippingAddressRequired: 'Please enter a shipping address.',
      PaymentMethodNotSupported: 'That payment method is not available yet.',
      ShippingUnavailable: problem.detail || 'We do not ship to that address yet.',
      InvalidCustomerData: problem.detail || 'Please check your name and email address.',
    };

    return map[problem.title] || problem.detail || 'An error occurred processing your order. Please try again.';
  }

  function wireForm() {
    const form = document.getElementById('checkout-form') as HTMLFormElement | null;
    const addressInput = document.getElementById('shippingAddress') as HTMLTextAreaElement | null;
    const shippingAmountEl = document.getElementById('shipping-amount');
    const submitBtn = document.getElementById('checkout-submit-btn') as HTMLButtonElement | null;

    addressInput?.addEventListener('blur', async () => {
      const address = addressInput.value.trim();
      if (!address || !shippingAmountEl) return;

      shippingAmountEl.textContent = 'Calculating...';

      const result = await previewShipping({
        shippingAddress: address,
        items: resolvedLines.map((l) => ({ productId: l.product.id, quantity: l.item.quantity })),
      });

      if (!result.success) {
        shippingAmountEl.textContent = friendlyCheckoutError(result.problem);
        shippingAmountEl.className = 'text-red-400 font-mono text-xs';
        return;
      }

      if (result.data.priceConfirmed && result.data.shippingCost !== null) {
        shippingAmountEl.textContent = `Q${result.data.shippingCost.toFixed(2)}`;
        shippingAmountEl.className = 'text-white font-mono';
      } else {
        shippingAmountEl.textContent = 'Will be quoted after order';
        shippingAmountEl.className = 'text-zinc-500 font-mono text-xs';
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;

      const customerName = (document.getElementById('customerName') as HTMLInputElement).value.trim();
      const customerEmail = (document.getElementById('customerEmail') as HTMLInputElement).value.trim();
      const customerPhone = (document.getElementById('customerPhone') as HTMLInputElement)?.value.trim() || null;
      const shippingAddress = addressInput?.value.trim() || null;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Processing...';

      try {
        const result = await checkout({
          customerName,
          customerEmail,
          customerPhone,
          shippingAddress,
          paymentMethod: PaymentMethod.BankTransfer,
          items: resolvedLines.map((l) => ({ productId: l.product.id, quantity: l.item.quantity })),
        });

        if (!result.success) {
          showStatus(friendlyCheckoutError(result.problem), 'error');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Confirm Order';
          return;
        }

        clearCart();
        sessionStorage.setItem(
          'uv_last_order',
          JSON.stringify({ orderNumber: result.data.orderNumber, email: customerEmail }),
        );
        window.location.href = '/shop/order';
      } catch {
        showStatus('Could not connect to server. Please try again.', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Confirm Order';
      }
    });
  }

  init();
</script>