# ==========================================
# INFRAESTRUCTURA Y BASE DE DATOS (DOCKER)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=underground_db
POSTGRES_PORT=5432

# ==========================================
# SERVICIOS BACKEND (API & WORKER)
# ==========================================
# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name

# Cloudinary (Temporal para Bot)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Autenticación JWT
JWT_SECRET=your_long_jwt_secret_key_min_32_chars
JWT_ISSUER=https://api.undergroundvandals.com
JWT_AUDIENCE=https://undergroundvandals.com

# ==========================================
# TELEGRAM BOT WORKER
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_telegram_user_id
TELEGRAM_REPORT_TIME_UTC=03:00

# ==========================================
# FRONTEND WEB (ASTRO SSR)
# ==========================================
PUBLIC_API_URL=http://localhost:5050
PUBLIC_ECOMMERCE_API_URL=http://localhost:5114
PUBLIC_BANK_TRANSFER_INFO="Banco Industrial\nCuenta de ahorro: 000-000000-0\nA nombre de: Nombre Apellido"

# Secretos SSR (Solo servidor Node, no van al navegador)
ECOMMERCE_ADMIN_API_URL=http://localhost:5114
ECOMMERCE_ADMIN_API_KEY=your_admin_api_key_here