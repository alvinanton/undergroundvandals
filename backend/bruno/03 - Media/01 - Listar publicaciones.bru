meta {
  name: Listar publicaciones
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/media?category={{category}}&tag={{tag}}&includeArchived={{includeArchived}}
  body: none
  auth: none
}

params:query {
  category: {{category}}
  tag: {{tag}}
  includeArchived: {{includeArchived}}
}

assert {
  res.status: eq 200
}

docs {
  GET /api/media
  Público. PostResponse[]. Filtros AND; sin paginación. Desactivar category/tag en Params para listar todo.
  Aserción del escenario exitoso de ejemplo: 200.
}
