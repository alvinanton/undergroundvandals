meta {
  name: Crear usuario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{newUsername}}",
    "email": "{{newEmail}}",
    "password": "{{newPassword}}",
    "role": "{{newRole}}"
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300 && res.body?.id) {
    bru.setVar("userId", res.body.id);
  }
}

assert {
  res.status: eq 201
}

docs {
  POST /api/users
  Admin. role Admin o Editor (default Editor). 400 email duplicado. Captura userId. Ver docs/api/auth-users.md.
  Aserción del escenario exitoso de ejemplo: 201.
}
