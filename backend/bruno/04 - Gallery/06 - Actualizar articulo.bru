meta {
  name: Actualizar articulo
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/gallery/{{articleId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Escena urbana actualizada",
    "slug": "{{articleSlug}}",
    "subtitle": "Artistas y espacios de la ciudad",
    "category": "EDITORIAL",
    "heroImageUrl": "https://example.com/portada.webp",
    "videoUrl": null,
    "videoSource": "NONE",
    "contentMarkdown": "## La escena\nTexto del artículo.",
    "readingTimeMinutes": 5,
    "subjectName": "Colectivo UV",
    "location": "Ciudad de Guatemala",
    "externalUrl": "https://example.com/artista",
    "eventDate": "2026-12-01T18:00:00Z",
    "isFeatured": false,
    "isPublished": true,
    "shopCollectionSlug": "urban-art",
    "shopCollectionTitle": "Urban Art",
    "tags": [
      "graffiti",
      "guatemala"
    ],
    "galleryImageUrls": [
      "https://example.com/detalle.webp"
    ]
  }
}

assert {
  res.status: eq 200
}

docs {
  PUT /api/gallery/{{articleId}}
  Admin/Editor. Reemplaza campos editables. 400 slug duplicado, 404 inexistente.
  Aserción del escenario exitoso de ejemplo: 200.
}
