meta {
  name: Listar articulos
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/gallery?category={{galleryCategory}}&tag={{tag}}&includeUnpublished={{includeUnpublished}}
  body: none
  auth: none
}

params:query {
  category: {{galleryCategory}}
  tag: {{tag}}
  includeUnpublished: {{includeUnpublished}}
  ~isFeatured: {{isFeatured}}
}

assert {
  res.status: eq 200
}

docs {
  GET /api/gallery
  Público. GalleryArticleResponse[]. includeUnpublished=true es público. Activar isFeatured en Params para filtrar destacado.
  Aserción del escenario exitoso de ejemplo: 200.
}
