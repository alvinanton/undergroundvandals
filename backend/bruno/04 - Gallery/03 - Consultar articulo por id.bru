meta {
  name: Consultar articulo por id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/gallery/{{articleId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  GET /api/gallery/{{articleId}}
  Público, incluso no publicados. 404 si no existe.
  Aserción del escenario exitoso de ejemplo: 200.
}
