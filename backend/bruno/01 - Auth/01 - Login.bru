meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.deleteVar("token");
  if (res.status === 200 && res.body?.token) {
    bru.setVar("token", res.body.token);
  }
}

assert {
  res.status: eq 200
}

docs {
  POST /api/auth/login
  Público. JWT de 8 horas. 401 credenciales inválidas o cuenta inactiva. Ver docs/api/auth-users.md.
  Aserción del escenario exitoso de ejemplo: 200.
}
