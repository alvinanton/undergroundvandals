meta {
  name: Actualizar producto via Astro
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/admin/products/{{productId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: uv_auth_token={{token}}
}

body:json {
  {
    "id": 1,
    "name": "Print urbano",
    "description": "Impresión de arte urbano",
    "shortDescription": "Edición de prueba",
    "price": 150,
    "categoryId": 1,
    "isDigital": false,
    "stockQuantity": 10,
    "fileUrl": null,
    "fileSize": null,
    "thumbnailUrl": "https://example.com/print.webp",
    "isActive": true,
    "media": [
      {
        "mediaUrl": "https://example.com/print.webp",
        "storageKey": "products/print.webp",
        "mediaType": 1,
        "mimeType": "image/webp",
        "fileSize": 1024,
        "isMain": true,
        "displayOrder": 1
      }
    ]
  }
}

assert {
  res.status: eq 200
}

docs {
  PUT /api/admin/products/{{productId}}
  Seleccionar Frontend. Cookie Admin. Payload ilustrativo del formulario; validación y contrato finales dependen del e-commerce. 400/403/500/502 locales o estado upstream.
  Aserción del escenario exitoso de ejemplo: 200.
}
