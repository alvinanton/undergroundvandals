meta {
  name: Listar productos via Astro
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/products?pageNumber=1&pageSize=25
  body: none
  auth: none
}

params:query {
  pageNumber: 1
  pageSize: 25
}

assert {
  res.status: eq 200
}

docs {
  GET /api/admin/products
  Seleccionar Frontend. Sin control de rol local. El servidor agrega X-Api-Key. Contrato final externo. Fallo upstream conserva estado; excepción 500. Ver docs/api/visits-proxies.md.
  Aserción del escenario exitoso de ejemplo: 200.
}
